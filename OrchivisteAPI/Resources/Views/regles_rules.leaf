<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Règles documentaires · Règles</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ink); background: var(--bg); }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a { margin-left: 14px; color: var(--accent); text-decoration: none; font-weight: 700; }
        .wrap { max-width: 1160px; margin: 20px auto 40px; padding: 0 16px; }
        .rules-nav { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
        .rules-nav a {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 7px 11px;
            text-decoration: none;
            color: var(--ink);
            background: #fff;
            font-weight: 700;
            font-size: 13px;
        }
        .rules-nav a.active { background: #ebf8f4; color: var(--accent); border-color: #bde2d7; }
        .notice { margin: 0 0 10px; font-weight: 700; color: var(--accent); }
        .error { margin: 0 0 10px; font-weight: 700; color: var(--warning); }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px;
        }
        .lead { margin: 0 0 10px; color: var(--muted); line-height: 1.45; }
        .btn {
            display: inline-block;
            border: 1px solid var(--accent);
            color: #fff;
            background: var(--accent);
            border-radius: 8px;
            padding: 8px 11px;
            font-weight: 700;
            text-decoration: none;
        }
        .meta {
            margin-top: 10px;
            font-family: "SF Mono", Menlo, monospace;
            font-size: 12px;
            color: var(--muted);
            background: #f8f4ec;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
        }
        .badge {
            display: inline-block;
            border-radius: 999px;
            border: 1px solid var(--border);
            background: #f8f4ec;
            padding: 4px 10px;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 8px;
        }
        .mono {
            font-family: "SF Mono", Menlo, monospace;
            font-size: 12px;
            line-height: 1.35;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 9px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 12px;
            vertical-align: top;
        }
        th {
            font-size: 11px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .kpi {
            margin: 8px 0 0;
            padding-left: 18px;
            line-height: 1.5;
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Règles documentaires</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/regles">Règles documentaires</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>

<main class="wrap">
    <nav class="rules-nav">
        <a href="/ui/regles">Vue d'ensemble</a>
        <a href="/ui/regles/classification">Classification</a>
        <a class="active" href="/ui/regles/rules">Règles</a>
        <a href="/ui/regles/guide">Guide</a>
        <a href="/ui/regles/versions">Versions</a>
        <a href="/ui/regles/validation">Validation</a>
    </nav>

    #if(notice):
    <p class="notice">#(notice)</p>
    #endif
    #if(error):
    <p class="error">#(error)</p>
    #endif

    <section class="card">
        <h1>Règles</h1>
        <span class="badge">Source: #(source_label)</span>
        <p class="lead">#(summary)</p>

        #if(has_data):
        <ul class="kpi">
            <li>Version règles: <strong>#(version)</strong></li>
            <li>Règles de nommage: <strong>#(naming_rule_count)</strong></li>
            <li>Règles de routage: <strong>#(routing_rule_count)</strong></li>
        </ul>
        <p class="mono">Source fichier: #(bundle_path)</p>

        #if(naming_rules_present):
        <h2 style="margin-top:14px;">Nommage</h2>
        <div style="overflow-x:auto;">
            <table>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Label</th>
                    <th>Template</th>
                </tr>
                </thead>
                <tbody>
                #for(rule in naming_rules):
                <tr>
                    <td class="mono">#(rule.id)</td>
                    <td>#(rule.label)</td>
                    <td class="mono">#(rule.template)</td>
                </tr>
                #endfor
                </tbody>
            </table>
        </div>
        #endif

        #if(routing_rules_present):
        <h2 style="margin-top:14px;">Routage</h2>
        <div style="overflow-x:auto;">
            <table>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Class code</th>
                    <th>Destination template</th>
                </tr>
                </thead>
                <tbody>
                #for(rule in routing_rules):
                <tr>
                    <td class="mono">#(rule.id)</td>
                    <td class="mono">#(rule.class_code)</td>
                    <td class="mono">#(rule.destination_template)</td>
                </tr>
                #endfor
                </tbody>
            </table>
        </div>
        #endif
        #else:
        <p class="lead">Fallback legacy actif pour cette page.</p>
        <p class="meta">Raison: #(fallback_reason)</p>
        #endif
    </section>

    <section class="grid">
        <article class="card">
            <h2>Nommage (legacy)</h2>
            <p class="lead">Gestion actuelle des règles de nommage, apprentissage et ranking.</p>
            <a class="btn" href="/ui/naming">Ouvrir Nommage</a>
            <p class="meta">Compatibilité conservée: /ui/regles/naming -> /ui/naming.</p>
        </article>

        <article class="card">
            <h2>Classement & presets (legacy)</h2>
            <p class="lead">Gestion actuelle des règles de routage, presets et plan de classification.</p>
            <a class="btn" href="/ui/presets">Ouvrir Préréglages</a>
            <p class="meta">Compatibilité conservée: /ui/regles/presets -> /ui/presets.</p>
        </article>
    </section>
</main>
</body>
</html>

<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Pilotage Muni - Historique</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --danger: #9b3a16;
            --sev-info-bg: #e8f4f0;
            --sev-info-ink: #0c6b58;
            --sev-warning-bg: #fff2df;
            --sev-warning-ink: #915007;
            --sev-blocking-bg: #fbe4de;
            --sev-blocking-ink: #8b2b14;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Avenir Next", "Helvetica Neue", sans-serif;
            color: var(--ink);
            background: linear-gradient(150deg, #f9f5ee 0%, #f2ece2 100%);
        }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap {
            max-width: 1240px;
            margin: 20px auto 40px;
            padding: 0 16px;
        }
        .subnav {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }
        .subnav a {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 7px 11px;
            text-decoration: none;
            color: var(--ink);
            background: #fff;
            font-weight: 700;
            font-size: 13px;
        }
        .subnav a.active {
            background: #ebf8f4;
            color: var(--accent);
            border-color: #bde2d7;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px;
            margin-bottom: 14px;
        }
        .notice {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--accent);
        }
        .error {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--warning);
        }
        .mono {
            font-family: "SF Mono", Menlo, monospace;
            font-size: 12px;
            line-height: 1.35;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 9px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 12px;
            vertical-align: top;
        }
        th {
            font-size: 11px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .status-succeeded { color: var(--accent); font-weight: 700; }
        .status-failed { color: var(--danger); font-weight: 700; }
        .status-needs_review { color: var(--warning); font-weight: 700; }
        .status-not_implemented { color: #555; font-weight: 700; }
        .diag {
            display: grid;
            gap: 4px;
            min-width: 260px;
        }
        .diag-item {
            border-left: 2px solid #d8e8e2;
            padding-left: 7px;
            line-height: 1.35;
        }
        .diag-key {
            color: var(--muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            margin-right: 6px;
        }
        .diag-priority {
            margin-bottom: 6px;
            border: 1px solid var(--border);
            border-radius: 7px;
            padding: 7px;
            background: #fff;
            border-left-width: 4px;
        }
        .diag-priority-level-info {
            border-left-color: var(--sev-info-ink);
        }
        .diag-priority-level-warning {
            border-left-color: var(--sev-warning-ink);
        }
        .diag-priority-level-blocking {
            border-left-color: var(--sev-blocking-ink);
        }
        .diag-pill {
            display: inline-block;
            border-radius: 999px;
            padding: 2px 7px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin-right: 6px;
        }
        .diag-pill-blocking {
            background: var(--sev-blocking-bg);
            color: var(--sev-blocking-ink);
        }
        .diag-pill-warning {
            background: var(--sev-warning-bg);
            color: var(--sev-warning-ink);
        }
        .diag-pill-info {
            background: var(--sev-info-bg);
            color: var(--sev-info-ink);
        }
        .diag-priority-label {
            font-weight: 700;
            line-height: 1.35;
        }
        .diag-priority-meta {
            color: var(--muted);
            font-size: 11px;
            margin-top: 4px;
            line-height: 1.35;
        }
        .diag-cta-pill {
            display: inline-block;
            margin-top: 4px;
            border-radius: 999px;
            padding: 2px 7px;
            background: #f4fbf9;
            border: 1px solid #cbe7df;
            color: var(--accent);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Pilotage Muni</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/regles">Règles documentaires</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>

<main class="wrap">
    <nav class="subnav">
        <a href="/ui/pilotage/catalogue">Catalogue</a>
        <a href="/ui/pilotage/lancer">Lancer</a>
        <a class="active" href="/ui/pilotage/historique">Historique</a>
    </nav>

    #if(notice):
    <p class="notice">#(notice)</p>
    #endif
    #if(error):
    <p class="error">#(error)</p>
    #endif

    <section class="card">
        <h2 style="margin:0 0 8px;">Historique local (`history.jsonl`)</h2>
        <p class="mono" style="margin:0 0 8px;">#(history_file)</p>

        #if(history_present):
        <div style="overflow-x:auto;">
            <table>
                <thead>
                <tr>
                    <th>Exécution</th>
                    <th>Tool</th>
                    <th>Action</th>
                    <th>Statut</th>
                    <th>Résumé</th>
                    <th>Horodatage</th>
                    <th>Code sortie</th>
                    <th>Diagnostics</th>
                    <th>Fichiers</th>
                </tr>
                </thead>
                <tbody>
                #for(row in history_rows):
                <tr>
                    <td class="mono">#(row.execution_id)</td>
                    <td>#(row.tool_id)</td>
                    <td class="mono">#(row.action)</td>
                    <td class="status-#(row.status)">#(row.status_label)</td>
                    <td>#(row.summary)</td>
                    <td class="mono">Début: #(row.started_at)<br>Fin: #(row.finished_at)</td>
                    <td class="mono">#(row.exit_code)</td>
                    <td class="mono">
                        #if(row.diagnostics_present):
                        <div class="diag">
                            #if(row.priority_diagnostic_present):
                            <div class="diag-priority diag-priority-level-#(row.priority_diagnostic_severity)">
                                <span class="diag-pill diag-pill-#(row.priority_diagnostic_severity)">#(row.priority_diagnostic_severity_label)</span>
                                <span class="diag-priority-label">#(row.priority_diagnostic_label)</span>
                                #if(row.priority_diagnostic_cta_present):
                                <div class="diag-priority-meta">
                                    ID: #(row.priority_diagnostic_id)
                                    <br>
                                    <span class="diag-cta-pill">CTA: #(row.priority_diagnostic_cta)</span>
                                </div>
                                #else:
                                <div class="diag-priority-meta">ID: #(row.priority_diagnostic_id)</div>
                                #endif
                            </div>
                            #endif
                            #if(row.extraction_provenance_present):
                            <div class="diag-item"><span class="diag-key">Extraction</span>#(row.extraction_provenance)</div>
                            #endif
                            #if(row.regles_source_present):
                            <div class="diag-item"><span class="diag-key">Source règles</span>#(row.regles_source)</div>
                            #endif
                            #if(row.regles_bundle_version_present):
                            <div class="diag-item"><span class="diag-key">Bundle</span>#(row.regles_bundle_version)</div>
                            #endif
                            #if(row.regles_module_version_present):
                            <div class="diag-item"><span class="diag-key">Module</span>#(row.regles_module_version)</div>
                            #endif
                            #if(row.regles_rule_id_present):
                            <div class="diag-item"><span class="diag-key">Règle</span>#(row.regles_rule_id)</div>
                            #endif
                            #if(row.regles_fallback_reason_present):
                            <div class="diag-item"><span class="diag-key">Fallback</span>#(row.regles_fallback_reason)</div>
                            #endif
                            #if(row.warnings_present):
                            <div class="diag-item"><span class="diag-key">Warnings</span>#(row.warnings_count) · #(row.warnings_summary)</div>
                            #endif
                        </div>
                        #else:
                        -
                        #endif
                    </td>
                    <td class="mono">req: #(row.request_file)<br>res: #(row.result_file)</td>
                </tr>
                #endfor
                </tbody>
            </table>
        </div>
        #else:
        <p>Aucune exécution enregistrée pour le moment.</p>
        #endif
    </section>
</main>
</body>
</html>

<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Presets</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ink); background: var(--bg); }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap { max-width: 1200px; margin: 20px auto 40px; padding: 0 16px; }
        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 13px;
        }
        th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .mono { font-family: "SF Mono", Menlo, monospace; }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Presets</strong>
    <nav>
        <a href="/ui">Dashboard</a>
        <a href="/ui/jobs">Jobs</a>
        <a href="/ui/workers">Workers</a>
        <a href="/ui/presets">Presets</a>
    </nav>
</header>
<main class="wrap">
    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Name Format</th>
            <th>Class Code</th>
            <th>Postprocess</th>
        </tr>
        </thead>
        <tbody>
        #for(preset in presets):
        <tr>
            <td class="mono">#(preset.id)</td>
            <td>#(preset.name)</td>
            <td class="mono">#(preset.name_format)</td>
            <td>#(preset.class_code)</td>
            <td>#(preset.postprocess)</td>
        </tr>
        #endfor
        </tbody>
    </table>
</main>
</body>
</html>

<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Préréglages</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ink); background: var(--bg); }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .rules-nav {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 0 0 14px;
        }
        .rules-nav a {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 7px 11px;
            text-decoration: none;
            color: var(--ink);
            background: #fff;
            font-weight: 700;
            font-size: 13px;
        }
        .rules-nav a.active {
            background: #ebf8f4;
            color: var(--accent);
            border-color: #bde2d7;
        }
        .wrap { max-width: 1200px; margin: 20px auto 40px; padding: 0 16px; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 14px;
        }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 10px;
        }
        label { display: block; font-size: 13px; color: var(--muted); }
        input, textarea {
            margin-top: 4px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            font: inherit;
            background: #fff;
        }
        .path-row {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .path-row input {
            flex: 1;
        }
        .btn-soft {
            border: 1px solid var(--accent);
            background: #ebf8f4;
            color: var(--accent);
            border-radius: 8px;
            font-weight: 700;
            padding: 8px 10px;
            cursor: pointer;
            margin-top: 4px;
            white-space: nowrap;
        }
        .btn {
            margin-top: 10px;
            border: 1px solid var(--accent);
            color: #fff;
            background: var(--accent);
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .notice {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--accent);
        }
        .error {
            margin: 0 0 10px;
            font-weight: 700;
            color: #ac5d0c;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 13px;
        }
        th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .mono { font-family: "SF Mono", Menlo, monospace; }
        .hint { margin: 6px 0 0; color: var(--muted); font-size: 12px; line-height: 1.45; }
        details.advanced {
            margin-top: 12px;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px;
            background: #fbf8f2;
        }
        details.advanced summary {
            cursor: pointer;
            font-weight: 700;
        }
        .taxonomy-browser-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 12px;
        }
        .taxonomy-browser {
            margin-top: 12px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #fcfaf5;
            max-height: 420px;
            overflow: auto;
        }
        .taxonomy-browser-row {
            display: grid;
            grid-template-columns: minmax(90px, 120px) minmax(220px, 1fr) minmax(260px, 2fr);
            gap: 12px;
            padding: 10px 12px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
        }
        .taxonomy-browser-row strong {
            display: block;
            margin-bottom: 2px;
        }
        .taxonomy-browser-row:last-child {
            border-bottom: 0;
        }
        .taxonomy-browser-empty {
            padding: 14px 12px;
            color: var(--muted);
            font-size: 13px;
        }
        .taxonomy-browser-actions {
            padding: 12px;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            background: #f8f4ec;
        }
        .taxonomy-browser-actions button {
            border: 1px solid var(--accent);
            background: #ebf8f4;
            color: var(--accent);
            border-radius: 8px;
            font-weight: 700;
            padding: 8px 10px;
            cursor: pointer;
        }
        .class-picker {
            position: relative;
        }
        .class-picker-panel {
            position: absolute;
            z-index: 20;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            max-height: 260px;
            overflow: auto;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--surface);
            box-shadow: 0 12px 24px rgba(31, 37, 42, 0.12);
        }
        .class-picker-panel[hidden] {
            display: none;
        }
        .class-picker-option {
            width: 100%;
            border: 0;
            border-bottom: 1px solid #efe7da;
            background: transparent;
            text-align: left;
            padding: 10px;
            cursor: pointer;
            color: var(--ink);
        }
        .class-picker-option:hover,
        .class-picker-option:focus {
            background: #f5f0e6;
            outline: none;
        }
        .class-picker-option strong {
            display: block;
            margin-bottom: 2px;
        }
        .class-picker-option small {
            display: block;
            color: var(--muted);
            line-height: 1.35;
        }
        .class-picker-empty {
            padding: 10px;
            color: var(--muted);
            font-size: 12px;
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Préréglages</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/regles">Règles documentaires</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>
<main class="wrap">
    <nav class="rules-nav">
        <a href="/ui/regles">Vue d’ensemble</a>
        <a class="active" href="/ui/regles/presets">Préréglages</a>
        <a href="/ui/regles/naming">Nommage</a>
    </nav>

    #if(notice):
    <p class="notice">#(notice)</p>
    #endif
    #if(error):
    <p class="error">#(error)</p>
    #endif

    <section class="card">
        <h2>Nommage déclaratif & thésaurus</h2>
        <p style="margin: 0; color: var(--muted);">
            La fondation règles de nommage / thésaurus / brouillons est disponible sur
            <a href="/ui/naming">/ui/naming</a>.
        </p>
    </section>

    <section class="card">
        <h2>Paramètres de routage local</h2>
        <p style="margin: 0 0 10px; color: var(--muted);">
            Ces paramètres servent de valeurs par défaut. Tu peux aussi les surcharger lors du routage d'une tâche.
        </p>
        <form action="/ui/routing/settings" method="post">
            <div class="form-grid">
                <label>Racine locale de destination
                    <input type="text" name="local_route_root" value="#(routing_local_route_root)" placeholder="/data/routed">
                </label>
                <label>Modèle dossier par défaut
                    <input type="text" name="default_destination_template" value="#(routing_default_destination_template)" placeholder="Archives/{year}/{class_code}/{type_doc}">
                </label>
            </div>
            <input type="hidden" name="default_name_format" value="#(routing_default_name_format)">
            <button class="btn" type="submit">Enregistrer les paramètres de routage</button>
        </form>
        <p class="hint">Les règles de renommage et le format de nom final se gèrent dans <a href="/ui/naming">Nommage</a>. Cette page reste centrée sur le routage et le plan de classification.</p>
        <p style="margin: 10px 0 0; color: var(--muted); font-size: 12px;">
            Variables disponibles : <code>{class_code}</code>, <code>{year}</code>, <code>{type_doc}</code>, <code>{sujet}</code>, <code>{sujets}</code>, <code>{date}</code>, <code>{datetime}</code>, <code>{numero}</code>, <code>{comite}</code>, <code>{preset_id}</code>, <code>{job_id}</code>, <code>{original}</code>.
        </p>
    </section>

    <section class="card">
        <h2>Plan de classification (ville / SyGED)</h2>
        <p style="margin: 0 0 10px; color: var(--muted);">
            Importer ici le plan de classification officiel (JSON) pour centraliser les codes, libellés et mots-clés.
        </p>
        <form action="/ui/taxonomy/import" method="post">
            <div class="form-grid">
                <label>ID du plan
                    <input type="text" name="taxonomy_id" value="#(selected_taxonomy_id)" placeholder="syged_2026">
                </label>
            </div>
            <details class="advanced">
                <summary>Éditer ou remplacer le JSON du plan</summary>
                <label>JSON du plan de classification
                    <textarea name="taxonomy_json" rows="14" spellcheck="false">#(selected_taxonomy_json)</textarea>
                </label>
                <button class="btn" type="submit">Importer le plan</button>
            </details>
        </form>
        <hr style="border:none; border-top:1px solid var(--border); margin:12px 0;">
        <h3>Importer depuis un PDF du plan</h3>
        <p style="margin: 0 0 10px; color: var(--muted);">
            Orchiviste extrait automatiquement les codes (ex: 1000, 1110, 1111-01) et construit le JSON de taxonomie.
        </p>
        <form action="/ui/taxonomy/import-pdf" method="post" enctype="multipart/form-data">
            <div class="form-grid">
                <label>ID du plan
                    <input type="text" name="taxonomy_id" value="#(selected_taxonomy_id)" placeholder="syged_2026_pdf">
                </label>
                <label>Fichier PDF du plan
                    <input type="file" name="pdf" accept="application/pdf" required>
                </label>
            </div>
            <button class="btn" type="submit">Importer le PDF</button>
        </form>
        <div style="margin-top: 10px;">
            <strong>Plans disponibles:</strong>
            #for(id in taxonomy_ids):
            <a href="/ui/presets?taxonomy_id=#(id)" style="margin-left: 8px;">#(id)</a>
            #endfor
        </div>
        <div class="taxonomy-browser-toolbar">
            <label style="flex: 1 1 360px; margin: 0;">Recherche rapide code / titre / chemin
                <input id="presetTaxonomySearch" type="text" list="presetClassCodeList" placeholder="ADM-RES, Résolutions, voirie, administration">
            </label>
            <p id="presetTaxonomyMeta" class="hint" style="margin: 0;">Chargement du navigateur de classification...</p>
        </div>
        <p class="hint">Le navigateur ci-dessous filtre le plan sans afficher toute la taxonomie d’un coup. Tape un code, un titre ou un morceau de chemin.</p>
        <div id="presetTaxonomyBrowser" class="taxonomy-browser"></div>
    </section>

    <section class="card">
        <h2>Suggérer une règle depuis un dossier déjà renommé</h2>
        <p style="margin: 0 0 10px; color: var(--muted);">
            Utilise un dossier homogène (même type/sujet). Orchiviste propose une règle initiale que tu peux ensuite ajuster.
        </p>
        <form action="/ui/routing/rules/suggest" method="post">
            <div class="form-grid">
                <label>Dossier source
                    <div class="path-row">
                        <input id="suggestRuleFolderField" type="text" name="input_folder" placeholder="/data/routed/finance/pv (laisser vide si dossier local)">
                        <button class="btn-soft" type="button" onclick="openLocalRuleFolderDialog('suggestRuleFolderPicker')">Choisir</button>
                    </div>
                    <input id="suggestRuleFolderPicker" type="file" accept=".pdf,application/pdf" webkitdirectory directory multiple style="display:none" onchange="handleRuleFolderSelection('suggestRuleFolderPicker','suggestRuleFolderField','suggestRuleFolderHint','suggestRuleFileNames')">
                    <textarea id="suggestRuleFileNames" name="input_file_names" style="display:none"></textarea>
                    <div id="suggestRuleFolderHint" style="margin-top:4px; font-size:12px;">
                        "Choisir" sélectionne un dossier local de référence (les noms de PDF sont envoyés pour la suggestion).
                    </div>
                </label>
                <label>Type document (critère)
                    <input type="text" name="when_type_doc" placeholder="ProcesVerbal">
                </label>
                <label>Sujet (critère)
                    <input type="text" name="when_sujet" placeholder="Finance">
                </label>
                <label>Préréglage cible (optionnel)
                    <input type="text" name="preset_id" placeholder="preset_pv">
                </label>
                <label>Nombre max de fichiers
                    <input type="number" name="max_files" min="5" max="500" value="80">
                </label>
            </div>
            <button class="btn" type="submit">Générer une règle suggérée</button>
        </form>
    </section>

    <section class="card">
        <h2>Ajouter une règle type/sujet</h2>
        <p style="margin: 0 0 10px; color: var(--muted);">
            Formulaire guidé pour choisir automatiquement le dossier et le nom selon le type et le sujet détectés.
        </p>
        <form action="/ui/routing/rules/create" method="post">
            <div class="form-grid">
                <label>ID règle (optionnel)
                    <input type="text" name="id" placeholder="pv-finance">
                </label>
                <label>Type document (critère)
                    <input type="text" name="when_type_doc" placeholder="ProcesVerbal">
                </label>
                <label>Sujet (critère)
                    <input type="text" name="when_sujet" placeholder="Finance">
                </label>
                <label>Code (critère)
                    <div class="class-picker">
                        <input id="presetWhenClassCode" type="text" name="when_class_code" list="presetClassCodeList" placeholder="Tape un code, un titre ou un chemin" autocomplete="off" spellcheck="false">
                        <div id="presetWhenClassCodePicker" class="class-picker-panel" hidden></div>
                    </div>
                </label>
                <label>Code de classement (action)
                    <div class="class-picker">
                        <input id="presetActionClassCode" type="text" name="class_code" list="presetClassCodeList" placeholder="Tape un code, un titre ou un chemin" autocomplete="off" spellcheck="false">
                        <div id="presetActionClassCodePicker" class="class-picker-panel" hidden></div>
                    </div>
                </label>
                <label>Préréglage (action)
                    <input type="text" name="preset_id" placeholder="preset_pv">
                </label>
                <label>Modèle dossier (action)
                    <input type="text" name="destination_template" placeholder="Archives/{year}/{class_code}/Proces-Verbaux/{sujet}">
                </label>
            </div>
            <button class="btn" type="submit">Enregistrer la règle</button>
        </form>
        <p class="hint">Les formats de nom finaux sont désormais gérés dans <a href="/ui/naming">Nommage</a>. Ici, tu règles surtout le dossier cible, le code et le préréglage de routage.</p>
        <table style="margin-top: 12px;">
            <thead>
            <tr>
                <th>ID</th>
                <th>Critères</th>
                <th>Actions</th>
                <th>Suppression</th>
            </tr>
            </thead>
            <tbody>
            #for(rule in routing_rules):
            <tr>
                <td class="mono">#(rule.id)</td>
                <td>
                    Type: #(rule.when_type_doc)<br>
                    Sujet: #(rule.when_sujet)<br>
                    Code: #(rule.when_class_code_display)
                </td>
                <td>
                    Code: #(rule.class_code_display)<br>
                    Preset: #(rule.preset_id)<br>
                    Dossier: <span class="mono">#(rule.destination_template)</span>
                </td>
                <td>
                    <form action="/ui/routing/rules/#(rule.id)/delete" method="post" onsubmit="return confirm('Supprimer cette règle ?');">
                        <button class="btn" type="submit">Supprimer</button>
                    </form>
                </td>
            </tr>
            #endfor
            </tbody>
        </table>
    </section>

    <section class="card">
        <h2>Règles automatiques type/sujet (JSON)</h2>
        <p style="margin: 0 0 10px; color: var(--muted);">
            Ces règles permettent de choisir automatiquement le dossier, le code et le préréglage selon le type de document et le sujet détectés. Les propriétés de format de nom restent compatibles pour l’historique, mais la logique active de renommage se règle dans <a href="/ui/naming">Nommage</a>.
        </p>
        <form action="/ui/routing/rules" method="post">
            <label>JSON des règles
                <textarea name="rules_json" rows="14" spellcheck="false">#(routing_rules_json)</textarea>
            </label>
            <button class="btn" type="submit">Enregistrer les règles type/sujet</button>
        </form>
        <p style="margin: 10px 0 0; color: var(--muted); font-size: 12px;">
            Exemple : <code>{"rules":[{"id":"pv-finance","when_type_doc":"ProcesVerbal","when_sujet":"Finance","destination_template":"Archives/{year}/{class_code}/Finance","class_code":"ADM-PV","preset_id":"preset_pv"}]}</code>
        </p>
    </section>

    <section class="card">
        <h2>Créer un préréglage</h2>
        <p style="margin: 0 0 10px; color: var(--muted);">
            Exemple pret a copier: <a href="/v1/presets/example/download">Telecharger l'exemple JSON</a>.
            Apprentissage auto (endpoint admin): <code>POST /v1/presets/learn</code>.
        </p>
        <form action="/ui/presets/learn" method="post" style="margin-bottom: 14px;">
            <div class="form-grid">
                <label>Dossier source (serveur)
                    <input type="text" name="folder_path" placeholder="/data/inbox/resolutions" required>
                </label>
                <label>Taille echantillon
                    <input type="number" name="sample_size" min="1" max="200" value="30">
                </label>
                <label>Extensions (csv, optionnel)
                    <input type="text" name="extensions" placeholder="pdf,doc,docx,xlsx,pptx,png,jpg,tiff">
                </label>
            </div>
            <button class="btn" type="submit">Apprendre un preset depuis un dossier</button>
        </form>
        <form action="/ui/presets" method="post">
            <div class="form-grid">
                <label>ID
                    <input type="text" name="id" placeholder="preset_pv" required>
                </label>
                <label>Nom
                    <input type="text" name="name" placeholder="Preset Procès-Verbal" required>
                </label>
                <label>Code de classement
                    <div class="class-picker">
                        <input id="presetCreateClassCode" type="text" name="class_code" list="presetClassCodeList" placeholder="Tape un code, un titre ou un chemin" autocomplete="off" spellcheck="false">
                        <div id="presetCreateClassCodePicker" class="class-picker-panel" hidden></div>
                    </div>
                </label>
                <label>Post-traitement (csv)
                    <input type="text" name="postprocess" placeholder="upper,trim">
                </label>
            </div>
            <input type="hidden" name="name_format" value="#(routing_default_name_format)">
            <button class="btn" type="submit">Enregistrer le préréglage</button>
        </form>
        <p class="hint">Le format de nom visible des préréglages a été déplacé vers <a href="/ui/naming">Nommage</a>. Un format de secours hérité est conservé en arrière-plan pour compatibilité.</p>
    </section>

    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Code de classement</th>
            <th>Post-traitement</th>
        </tr>
        </thead>
        <tbody>
        #for(preset in presets):
        <tr>
            <td class="mono">#(preset.id)</td>
            <td>#(preset.name)</td>
            <td>#(preset.class_code)</td>
            <td>#(preset.postprocess)</td>
        </tr>
        #endfor
        </tbody>
    </table>
</main>
<datalist id="presetClassCodeList">
    #for(option in class_code_options):
    <option value="#(option.code)" data-label="#(option.label)" data-display="#(option.display)" data-path="#(option.path)">#(option.display)</option>
    #endfor
</datalist>
<script>
function openLocalRuleFolderDialog(fileInputId) {
    const picker = document.getElementById(fileInputId);
    if (!picker) {
        return;
    }
    picker.value = "";
    picker.click();
}

function handleRuleFolderSelection(fileInputId, pathInputId, hintId, namesFieldId) {
    const picker = document.getElementById(fileInputId);
    const pathInput = document.getElementById(pathInputId);
    const hint = document.getElementById(hintId);
    const namesField = document.getElementById(namesFieldId);
    if (!picker) {
        return;
    }

    const files = Array.from(picker.files || []);
    if (!files.length) {
        if (hint) {
            hint.textContent = "Aucun dossier local sélectionné.";
        }
        if (namesField) {
            namesField.value = "";
        }
        return;
    }

    const pdfEntries = files
        .filter((file) => file.name.toLowerCase().endsWith(".pdf"))
        .map((file) => file.webkitRelativePath || file.name);

    if (pathInput) {
        pathInput.value = "";
    }
    if (namesField) {
        namesField.value = pdfEntries.join("\n");
    }

    const firstRelativePath = pdfEntries[0] || files[0].webkitRelativePath || files[0].name;
    const folderName = firstRelativePath.includes("/") ? firstRelativePath.split("/")[0] : firstRelativePath;
    if (hint) {
        hint.textContent = `Dossier local de référence: ${folderName} (${pdfEntries.length} PDF retenus).`;
    }
}

const presetTaxonomyEntries = Array.from(document.querySelectorAll("#presetClassCodeList option")).map((option) => ({
    code: option.value,
    label: option.dataset.label || option.textContent.trim() || option.value,
    display: option.dataset.display || option.textContent.trim() || option.value,
    path: option.dataset.path || "",
    search: `${option.value} ${option.dataset.label || ""} ${option.dataset.display || ""} ${option.dataset.path || ""}`.toLowerCase()
}));
const presetTaxonomyPageSize = 200;
let presetTaxonomyVisibleCount = presetTaxonomyPageSize;

function escapePresetHTML(value) {
    return String(value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll("\"", "&quot;")
        .replaceAll("'", "&#39;");
}

function renderPresetTaxonomyBrowser(query = "") {
    const browser = document.getElementById("presetTaxonomyBrowser");
    const meta = document.getElementById("presetTaxonomyMeta");
    if (!browser || !meta) {
        return;
    }
    const normalized = String(query || "").trim().toLowerCase();
    const matches = presetTaxonomyEntries
        .filter((entry) => !normalized || entry.search.includes(normalized));
    const visibleCount = normalized
        ? matches.length
        : Math.min(matches.length, presetTaxonomyVisibleCount);
    const visibleMatches = matches.slice(0, visibleCount);

    meta.textContent = normalized
        ? `${visibleCount} résultat(s) affiché(s) sur ${presetTaxonomyEntries.length} codes chargés.`
        : `${visibleCount} code(s) affiché(s) sur ${presetTaxonomyEntries.length} chargés.`;

    if (!matches.length) {
        browser.innerHTML = `<div class="taxonomy-browser-empty">Aucun code correspondant à la recherche.</div>`;
        return;
    }

    const rows = visibleMatches.map((entry) => `
        <div class="taxonomy-browser-row">
            <div class="mono"><strong>${escapePresetHTML(entry.code)}</strong></div>
            <div>${escapePresetHTML(entry.label)}</div>
            <div>${escapePresetHTML(entry.path || "Chemin non précisé")}</div>
        </div>
    `).join("");
    const canShowMore = !normalized && visibleCount < matches.length;
    const actions = canShowMore ? `
        <div class="taxonomy-browser-actions">
            <button type="button" id="presetTaxonomyShowMoreButton">Afficher ${Math.min(presetTaxonomyPageSize, matches.length - visibleCount)} code(s) de plus</button>
            <button type="button" id="presetTaxonomyShowAllButton">Afficher tous les ${matches.length} codes</button>
        </div>
    ` : "";

    browser.innerHTML = `${rows}${actions}`;
    document.getElementById("presetTaxonomyShowMoreButton")?.addEventListener("click", () => {
        presetTaxonomyVisibleCount = Math.min(matches.length, presetTaxonomyVisibleCount + presetTaxonomyPageSize);
        renderPresetTaxonomyBrowser(query);
    });
    document.getElementById("presetTaxonomyShowAllButton")?.addEventListener("click", () => {
        presetTaxonomyVisibleCount = matches.length;
        renderPresetTaxonomyBrowser(query);
    });
}

window.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("presetTaxonomySearch");
    renderPresetTaxonomyBrowser(searchInput?.value || "");
    searchInput?.addEventListener("input", () => {
        presetTaxonomyVisibleCount = presetTaxonomyPageSize;
        renderPresetTaxonomyBrowser(searchInput.value);
    });

    const classPickerInputs = [
        ["presetWhenClassCode", "presetWhenClassCodePicker"],
        ["presetActionClassCode", "presetActionClassCodePicker"],
        ["presetCreateClassCode", "presetCreateClassCodePicker"]
    ];

    function hidePresetClassPickers() {
        document.querySelectorAll(".class-picker-panel").forEach((panel) => {
            panel.hidden = true;
        });
    }

    function renderPresetClassPicker(inputId, panelId) {
        const input = document.getElementById(inputId);
        const panel = document.getElementById(panelId);
        if (!input || !panel) {
            return;
        }
        const normalized = String(input.value || "").trim().toLowerCase();
        const matches = presetTaxonomyEntries
            .filter((entry) => !normalized || entry.search.includes(normalized))
            .sort((left, right) => {
                const leftStarts = left.code.toLowerCase().startsWith(normalized) || left.label.toLowerCase().startsWith(normalized) ? -1 : 0;
                const rightStarts = right.code.toLowerCase().startsWith(normalized) || right.label.toLowerCase().startsWith(normalized) ? -1 : 0;
                if (leftStarts !== rightStarts) {
                    return leftStarts - rightStarts;
                }
                return left.code.localeCompare(right.code, "fr", { numeric: true, sensitivity: "base" });
            })
            .slice(0, 16);

        if (!matches.length) {
            panel.innerHTML = `<div class="class-picker-empty">Aucun code correspondant.</div>`;
            panel.hidden = false;
            return;
        }

        panel.innerHTML = matches.map((entry) => `
            <button
                type="button"
                class="class-picker-option"
                data-code="${escapePresetHTML(entry.code)}"
                onmousedown="event.preventDefault()"
            >
                <strong>${escapePresetHTML(entry.code)} — ${escapePresetHTML(entry.label)}</strong>
                <small>${escapePresetHTML(entry.path || "Chemin non précisé")}</small>
            </button>
        `).join("");

        panel.querySelectorAll(".class-picker-option").forEach((button) => {
            button.addEventListener("click", () => {
                input.value = button.dataset.code || "";
                panel.hidden = true;
            });
        });
        panel.hidden = false;
    }

    for (const [inputId, panelId] of classPickerInputs) {
        const input = document.getElementById(inputId);
        const panel = document.getElementById(panelId);
        if (!input || !panel) {
            continue;
        }
        input.addEventListener("focus", () => renderPresetClassPicker(inputId, panelId));
        input.addEventListener("input", () => renderPresetClassPicker(inputId, panelId));
        input.addEventListener("blur", () => {
            window.setTimeout(() => {
                panel.hidden = true;
            }, 140);
        });
    }

    document.addEventListener("click", (event) => {
        if (!event.target.closest(".class-picker")) {
            hidePresetClassPickers();
        }
    });
});
</script>
</body>
</html>

<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Préréglages</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ink); background: var(--bg); }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap { max-width: 1200px; margin: 20px auto 40px; padding: 0 16px; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 14px;
        }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 10px;
        }
        label { display: block; font-size: 13px; color: var(--muted); }
        input {
            margin-top: 4px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            font: inherit;
            background: #fff;
        }
        .btn {
            margin-top: 10px;
            border: 1px solid var(--accent);
            color: #fff;
            background: var(--accent);
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .notice {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--accent);
        }
        .error {
            margin: 0 0 10px;
            font-weight: 700;
            color: #ac5d0c;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 13px;
        }
        th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .mono { font-family: "SF Mono", Menlo, monospace; }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Préréglages</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/presets">Préréglages</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>
<main class="wrap">
    <section class="card">
        <h2>Créer un préréglage</h2>
        #if(notice):
        <p class="notice">#(notice)</p>
        #endif
        #if(error):
        <p class="error">#(error)</p>
        #endif
        <form action="/ui/presets" method="post">
            <div class="form-grid">
                <label>ID
                    <input type="text" name="id" placeholder="preset_pv" required>
                </label>
                <label>Nom
                    <input type="text" name="name" placeholder="Preset Procès-Verbal" required>
                </label>
                <label>Format de nom
                    <input type="text" name="name_format" placeholder="{type}-{date}-{numero}" required>
                </label>
                <label>Code de classement
                    <input type="text" name="class_code" placeholder="ADM-PV">
                </label>
                <label>Post-traitement (csv)
                    <input type="text" name="postprocess" placeholder="upper,trim">
                </label>
            </div>
            <button class="btn" type="submit">Enregistrer le préréglage</button>
        </form>
    </section>

    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Format de nom</th>
            <th>Code de classement</th>
            <th>Post-traitement</th>
        </tr>
        </thead>
        <tbody>
        #for(preset in presets):
        <tr>
            <td class="mono">#(preset.id)</td>
            <td>#(preset.name)</td>
            <td class="mono">#(preset.name_format)</td>
            <td>#(preset.class_code)</td>
            <td>#(preset.postprocess)</td>
        </tr>
        #endfor
        </tbody>
    </table>
</main>
</body>
</html>

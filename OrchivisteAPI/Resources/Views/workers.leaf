<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Agents</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ink); background: var(--bg); }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap { max-width: 1200px; margin: 20px auto 40px; padding: 0 16px; }
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 10px;
            margin-bottom: 16px;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
        }
        .kpi {
            font-size: 26px;
            font-weight: 800;
            margin-top: 8px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 13px;
        }
        th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .mono { font-family: "SF Mono", Menlo, monospace; }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Agents</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/jobs">Taches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/presets">Prereglages</a>
    </nav>
</header>
<main class="wrap">
    <section class="cards">
        <article class="card"><div>Agents</div><div class="kpi">#(workers.count)</div></article>
        <article class="card"><div>File d'ingestion</div><div class="kpi">#(queue_ingest_depth)</div></article>
        <article class="card"><div>File de rejet</div><div class="kpi">#(queue_dead_letter_depth)</div></article>
    </section>

    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Statut</th>
            <th>Capacites</th>
            <th>Dernier signalement</th>
            <th>Version</th>
            <th>Charge</th>
            <th>RAM MB</th>
        </tr>
        </thead>
        <tbody>
        #for(worker in workers):
        <tr>
            <td class="mono">#(worker.id)</td>
            <td>#(worker.name)</td>
            <td>#(worker.status)</td>
            <td>#(worker.capabilities)</td>
            <td>#(worker.last_seen)</td>
            <td>#(worker.version)</td>
            <td>#(worker.load)</td>
            <td>#(worker.ram_mb)</td>
        </tr>
        #endfor
        </tbody>
    </table>
</main>
</body>
</html>

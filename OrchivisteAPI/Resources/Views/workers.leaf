<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Agents</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ink); background: var(--bg); }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap { max-width: 1200px; margin: 20px auto 40px; padding: 0 16px; }
        .notice {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--accent);
        }
        .error {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--warning);
        }
        .enroll {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 12px;
        }
        .enroll-form {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 10px;
            align-items: end;
        }
        .enroll-form label {
            display: block;
            font-size: 13px;
            color: var(--muted);
        }
        .enroll-form input {
            margin-top: 4px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            font: inherit;
            background: #fff;
        }
        .btn {
            border: 1px solid var(--accent);
            color: var(--accent);
            background: #ebf8f4;
            border-radius: 8px;
            padding: 7px 9px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn-primary {
            color: #fff;
            background: var(--accent);
        }
        .actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .mini-form {
            display: inline-flex;
            gap: 6px;
            align-items: center;
        }
        .mini-form input {
            width: 92px;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 6px;
            font-size: 12px;
            background: #fff;
        }
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 10px;
            margin-bottom: 16px;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
        }
        .kpi {
            font-size: 26px;
            font-weight: 800;
            margin-top: 8px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 13px;
        }
        th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .mono { font-family: "SF Mono", Menlo, monospace; }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Agents</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/regles">Règles documentaires</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>
<main class="wrap">
    #if(notice):
    <p class="notice">#(notice)</p>
    #endif
    #if(error):
    <p class="error">#(error)</p>
    #endif

    <section class="enroll" style="margin-bottom: 14px;">
        <h3>À quoi servent les agents ?</h3>
        <p style="margin: 0 0 6px;">
            Les agents sont des workers macOS pour les traitements lourds (OCR Vision, Core ML, découpe PDF).
            En MVP, cette page sert surtout à simuler leur cycle <strong>enrôlement → approbation → heartbeat</strong>.
        </p>
        <p style="margin: 0; color: var(--muted); font-size: 12px;">
            Si tu n’utilises pas encore de workers externes, tu peux laisser cette section telle quelle.
        </p>
    </section>

    <section class="cards">
        <article class="card"><div>Agents</div><div class="kpi">#(workers.count)</div></article>
        <article class="card"><div>File d'ingestion</div><div class="kpi">#(queue_ingest_depth)</div></article>
        <article class="card"><div>File de rejet</div><div class="kpi">#(queue_dead_letter_depth)</div></article>
    </section>

    <section class="enroll">
        <h3>Enrôler un agent</h3>
        <form class="enroll-form" action="/ui/workers/enroll" method="post">
            <label>Nom agent
                <input type="text" name="name" placeholder="worker-mac-01" required>
            </label>
            <label>Capacités (csv)
                <input type="text" name="capabilities" placeholder="ocr,vision,pdf">
            </label>
            <button class="btn btn-primary" type="submit">Enrôler</button>
        </form>
    </section>

    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Statut</th>
            <th>Capacités</th>
            <th>Core ML</th>
            <th>Dernier signalement</th>
            <th>Version</th>
            <th>Charge</th>
            <th>RAM MB</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        #for(worker in workers):
        <tr>
            <td class="mono">#(worker.id)</td>
            <td>#(worker.name)</td>
            <td>#(worker.status)</td>
            <td>#(worker.capabilities)</td>
            <td>#if(worker.has_coreml):Oui#else:Non#endif</td>
            <td>#(worker.last_seen)</td>
            <td>#(worker.version)</td>
            <td>#(worker.load)</td>
            <td>#(worker.ram_mb)</td>
            <td>
                <div class="actions">
                    #if(worker.can_approve):
                    <form method="post" action="/ui/workers/#(worker.id)/approve">
                        <button class="btn" type="submit">Approuver</button>
                    </form>
                    #endif

                    #if(worker.can_heartbeat):
                    <form class="mini-form" method="post" action="/ui/workers/#(worker.id)/heartbeat">
                        <input type="text" name="version" placeholder="ui-test">
                        <input type="text" name="load" placeholder="0.15">
                        <input type="text" name="ram_mb" placeholder="512">
                        <button class="btn" type="submit">Heartbeat test</button>
                    </form>
                    #endif

                    #if(worker.can_pause):
                    <form method="post" action="/ui/workers/#(worker.id)/pause">
                        <button class="btn" type="submit">Pause</button>
                    </form>
                    #endif

                    #if(worker.can_resume):
                    <form method="post" action="/ui/workers/#(worker.id)/resume">
                        <button class="btn" type="submit">Activer</button>
                    </form>
                    #endif

                    <form class="mini-form" method="post" action="/ui/workers/#(worker.id)/config">
                        <input type="text" name="version" placeholder="version">
                        <input type="text" name="capabilities" placeholder="ocr,vision,pdf,coreml">
                        <button class="btn" type="submit">Configurer</button>
                    </form>
                </div>
            </td>
        </tr>
        #endfor
        </tbody>
    </table>
</main>
</body>
</html>

<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Tâches</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ink); background: var(--bg); }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap { max-width: 1200px; margin: 20px auto 40px; padding: 0 16px; }
        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 13px;
        }
        th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .status-needs_review { color: var(--warning); font-weight: 700; }
        .status-completed { color: var(--accent); font-weight: 700; }
        .mono { font-family: "SF Mono", Menlo, monospace; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 14px;
        }
        .btn {
            border: 1px solid #9b3a16;
            color: #fff;
            background: #9b3a16;
            border-radius: 8px;
            padding: 8px 10px;
            font-weight: 700;
            cursor: pointer;
        }
        .notice { margin: 0 0 12px; color: var(--accent); font-weight: 700; }
        .error { margin: 0 0 12px; color: var(--warning); font-weight: 700; }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Tâches</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/presets">Préréglages</a>
        <a href="/ui/naming">Nommage</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>
<main class="wrap">
    #if(notice):
    <p class="notice">#(notice)</p>
    #endif
    #if(error):
    <p class="error">#(error)</p>
    #endif

    <section class="card">
        <h2 style="margin-top:0;">Nettoyage rapide</h2>
        <p style="margin:0 0 10px; color: var(--muted);">
            Cette action vide la liste des tâches et nettoie les fichiers de travail dans l'inbox et dans le dossier
            <span class="mono">A_reviser</span>. Les archives finales déjà routées ailleurs ne sont pas supprimées.
        </p>
        <p style="margin:0 0 10px; color: var(--muted); font-size: 12px;">
            Inbox : <span class="mono">#(cleanup_inbox_path)</span><br>
            A_reviser : <span class="mono">#(cleanup_review_path)</span>
        </p>
        <form action="/ui/jobs/clear" method="post" onsubmit="return confirm('Effacer toutes les tâches et nettoyer inbox + A_reviser ?');">
            <button class="btn" type="submit">Effacer les tâches et nettoyer les dossiers de travail</button>
        </form>
    </section>

    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Statut</th>
            <th>Source</th>
            <th>Fichier</th>
            <th>Code</th>
            <th>Confiance</th>
            <th>Mise à jour</th>
        </tr>
        </thead>
        <tbody>
        #for(job in jobs):
        <tr>
            <td class="mono"><a href="/ui/jobs/#(job.id)">#(job.id)</a></td>
            <td class="status-#(job.status)">#(job.status_label)</td>
            <td>#(job.source_kind)</td>
            <td>#(job.file_url)</td>
            <td>#(job.suggested_class_code)</td>
            <td>#(job.confidence)</td>
            <td>#(job.updated_at)</td>
        </tr>
        #endfor
        </tbody>
    </table>
</main>
</body>
</html>

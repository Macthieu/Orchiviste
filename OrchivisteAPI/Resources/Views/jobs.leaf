<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Tâches</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ink); background: var(--bg); }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap { max-width: 1200px; margin: 20px auto 40px; padding: 0 16px; }
        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 13px;
        }
        th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .status-needs_review { color: var(--warning); font-weight: 700; }
        .status-completed { color: var(--accent); font-weight: 700; }
        .mono { font-family: "SF Mono", Menlo, monospace; }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Tâches</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/presets">Préréglages</a>
        <a href="/ui/naming">Nommage</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>
<main class="wrap">
    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Statut</th>
            <th>Source</th>
            <th>Fichier</th>
            <th>Code</th>
            <th>Confiance</th>
            <th>Mise à jour</th>
        </tr>
        </thead>
        <tbody>
        #for(job in jobs):
        <tr>
            <td class="mono"><a href="/ui/jobs/#(job.id)">#(job.id)</a></td>
            <td class="status-#(job.status)">#(job.status_label)</td>
            <td>#(job.source_kind)</td>
            <td>#(job.file_url)</td>
            <td>#(job.suggested_class_code)</td>
            <td>#(job.confidence)</td>
            <td>#(job.updated_at)</td>
        </tr>
        #endfor
        </tbody>
    </table>
</main>
</body>
</html>

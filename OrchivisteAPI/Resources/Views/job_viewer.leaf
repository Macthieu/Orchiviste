<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Visionneuse #(id)</title>
    <style>
        :root {
            --bg: #f2efe8;
            --surface: #fffefb;
            --ink: #1f252a;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --border: #d8d1c4;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ink); background: linear-gradient(170deg, #f6f3ec 0%, #ece6dc 100%); }
        header {
            padding: 18px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 12px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap {
            max-width: 1920px;
            margin: 16px auto 30px;
            padding: 0 14px;
            display: grid;
            grid-template-columns: minmax(0, 1.25fr) minmax(700px, 1.35fr);
            gap: 16px;
        }
        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
        }
        .meta dl { margin: 0; display: grid; grid-template-columns: 170px 1fr; row-gap: 8px; column-gap: 10px; }
        .meta dt { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
        .meta dd { margin: 0; font-weight: 600; word-break: break-word; }
        .btn {
            border: 1px solid var(--accent);
            color: var(--accent);
            background: #ebf8f4;
            border-radius: 8px;
            padding: 8px 10px;
            text-decoration: none;
            font-weight: 700;
            display: inline-block;
        }
        #pages {
            display: grid;
            gap: 12px;
            margin-top: 10px;
        }
        .page {
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
            min-height: 220px;
            background: #f3ede4;
            position: relative;
        }
        .page::before {
            content: "Chargement page";
            position: absolute;
            top: 10px;
            left: 10px;
            font-size: 12px;
            color: var(--muted);
        }
        .page img {
            width: 100%;
            display: block;
            opacity: 0;
            transition: opacity 220ms ease;
        }
        .page img.ready { opacity: 1; }
        textarea, input, select {
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            font: inherit;
            margin-top: 4px;
            background: #fff;
        }
        .viewer-json {
            font-family: "SF Mono", Menlo, monospace;
            font-size: 12px;
            line-height: 1.45;
            min-height: 300px;
            resize: vertical;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }
        .viewer-json-large {
            min-height: 440px;
        }
        .viewer-text {
            min-height: 360px;
            resize: vertical;
            line-height: 1.5;
        }
        .viewer-text-large {
            min-height: 460px;
        }
        .meta-block {
            margin: 10px 0 12px;
            padding: 10px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #fbf8f2;
        }
        .meta-block h5 {
            margin: 0 0 8px;
            font-size: 13px;
        }
        .meta-block dl {
            grid-template-columns: 220px 1fr;
            row-gap: 6px;
            column-gap: 8px;
        }
        input[type="checkbox"] {
            width: auto;
            margin: 0;
            padding: 0;
        }
        label { display: block; margin-top: 10px; font-size: 13px; }
        .notice { color: var(--warning); font-weight: 700; }
        .tabs {
            display: flex;
            gap: 8px;
            margin: 8px 0;
        }
        .tabs button {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 7px 10px;
            background: #fff;
            color: var(--ink);
            font-weight: 700;
            cursor: pointer;
        }
        .tabs button.active {
            border-color: var(--accent);
            background: #ebf8f4;
            color: var(--accent);
        }
        .preview-box {
            border: 1px dashed var(--border);
            border-radius: 10px;
            padding: 10px;
            background: #faf7f1;
            margin-bottom: 12px;
        }
        .preview-name {
            font-family: "SF Mono", Menlo, monospace;
            font-weight: 700;
            word-break: break-word;
        }
        .preview-meta {
            margin-top: 6px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.45;
        }
        .preview-ranking {
            margin-top: 10px;
            padding-top: 10px;
            border-top: 1px solid var(--border);
        }
        .preview-ranking-best {
            margin: 10px 0 12px;
            padding: 10px;
            border-radius: 8px;
            background: #f2fbf7;
            border: 1px solid #cfe7db;
        }
        .preview-ranking-best strong {
            display: block;
            margin-bottom: 4px;
        }
        .preview-score-chip {
            display: inline-block;
            margin-top: 6px;
            padding: 3px 8px;
            border-radius: 999px;
            background: #dff3ea;
            color: var(--accent);
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }
        .preview-ranking table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }
        .preview-ranking th,
        .preview-ranking td {
            text-align: left;
            vertical-align: top;
            padding: 6px 4px;
            border-bottom: 1px solid var(--border);
        }
        .preview-ranking th {
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-size: 11px;
        }
        .hint-list {
            margin: 8px 0 12px 18px;
            padding: 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.45;
        }
        .hint-list li {
            margin-bottom: 6px;
        }
        .soft-note {
            margin: 6px 0 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.45;
        }
        .route-file-name-field {
            min-height: 78px;
            resize: vertical;
            line-height: 1.45;
            font-family: "SF Mono", Menlo, monospace;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }
        .class-picker {
            position: relative;
        }
        .class-picker-panel {
            position: absolute;
            z-index: 20;
            top: calc(100% + 4px);
            left: 0;
            right: 0;
            max-height: 260px;
            overflow: auto;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--surface);
            box-shadow: 0 12px 24px rgba(31, 37, 42, 0.12);
        }
        .class-picker-panel[hidden] {
            display: none;
        }
        .class-picker-option {
            width: 100%;
            border: 0;
            border-bottom: 1px solid #efe7da;
            background: transparent;
            text-align: left;
            padding: 10px;
            cursor: pointer;
            color: var(--ink);
        }
        .class-picker-option:hover,
        .class-picker-option:focus {
            background: #f5f0e6;
            outline: none;
        }
        .class-picker-option strong {
            display: block;
            margin-bottom: 2px;
        }
        .class-picker-option small {
            display: block;
            color: var(--muted);
            line-height: 1.35;
        }
        .class-picker-empty {
            padding: 10px;
            color: var(--muted);
            font-size: 12px;
        }
        .inline-check {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 10px;
            color: var(--muted);
            font-size: 12px;
        }
        .tab-pane { display: none; }
        .tab-pane.active { display: block; }
        @media (max-width: 1520px) {
            .wrap {
                grid-template-columns: minmax(0, 1.15fr) minmax(600px, 1.2fr);
            }
        }
        @media (max-width: 1320px) {
            .wrap {
                grid-template-columns: minmax(0, 1.2fr) minmax(520px, 1.1fr);
            }
        }
        @media (max-width: 960px) {
            .wrap { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<header>
    <strong>Visionneuse tâche <span style="font-family:SF Mono, Menlo, monospace">#(id)</span></strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/regles">Règles documentaires</a>
        <a href="/ui/events">Événements</a>
        <a class="btn" href="#(download_url)">Télécharger (action explicite)</a>
        <a class="btn" href="#(download_searchable_url)">Télécharger PDF OCR (explicite)</a>
    </nav>
</header>

<main class="wrap">
    <section class="panel">
        <h3>Aperçu des pages (chargement paresseux)</h3>
        <p style="margin:0 0 10px; color: var(--muted); font-size: 13px;">
            Aperçu en images JPG: la sélection de texte se fait via "Texte d'aperçu" ou via "Télécharger PDF OCR".
        </p>
        <p style="margin:0 0 10px; color: var(--muted); font-size: 12px;">
            Si une page ne s'affiche pas, recharge la page puis utilise "Télécharger PDF OCR (explicite)" pour vérifier le rendu texte sélectionnable.
        </p>
        <div id="pages"></div>
    </section>

    <aside class="panel meta">
        <h3>Analyse et revue</h3>
        <dl>
            <dt>Statut</dt><dd>#(status)</dd>
            <dt>Source</dt><dd>#(source_kind)</dd>
            <dt>Fichier</dt><dd>#(file_url)</dd>
            <dt>Dossier enregistré</dt><dd>#(saved_folder_path)</dd>
            <dt>Préréglage de routage</dt><dd>#(suggested_preset)</dd>
            <dt>Code de classement</dt><dd>#(suggested_class_code)</dd>
            <dt>Confiance</dt><dd>#(confidence)</dd>
            <dt>Type détecté</dt><dd>#(analysis_type_doc)</dd>
            <dt>Sujets détectés</dt><dd>#(analysis_sujets)</dd>
            <dt>Capture</dt><dd>#(analysis_capture_strategy)</dd>
            <dt>Raisons revue</dt><dd>#(analysis_review_reasons)</dd>
            <dt>Validation IDP</dt><dd>#(analysis_validation_flags)</dd>
        </dl>
        #if(analysis_review_reason_items_present):
        <p class="soft-note"><strong>Pourquoi une revue est demandée</strong></p>
        <ul class="hint-list">
            #for(item in analysis_review_reason_items):
            <li><strong>#(item.label)</strong> : #(item.value)</li>
            #endfor
        </ul>
        #endif
        #if(analysis_validation_items_present):
        <p class="soft-note"><strong>Ce que signifie “Validation IDP”</strong><br>
            Ce sont les contrôles internes de complétude et de cohérence du document avant renommage et routage.
        </p>
        <ul class="hint-list">
            #for(item in analysis_validation_items):
            <li><strong>#(item.label)</strong> : #(item.value)</li>
            #endfor
        </ul>
        #endif

        <h4>Résumé génératif</h4>
        <p style="margin: 0 0 8px; font-weight: 700;">#(analysis_summary_title)</p>
        <p style="margin: 0 0 8px; color: var(--muted); line-height: 1.5;">#(analysis_summary_text)</p>
        #if(analysis_summary_points_present):
        <ul style="margin: 0 0 12px 18px; padding: 0;">
            #for(point in analysis_summary_points):
            <li style="margin-bottom: 6px;">#(point)</li>
            #endfor
        </ul>
        #else:
        <p style="margin: 0 0 12px; color: var(--muted); font-size: 12px;">Aucun point saillant supplémentaire.</p>
        #endif

        <h4>Métadonnées suggérées</h4>
        #if(suggested_metadata_present):
        <dl>
            #for(item in suggested_metadata):
            <dt>#(item.label)</dt><dd>#(item.value)</dd>
            #endfor
        </dl>
        #else:
        <p style="margin: 0 0 8px; color: var(--muted); font-size: 12px;">Aucune métadonnée suggérée disponible.</p>
        #endif

        #if(extended_metadata_present):
        <div class="meta-block">
            <h5>Métadonnées documentaires détaillées</h5>
            <dl>
                #for(item in extended_metadata):
                <dt>#(item.label)</dt><dd>#(item.value)</dd>
                #endfor
            </dl>
        </div>
        #endif

        #if(accounting_metadata_present):
        <div class="meta-block">
            <h5>Métadonnées financières / comptables</h5>
            <dl>
                #for(item in accounting_metadata):
                <dt>#(item.label)</dt><dd>#(item.value)</dd>
                #endfor
            </dl>
        </div>
        #endif

        #if(municipal_metadata_present):
        <div class="meta-block">
            <h5>Métadonnées administration municipale</h5>
            <dl>
                #for(item in municipal_metadata):
                <dt>#(item.label)</dt><dd>#(item.value)</dd>
                #endfor
            </dl>
        </div>
        #endif

        #if(metadata_complements_present):
        <div class="meta-block">
            <h5>Métadonnées complémentaires détectées</h5>
            <dl>
                #for(item in metadata_complements):
                <dt>#(item.label)</dt><dd>#(item.value)</dd>
                #endfor
            </dl>
        </div>
        #endif
        <label>Métadonnées suggérées (JSON)
            <textarea class="viewer-json viewer-json-large" rows="20" readonly>#(suggested_metadata_json)</textarea>
        </label>

        <h4>Texte d'aperçu</h4>
        <label>Page <input id="textPage" type="number" min="1" value="1"></label>
        <button class="btn" type="button" onclick="loadText()">Charger le texte</button>
        <textarea id="textArea" class="viewer-text viewer-text-large" rows="20" readonly></textarea>

        <h4>Champs extraits (JSON)</h4>
        <textarea class="viewer-json viewer-json-large" rows="16" readonly>#(analysis_champs_json)</textarea>

        #if(can_review):
        <p class="notice">Revue requise : correction obligatoire avant routage.</p>
        <p style="margin: 6px 0; color: var(--muted); font-size: 12px;">
            Corrige le code, le préréglage et les métadonnées utiles, puis valide la revue. Tu peux aussi lancer le routage final dans la même action.
        </p>
        <div class="tabs">
            <button id="tabSuggestionBtn" type="button" class="active" onclick="switchReviewTab('suggestion')">Proposition IA</button>
            <button id="tabManualBtn" type="button" onclick="switchReviewTab('manual')">Correction manuelle</button>
        </div>
        <div id="tabSuggestion" class="tab-pane active">
            <label>Code de classement (proposé / sélection)
                <div class="class-picker">
                    <input id="reviewClassSelect" type="text" placeholder="Tape un code, un titre ou un chemin" autocomplete="off" spellcheck="false">
                    <div id="reviewClassPicker" class="class-picker-panel" hidden></div>
                </div>
            </label>
            <p id="reviewClassHint" class="soft-note"></p>
            <label>Préréglage de routage hérité (proposé / sélection)
                <select id="reviewPresetSelect">
                    <option value="">-- Aucun --</option>
                    #for(option in preset_options):
                    <option value="#(option)">#(option)</option>
                    #endfor
                </select>
            </label>
        </div>
        <div id="tabManual" class="tab-pane">
            <label>Code de classement corrigé <input id="reviewClass" type="text" placeholder="ADM-PV"></label>
            <label>Préréglage de routage hérité corrigé <input id="reviewPreset" type="text" placeholder="preset_pv"></label>
            <label>Type document corrigé <input id="reviewTypeDoc" type="text" placeholder="ProcesVerbal"></label>
            <label>Sujets corrigés (csv) <input id="reviewSujets" type="text" placeholder="Comite, Session"></label>
            <label>Numéro document corrigé <input id="reviewDocumentNumber" type="text" placeholder="2026-28"></label>
            <label>Objet corrigé <input id="reviewDocumentObject" type="text" placeholder="Objet principal du document"></label>
            <label>Date document corrigée <input id="reviewDocumentDate" type="text" placeholder="2026-02-02"></label>
            <label>Organisme émetteur corrigé <input id="reviewDocumentIssuer" type="text" placeholder="Ville d'Amos"></label>
        </div>
        <label>Commentaire <textarea id="reviewComment" rows="3"></textarea></label>
        <button class="btn" type="button" onclick="submitReview()">Soumettre la revue</button>
        #else:
        <p style="margin: 6px 0; color: var(--muted); font-size: 12px;">
            Aucune correction requise pour cette tâche (statut différent de "Revue requise").
        </p>
        #endif

        <h4>Nom final proposé</h4>
        <div id="routePreviewBox" class="preview-box" #if(proposed_file_name_present):style="display:block;"#else:style="display:none;"#endif>
            <div id="routePreviewName" class="preview-name">#(proposed_file_name)</div>
            <div id="routePreviewSource" class="preview-meta">Source: #(proposed_name_source)</div>
            #if(proposed_naming_rule_present):
            <div id="routePreviewRule" class="preview-meta">Règle utilisée: #(proposed_naming_rule_id)</div>
            #else:
            <div id="routePreviewRule" class="preview-meta" style="display:none;"></div>
            #endif
            #if(proposed_destination_folder_present):
            <div id="routePreviewFolder" class="preview-meta">Dossier cible: #(proposed_destination_folder)</div>
            #else:
            <div id="routePreviewFolder" class="preview-meta" style="display:none;"></div>
            #endif
            <div id="routePreviewRanking" class="preview-ranking" #if(proposed_ranking_present):style="display:block;"#else:style="display:none;"#endif>
                <div id="routePreviewRankingStatus" class="preview-meta">Ranking: #(proposed_ranking_provider_status)</div>
                #if(proposed_ranking_present):
                #for(row in proposed_ranking_rows):
                #if(forloop.first):
                <div id="routePreviewRankingBest" class="preview-ranking-best">
                    <strong>Suggestion la plus probable : #(row.label)</strong>
                    <div class="preview-meta">
                        Règle <span class="mono">#(row.rule_id)</span><br>
                        #(row.reasons)
                    </div>
                    <div id="routePreviewRankingBestChip" class="preview-score-chip">Confiance élevée</div>
                </div>
                #endif
                #endfor
                #else:
                <div id="routePreviewRankingBest" class="preview-ranking-best" style="display:none;"></div>
                #endif
                <table>
                    <thead>
                    <tr>
                        <th>Règle</th>
                        <th>Pourquoi</th>
                        <th>Final</th>
                        <th>Déterministe</th>
                        <th>Core ML</th>
                    </tr>
                    </thead>
                    <tbody id="routePreviewRankingBody">
                    #for(row in proposed_ranking_rows):
                    <tr>
                        <td>
                            <span class="mono">#(row.rule_id)</span><br>
                            <strong>#(row.label)</strong><br>
                            <span class="preview-meta">#(row.sources)</span>
                        </td>
                        <td>#(row.reasons)</td>
                        <td>#(row.final_score)</td>
                        <td>#(row.deterministic_score)</td>
                        <td>#(row.ml_score)</td>
                    </tr>
                    #endfor
                    </tbody>
                </table>
            </div>
            <div id="routePreviewFooter" class="preview-meta">
                Cette proposition reprend la logique actuelle de routage. Un dossier ou un format saisi ci-dessous la remplacera au moment du routage.
            </div>
        </div>
        <p id="routePreviewEmpty" style="margin: 0 0 12px; color: var(--muted); font-size: 12px; #if(proposed_file_name_present):display:none;#else:display:block;#endif">
            Aucune proposition automatique disponible pour cette tâche.
        </p>

        <h4>Routage et renommage</h4>
        #if(routed_at):
        <p>Déjà routée le <strong>#(routed_at)</strong>.</p>
        #endif
        #if(show_routing_form):
        #if(proposed_naming_rule_present):
        <p style="margin: 0 0 10px; color: var(--muted); font-size: 12px;">
            Règle de nommage proposée: <strong>#(proposed_naming_rule_id)</strong>. Le champ de préréglage ci-dessous reste un réglage de routage hérité.
        </p>
        #endif
        <label>Preset de nommage
            <select id="routeNamingRuleSelect">
                <option value="">Détection automatique</option>
                #for(option in naming_rule_options):
                <option value="#(option.id)">#(option.display)</option>
                #endfor
            </select>
        </label>
        <button class="btn btn-secondary" type="button" onclick="refreshRoutePreview(true)">Recalculer le nom</button>
        <label>Nom de fichier final (modifiable)
            <textarea id="routePreferredFileName" class="route-file-name-field" rows="3" data-initial="#(proposed_file_name_input)" placeholder="Résolution NO 2025-368 – Titre – 2025-09-02.pdf" spellcheck="false">#(proposed_file_name_input)</textarea>
        </label>
        <label class="inline-check">
            <input id="routeLearnCorrection" type="checkbox" checked>
            <span>Mémoriser automatiquement cette correction pour les prochains cas similaires</span>
        </label>
        <input id="routeNamingRuleFallback" type="hidden" value="#(proposed_naming_rule_id)">
        <button class="btn" type="button" onclick="submitNamingFeedback().catch(() => {})">Mémoriser la correction</button>
        <p style="margin: 6px 0 10px; color: var(--muted); font-size: 12px;">
            Cette action enrichit la règle active et le thésaurus sans attendre le routage. Sélectionne un preset de nommage si Orchiviste n'en a pas déjà proposé un.
        </p>
        <label>Dossier destination (optionnel)
            <input id="routeFolder" type="text" placeholder="Archives/{year}/{class_code}/{type_doc}/{sujet}">
        </label>
        <label>Format de nom (optionnel)
            <input id="routeNameFormat" type="text" placeholder="{class_code}-{type_doc}-{sujet}-{date}-{numero}">
        </label>
        <label>Code de classement (optionnel)
            <div class="class-picker">
                <input id="routeClassCode" type="text" value="#(suggested_class_code)" placeholder="Tape un code, un titre ou un chemin" autocomplete="off" spellcheck="false">
                <div id="routeClassPicker" class="class-picker-panel" hidden></div>
            </div>
        </label>
        <p id="routeClassHint" class="soft-note"></p>
        <label>ID préréglage de routage (optionnel)
            <input id="routePresetId" type="text" value="#(suggested_preset)">
        </label>
        <label>Export archivage (optionnel)
            <select id="routeExportType">
                <option value="">PDF standard</option>
                <option value="pdfa">PDF/A-2b</option>
            </select>
        </label>
        #if(can_route_after_review):
        <p style="margin: 6px 0; color: var(--muted); font-size: 12px;">
            Le fichier sera d'abord validé, puis routé avec les paramètres ci-dessous.
        </p>
        <button class="btn" type="button" onclick="submitReview(true)">Valider et router</button>
        #endif
        #if(can_route):
        <button class="btn" type="button" onclick="submitRoute()">Appliquer le routage</button>
        #endif
        #if(can_reroute):
        <p style="margin: 6px 0; color: var(--muted); font-size: 12px;">
            Cette tâche est déjà routée. Orchiviste repartira du fichier actuellement sorti pour le renommer ou le déplacer selon la règle courante.
        </p>
        <button class="btn" type="button" onclick="submitRoute()">Renommer de nouveau et rerouter</button>
        #endif
        #else:
        #if(route_disabled_reason):
        <p class="notice">#(route_disabled_reason)</p>
        #else:
        <p class="notice">Routage indisponible.</p>
        #endif
        #endif
        <textarea id="routeResult" rows="4" readonly placeholder="Résultat du routage"></textarea>
    </aside>
</main>

<datalist id="classCodeOptionsList">
    #for(option in class_code_options):
    <option value="#(option.code)" data-label="#(option.label)" data-display="#(option.display)" data-path="#(option.path)">#(option.display)</option>
    #endfor
</datalist>

<script>
const jobId = "#(id)";
const pagesCount = Number("#(preview_pages)") || 1;
const container = document.getElementById("pages");
for (let page = 1; page <= pagesCount; page += 1) {
    const box = document.createElement("div");
    box.className = "page";
    box.dataset.page = String(page);
    const img = document.createElement("img");
    img.alt = `Page ${page}`;
    box.appendChild(img);
    container.appendChild(box);
}

const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const page = entry.target.dataset.page;
        const img = entry.target.querySelector("img");
        if (img.dataset.loaded === "1") continue;
        img.src = `/v1/preview/${jobId}/page/${page}.jpg`;
        img.onload = () => { img.classList.add("ready"); img.dataset.loaded = "1"; };
        img.onerror = () => {
            img.dataset.loaded = "1";
            entry.target.style.background = "#f6efe4";
            entry.target.innerHTML = `<div style="padding:12px;color:#ac5d0c;font-size:12px;">Aperçu image indisponible pour la page ${page}.</div>`;
        };
    }
}, { rootMargin: "300px 0px" });

document.querySelectorAll(".page").forEach((node) => observer.observe(node));

const routeClassInput = document.getElementById("routeClassCode");
if (routeClassInput && routeClassInput.value === "N/D") {
    routeClassInput.value = "";
}
const routePresetInput = document.getElementById("routePresetId");
if (routePresetInput && routePresetInput.value === "N/D") {
    routePresetInput.value = "";
}

const classCodeDirectory = {};
document.querySelectorAll("#classCodeOptionsList option").forEach((option) => {
    classCodeDirectory[option.value] = {
        label: option.dataset.label || option.textContent.trim() || option.value,
        display: option.dataset.display || option.textContent.trim() || option.value,
        path: option.dataset.path || ""
    };
});
const classCodeEntries = Object.entries(classCodeDirectory)
    .map(([code, entry]) => ({
        code,
        label: entry.label || code,
        display: entry.display || code,
        path: entry.path || "",
        search: `${code} ${entry.label || ""} ${entry.display || ""} ${entry.path || ""}`.toLowerCase()
    }))
    .sort((left, right) => left.code.localeCompare(right.code, "fr", { numeric: true, sensitivity: "base" }));

const suggestedClassCode = "#(suggested_class_code_raw)";
const suggestedPreset = "#(suggested_preset_raw)";
const initialNamingRuleId = "#(selected_naming_rule_id)";
const reviewClassSelect = document.getElementById("reviewClassSelect");
if (reviewClassSelect && suggestedClassCode && suggestedClassCode !== "N/D") {
    reviewClassSelect.value = suggestedClassCode;
}
const reviewPresetSelect = document.getElementById("reviewPresetSelect");
if (reviewPresetSelect && suggestedPreset && suggestedPreset !== "N/D") {
    reviewPresetSelect.value = suggestedPreset;
}
const reviewClassManual = document.getElementById("reviewClass");
if (reviewClassManual && suggestedClassCode && suggestedClassCode !== "N/D") {
    reviewClassManual.value = suggestedClassCode;
}
const reviewPresetManual = document.getElementById("reviewPreset");
if (reviewPresetManual && suggestedPreset && suggestedPreset !== "N/D") {
    reviewPresetManual.value = suggestedPreset;
}
const routeNamingRuleSelect = document.getElementById("routeNamingRuleSelect");
if (routeNamingRuleSelect && initialNamingRuleId) {
    routeNamingRuleSelect.value = initialNamingRuleId;
}

function selectedNamingRuleId() {
    return document.getElementById("routeNamingRuleSelect")?.value?.trim() || "";
}

function feedbackNamingRuleId() {
    return selectedNamingRuleId()
        || document.getElementById("routeNamingRuleFallback")?.value?.trim()
        || "";
}

function classCodeDisplay(code) {
    if (!code) return "";
    const entry = classCodeDirectory[code];
    return entry ? entry.display : code;
}

function normalizedPreferredFileNameValue(rawValue) {
    return String(rawValue || "")
        .replace(/\s*\n+\s*/g, " ")
        .replace(/\s{2,}/g, " ")
        .trim();
}

function autoResizeTextArea(element) {
    if (!element) {
        return;
    }
    element.style.height = "auto";
    element.style.height = `${Math.max(element.scrollHeight, 78)}px`;
}

function updateClassCodeHint(inputId, hintId) {
    const value = document.getElementById(inputId)?.value?.trim() || "";
    const hint = document.getElementById(hintId);
    if (!hint) return;
    if (!value) {
        hint.textContent = "";
        return;
    }
    const entry = classCodeDirectory[value];
    if (entry) {
        hint.textContent = entry.path
            ? `${entry.display} — ${entry.path}`
            : entry.display;
        return;
    }
    hint.textContent = "Code saisi manuellement. Aucun libellé trouvé dans le plan importé.";
}

function findClassCodeMatches(query) {
    const normalized = String(query || "").trim().toLowerCase();
    if (!normalized) {
        return classCodeEntries.slice(0, 12);
    }
    const exactCode = classCodeDirectory[query.trim()];
    const ranked = classCodeEntries
        .filter((entry) => entry.search.includes(normalized))
        .sort((left, right) => {
            const leftExact = left.code.toLowerCase() === normalized ? -2 : 0;
            const rightExact = right.code.toLowerCase() === normalized ? -2 : 0;
            const leftStarts = left.code.toLowerCase().startsWith(normalized) || left.label.toLowerCase().startsWith(normalized) ? -1 : 0;
            const rightStarts = right.code.toLowerCase().startsWith(normalized) || right.label.toLowerCase().startsWith(normalized) ? -1 : 0;
            const leftRank = leftExact + leftStarts;
            const rightRank = rightExact + rightStarts;
            if (leftRank !== rightRank) {
                return leftRank - rightRank;
            }
            return left.code.localeCompare(right.code, "fr", { numeric: true, sensitivity: "base" });
        })
        .slice(0, 16);
    if (exactCode && !ranked.some((entry) => entry.code === query.trim())) {
        ranked.unshift({
            code: query.trim(),
            label: exactCode.label || query.trim(),
            display: exactCode.display || query.trim(),
            path: exactCode.path || "",
            search: ""
        });
    }
    return ranked;
}

function hideClassCodePickers() {
    document.querySelectorAll(".class-picker-panel").forEach((panel) => {
        panel.hidden = true;
    });
}

function applyClassCodeSelection(inputId, panelId, hintId, code, refreshPreview = false) {
    const input = document.getElementById(inputId);
    const panel = document.getElementById(panelId);
    if (!input) {
        return;
    }
    input.value = code;
    if (panel) {
        panel.hidden = true;
    }
    updateClassCodeHint(inputId, hintId);
    if (refreshPreview) {
        refreshRoutePreview();
    }
}

function renderClassCodePicker(inputId, panelId, hintId, refreshPreview = false) {
    const input = document.getElementById(inputId);
    const panel = document.getElementById(panelId);
    if (!input || !panel) {
        return;
    }
    const matches = findClassCodeMatches(input.value);
    if (!matches.length) {
        panel.innerHTML = `<div class="class-picker-empty">Aucun code correspondant.</div>`;
        panel.hidden = false;
        return;
    }
    panel.innerHTML = matches.map((entry) => {
        const pathLine = entry.path ? `<small>${escapeHTML(entry.path)}</small>` : "";
        return `
            <button
                type="button"
                class="class-picker-option"
                data-code="${escapeHTML(entry.code)}"
                onmousedown="event.preventDefault()"
            >
                <strong>${escapeHTML(entry.code)} — ${escapeHTML(entry.label)}</strong>
                ${pathLine}
            </button>
        `;
    }).join("");
    panel.querySelectorAll(".class-picker-option").forEach((button) => {
        button.addEventListener("click", () => {
            applyClassCodeSelection(inputId, panelId, hintId, button.dataset.code || "", refreshPreview);
        });
    });
    panel.hidden = false;
}

function attachClassCodePicker(inputId, panelId, hintId, refreshPreview = false) {
    const input = document.getElementById(inputId);
    const panel = document.getElementById(panelId);
    if (!input || !panel) {
        return;
    }
    input.addEventListener("focus", () => renderClassCodePicker(inputId, panelId, hintId, refreshPreview));
    input.addEventListener("input", () => {
        updateClassCodeHint(inputId, hintId);
        renderClassCodePicker(inputId, panelId, hintId, refreshPreview);
    });
    input.addEventListener("blur", () => {
        window.setTimeout(() => {
            panel.hidden = true;
        }, 140);
    });
}

function setPreviewBoxState(payload) {
    const previewBox = document.getElementById("routePreviewBox");
    const previewEmpty = document.getElementById("routePreviewEmpty");
    const previewName = document.getElementById("routePreviewName");
    const previewSource = document.getElementById("routePreviewSource");
    const previewRule = document.getElementById("routePreviewRule");
    const previewFolder = document.getElementById("routePreviewFolder");
    const previewRanking = document.getElementById("routePreviewRanking");
    const previewRankingStatus = document.getElementById("routePreviewRankingStatus");
    const previewRankingBest = document.getElementById("routePreviewRankingBest");
    const previewRankingBody = document.getElementById("routePreviewRankingBody");
    if (!previewBox || !previewName || !previewSource) return;

    const hasFileName = Boolean(payload.file_name);
    previewBox.style.display = hasFileName ? "block" : "none";
    if (previewEmpty) {
        previewEmpty.style.display = hasFileName ? "none" : "block";
    }
    if (!hasFileName) {
        return;
    }
    previewName.textContent = payload.file_name;
    previewSource.textContent = `Source: ${payload.naming_source || "Aucune proposition automatique"}`;
    if (previewRule) {
        if (payload.naming_rule_id) {
            previewRule.style.display = "block";
            previewRule.textContent = `Règle utilisée: ${payload.naming_rule_id}`;
        } else {
            previewRule.style.display = "none";
        }
    }
    if (previewFolder) {
        if (payload.destination_folder) {
            previewFolder.style.display = "block";
            previewFolder.textContent = `Dossier cible: ${payload.destination_folder}`;
        } else {
            previewFolder.style.display = "none";
        }
    }
    if (previewRanking && previewRankingStatus && previewRankingBody) {
        const rows = Array.isArray(payload.ranking_rows) ? payload.ranking_rows : [];
        previewRankingStatus.textContent = `Ranking: ${payload.ranking_provider_status || "Aucun ranking disponible"}`;
        previewRankingBody.innerHTML = "";
        if (rows.length > 0) {
            previewRanking.style.display = "block";
            if (previewRankingBest) {
                const best = rows[0];
                const finalScore = Number(best.final_score || 0);
                let confidenceLabel = "Confiance faible";
                if (finalScore >= 0.8) {
                    confidenceLabel = "Confiance élevée";
                } else if (finalScore >= 0.55) {
                    confidenceLabel = "Confiance moyenne";
                }
                previewRankingBest.style.display = "block";
                previewRankingBest.innerHTML = `
                    <strong>Suggestion la plus probable : ${best.label}</strong>
                    <div class="preview-meta">
                        Règle <span class="mono">${best.rule_id}</span><br>
                        ${best.reasons || "Aucune explication disponible"}
                    </div>
                    <div class="preview-score-chip">${confidenceLabel}</div>
                `;
            }
            for (const row of rows) {
                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td><span class="mono">${row.rule_id}</span><br><strong>${row.label}</strong><br><span class="preview-meta">${row.sources}</span></td>
                    <td>${row.reasons || "-"}</td>
                    <td>${row.final_score}</td>
                    <td>${row.deterministic_score}</td>
                    <td>${row.ml_score}</td>
                `;
                previewRankingBody.appendChild(tr);
            }
        } else {
            previewRanking.style.display = "none";
            if (previewRankingBest) {
                previewRankingBest.style.display = "none";
            }
        }
    }
}

function markPreferredFileNameDirty() {
    const input = document.getElementById("routePreferredFileName");
    if (!input) return;
    input.value = normalizedPreferredFileNameValue(input.value);
    autoResizeTextArea(input);
    const current = input.value.trim();
    const initial = (input.dataset.initial || "").trim();
    input.dataset.dirtyManual = current && current !== initial ? "1" : "0";
}

function updatePreviewForManualFileName() {
    markPreferredFileNameDirty();
    const input = document.getElementById("routePreferredFileName");
    if (!input) return;
    const current = normalizedPreferredFileNameValue(input.value);
    if (!current) return;
    if (input.dataset.dirtyManual === "1") {
        setPreviewBoxState({
            file_name: current,
            destination_folder: document.getElementById("routePreviewFolder")?.textContent?.replace(/^Dossier cible:\s*/, "") || "",
            naming_rule_id: feedbackNamingRuleId() || null,
            naming_source: "Nom manuel"
        });
    }
}

async function refreshRoutePreview(forceFileName = false) {
    const output = document.getElementById("routeResult");
    const params = new URLSearchParams();
    const classCode = document.getElementById("routeClassCode")?.value?.trim() || "";
    const presetId = document.getElementById("routePresetId")?.value?.trim() || "";
    const namingRuleId = selectedNamingRuleId();
    const destinationFolder = document.getElementById("routeFolder")?.value?.trim() || "";
    const nameFormat = document.getElementById("routeNameFormat")?.value?.trim() || "";
    const exportType = document.getElementById("routeExportType")?.value?.trim() || "";

    if (classCode) params.set("class_code", classCode);
    if (presetId) params.set("preset_id", presetId);
    if (namingRuleId) params.set("naming_rule_id", namingRuleId);
    if (destinationFolder) params.set("destination_folder", destinationFolder);
    if (nameFormat) params.set("name_format", nameFormat);
    if (exportType) params.set("export_type", exportType);

    try {
        const response = await fetch(`/ui/jobs/${jobId}/route-preview?${params.toString()}`);
        if (!response.ok) {
            throw new Error(`Aperçu indisponible (${response.status})`);
        }
        const payload = await response.json();
        setPreviewBoxState(payload);
        const preferredInput = document.getElementById("routePreferredFileName");
        if (preferredInput && payload.file_name) {
            const manualDirty = preferredInput.dataset.dirtyManual === "1";
            if (forceFileName || !manualDirty) {
                preferredInput.value = payload.file_name;
                preferredInput.dataset.initial = payload.file_name;
                preferredInput.dataset.dirtyManual = "0";
                autoResizeTextArea(preferredInput);
            }
        }
        const fallbackRule = document.getElementById("routeNamingRuleFallback");
        if (fallbackRule && payload.naming_rule_id) {
            fallbackRule.value = payload.naming_rule_id;
        }
    } catch (error) {
        if (output) {
            output.value = error.message;
        }
    }
}

function switchReviewTab(tab) {
    const suggestionBtn = document.getElementById("tabSuggestionBtn");
    const manualBtn = document.getElementById("tabManualBtn");
    const suggestionPane = document.getElementById("tabSuggestion");
    const manualPane = document.getElementById("tabManual");
    if (!suggestionBtn || !manualBtn || !suggestionPane || !manualPane) return;

    const suggestionActive = tab === "suggestion";
    suggestionBtn.classList.toggle("active", suggestionActive);
    manualBtn.classList.toggle("active", !suggestionActive);
    suggestionPane.classList.toggle("active", suggestionActive);
    manualPane.classList.toggle("active", !suggestionActive);
}

function resolvedReviewedClassCode() {
    const selectedClass = document.getElementById("reviewClassSelect")?.value || "";
    const manualClass = document.getElementById("reviewClass")?.value || "";
    return manualClass.trim() || selectedClass.trim() || "";
}

function resolvedReviewedPreset() {
    const selectedPreset = document.getElementById("reviewPresetSelect")?.value || "";
    const manualPreset = document.getElementById("reviewPreset")?.value || "";
    return manualPreset.trim() || selectedPreset.trim() || "";
}

function syncRouteFieldsFromReview() {
    const routeClassInput = document.getElementById("routeClassCode");
    const routePresetInput = document.getElementById("routePresetId");
    if (routeClassInput) {
        routeClassInput.value = resolvedReviewedClassCode() || routeClassInput.value || "";
    }
    if (routePresetInput) {
        routePresetInput.value = resolvedReviewedPreset() || routePresetInput.value || "";
    }
    updateClassCodeHint("routeClassCode", "routeClassHint");
}

async function loadText() {
    const page = document.getElementById("textPage").value || "1";
    const area = document.getElementById("textArea");
    area.value = "Chargement du texte...";
    let res;
    try {
        res = await fetch(`/v1/preview/${jobId}/text?page=${encodeURIComponent(page)}`);
    } catch (error) {
        area.value = "Erreur réseau lors du chargement du texte.";
        return;
    }
    if (!res.ok) {
        area.value = `Erreur de chargement du texte (${res.status})`;
        return;
    }
    try {
        const json = await res.json();
        area.value = json.text || "Aucun texte d'aperçu disponible.";
    } catch (error) {
        area.value = "Réponse texte invalide.";
    }
}

window.addEventListener("DOMContentLoaded", () => {
    updateClassCodeHint("reviewClassSelect", "reviewClassHint");
    updateClassCodeHint("routeClassCode", "routeClassHint");
    autoResizeTextArea(document.getElementById("routePreferredFileName"));
    document.getElementById("routePreferredFileName")?.addEventListener("input", updatePreviewForManualFileName);
    document.getElementById("routeClassCode")?.addEventListener("change", () => {
        updateClassCodeHint("routeClassCode", "routeClassHint");
        refreshRoutePreview();
    });
    document.getElementById("routePresetId")?.addEventListener("change", () => refreshRoutePreview());
    document.getElementById("routeFolder")?.addEventListener("change", () => refreshRoutePreview());
    document.getElementById("routeNameFormat")?.addEventListener("change", () => refreshRoutePreview());
    document.getElementById("routeExportType")?.addEventListener("change", () => refreshRoutePreview());
    document.getElementById("routeNamingRuleSelect")?.addEventListener("change", () => refreshRoutePreview(true));
    attachClassCodePicker("reviewClassSelect", "reviewClassPicker", "reviewClassHint", false);
    attachClassCodePicker("routeClassCode", "routeClassPicker", "routeClassHint", true);
    document.addEventListener("click", (event) => {
        if (!event.target.closest(".class-picker")) {
            hideClassCodePickers();
        }
    });
    loadText();
});

async function submitReview(routeAfterReview = false) {
    const output = document.getElementById("routeResult");
    const resolvedClassCode = resolvedReviewedClassCode();
    const resolvedPresetId = resolvedReviewedPreset();
    const correctedTypeDoc = document.getElementById("reviewTypeDoc")?.value || null;
    const correctedSujets = document.getElementById("reviewSujets")?.value || null;
    const correctedDocumentNumber = document.getElementById("reviewDocumentNumber")?.value || null;
    const correctedDocumentObject = document.getElementById("reviewDocumentObject")?.value || null;
    const correctedDocumentDate = document.getElementById("reviewDocumentDate")?.value || null;
    const correctedDocumentIssuer = document.getElementById("reviewDocumentIssuer")?.value || null;

    const correctedFields = {};
    if (correctedTypeDoc && correctedTypeDoc.trim()) {
        correctedFields.type_doc = correctedTypeDoc.trim();
    }
    if (correctedSujets && correctedSujets.trim()) {
        correctedFields.sujets = correctedSujets.trim();
    }
    if (correctedDocumentNumber && correctedDocumentNumber.trim()) {
        correctedFields.numero_document = correctedDocumentNumber.trim();
    }
    if (correctedDocumentObject && correctedDocumentObject.trim()) {
        correctedFields.objet = correctedDocumentObject.trim();
    }
    if (correctedDocumentDate && correctedDocumentDate.trim()) {
        correctedFields.date_document = correctedDocumentDate.trim();
    }
    if (correctedDocumentIssuer && correctedDocumentIssuer.trim()) {
        correctedFields.organisme_emetteur = correctedDocumentIssuer.trim();
    }

    const payload = {
        corrected_class_code: resolvedClassCode || null,
        corrected_preset: resolvedPresetId || null,
        corrected_fields: Object.keys(correctedFields).length > 0 ? correctedFields : null,
        comment: document.getElementById("reviewComment").value || null
    };

    if (output) {
        output.value = routeAfterReview ? "Validation en cours avant routage..." : "Validation de la revue en cours...";
    }
    const res = await fetch(`/v1/jobs/${jobId}/review`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
    });
    if (res.ok) {
        if (routeAfterReview) {
            syncRouteFieldsFromReview();
            if (shouldLearnFilenameCorrection()) {
                try {
                    await submitNamingFeedback(true);
                } catch (error) {
                    if (output) {
                        output.value = `${error.message}\nLe routage va tout de même utiliser le nom saisi.`;
                    }
                }
            }
            try {
                await submitRouteRequest();
                window.location.reload();
                return;
            } catch (error) {
                if (output) {
                    output.value = error.message;
                }
                return;
            }
        }
        if (shouldLearnFilenameCorrection()) {
            try {
                await submitNamingFeedback(true);
            } catch (error) {
                if (output) {
                    output.value = `${error.message}\nLa revue est enregistrée, mais la correction de nommage n'a pas été mémorisée.`;
                }
            }
        }
        window.location.reload();
        return;
    }
    const msg = await res.text();
    if (output) {
        output.value = `Échec de la revue (${res.status}) : ${msg}`;
    }
    alert(`Échec de la revue (${res.status}) : ${msg}`);
}

function collectRoutePayload() {
    const classCode = document.getElementById("routeClassCode")?.value || "";
    const presetId = document.getElementById("routePresetId")?.value || "";
    const namingRuleId = document.getElementById("routeNamingRuleSelect")?.value || "";
    const destinationFolder = document.getElementById("routeFolder")?.value || "";
    const nameFormat = document.getElementById("routeNameFormat")?.value || "";
    const preferredFileName = normalizedPreferredFileNameValue(document.getElementById("routePreferredFileName")?.value || "");
    const exportType = document.getElementById("routeExportType")?.value || "";

    return {
        class_code: classCode.trim() || null,
        preset_id: presetId.trim() || null,
        naming_rule_id: namingRuleId.trim() || null,
        destination_folder: destinationFolder.trim() || null,
        name_format: nameFormat.trim() || null,
        preferred_file_name: preferredFileName.trim() || null,
        export_type: exportType.trim() || null,
        reroute_existing: Boolean("#(can_reroute)" === "true" && "#(routed_at)" !== "")
    };
}

function currentPreferredFileName() {
    return normalizedPreferredFileNameValue(document.getElementById("routePreferredFileName")?.value || "");
}

function shouldLearnFilenameCorrection() {
    const current = currentPreferredFileName();
    const initial = (document.getElementById("routePreferredFileName")?.dataset.initial || "").trim();
    const checkbox = document.getElementById("routeLearnCorrection");
    const autoLearnEnabled = checkbox ? checkbox.checked : true;
    return Boolean(autoLearnEnabled && current && current !== initial);
}

async function submitNamingFeedback(silent = false) {
    const output = document.getElementById("routeResult");
    const correctedFileName = currentPreferredFileName();
    const namingRuleId = feedbackNamingRuleId();

    if (!correctedFileName) {
        if (!silent) {
            alert("Aucune correction de nommage exploitable à mémoriser.");
        }
        return null;
    }

    if (output) {
        output.value = "Mémorisation de la correction de nommage...";
    }
    const res = await fetch("/v1/naming/feedback", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
            job_id: jobId,
            naming_rule_id: namingRuleId || null,
            corrected_file_name: correctedFileName,
            notes: document.getElementById("reviewComment")?.value || null
        })
    });
    if (!res.ok) {
        const msg = await res.text();
        if (!silent) {
            alert(`Échec de la mémorisation (${res.status}) : ${msg}`);
        }
        throw new Error(`Échec de la mémorisation (${res.status}) : ${msg}`);
    }

    const json = await res.json();
    const preferredInput = document.getElementById("routePreferredFileName");
    if (preferredInput) {
        preferredInput.dataset.initial = correctedFileName;
    }
    if (output && !silent) {
        output.value = `Correction mémorisée pour ${json.rule_id}.`;
    }
    return json;
}

async function submitRouteRequest() {
    const payload = collectRoutePayload();
    const res = await fetch(`/v1/route/${jobId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
    });
    if (!res.ok) {
        const msg = await res.text();
        throw new Error(`Échec du routage (${res.status}) : ${msg}`);
    }

    const json = await res.json();
    return json;
}

async function submitRoute() {
    const output = document.getElementById("routeResult");
    output.value = "Routage en cours...";
    try {
        if (shouldLearnFilenameCorrection()) {
            try {
                await submitNamingFeedback(true);
            } catch (error) {
                output.value = `${error.message}\nLe routage continue avec le nom corrigé.`;
            }
        }
        const json = await submitRouteRequest();
        const destination = json.destination_local_path || json.destination_url || json.resolved_folder || "N/D";
        const filename = json.resolved_file_name || "N/D";
        output.value = `Mode: ${json.mode}\nCode: ${json.class_code}\nFichier: ${filename}\nDestination: ${destination}`;
        setTimeout(() => window.location.reload(), 700);
    } catch (error) {
        output.value = error.message;
    }
}
</script>
</body>
</html>

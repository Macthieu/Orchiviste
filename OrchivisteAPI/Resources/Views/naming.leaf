<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Nommage</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --border: #d9d2c4;
            --warn: #ac5d0c;
        }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: "Avenir Next", "Helvetica Neue", sans-serif; color: var(--ink); background: var(--bg); }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap { max-width: 1300px; margin: 20px auto 40px; padding: 0 16px; }
        .grid { display: grid; grid-template-columns: 1fr; gap: 14px; align-items: start; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 14px;
            margin-bottom: 14px;
        }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 10px;
        }
        label { display: block; font-size: 13px; color: var(--muted); }
        input, textarea, select {
            margin-top: 4px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            font: inherit;
            background: #fff;
        }
        textarea { min-height: 220px; font-family: "SF Mono", Menlo, monospace; }
        .btn {
            margin-top: 10px;
            border: 1px solid var(--accent);
            color: #fff;
            background: var(--accent);
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn-secondary {
            border: 1px solid var(--border);
            background: #f6f1e9;
            color: var(--ink);
            border-radius: 8px;
            padding: 8px 10px;
            font-weight: 700;
            cursor: pointer;
        }
        .notice { margin: 0 0 10px; font-weight: 700; color: var(--accent); }
        .error { margin: 0 0 10px; font-weight: 700; color: var(--warn); }
        table {
            width: 100%;
            border-collapse: collapse;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 13px;
            vertical-align: top;
        }
        th { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .pill {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 999px;
            background: #edf4f1;
            color: var(--accent);
            font-weight: 700;
            font-size: 12px;
        }
        .pill-warn {
            background: #fff3e6;
            color: var(--warn);
        }
        .subgrid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 10px;
        }
        .stack {
            display: grid;
            gap: 10px;
        }
        .editor-toolbar {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin: 10px 0 4px;
        }
        .hint {
            margin: 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.45;
        }
        .code-box {
            background: #f7f3ec;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px;
        }
        details.advanced {
            margin-top: 12px;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px;
            background: #fbf8f2;
        }
        details.advanced summary {
            cursor: pointer;
            font-weight: 700;
        }
        ul.compact { margin: 8px 0 0; padding-left: 18px; }
        .mono { font-family: "SF Mono", Menlo, monospace; }
        @media (max-width: 980px) {
            .grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Nommage & Thésaurus</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/presets">Préréglages</a>
        <a href="/ui/naming">Nommage</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>
<main class="wrap">
    #if(notice):
    <p class="notice">#(notice)</p>
    #endif
    #if(error):
    <p class="error">#(error)</p>
    #endif
    #if(runtime_fallback_active):
    <p class="error">Aucun artefact de nommage valide n’a été chargé depuis les configs. Le runtime utilise actuellement le fallback minimal compilé.</p>
    #endif

    <section class="card">
        <h2>Secours de renommage hérité</h2>
        <p class="hint">Ce format sert uniquement de repli pour les anciens chemins de routage qui n’utilisent pas encore une règle déclarative. L’édition principale des règles de nommage reste juste en dessous.</p>
        <form action="/ui/naming/legacy-format" method="post">
            <label>Format de nom hérité par défaut
                <input type="text" name="default_name_format" value="#(legacy_default_name_format)" placeholder="{class_code}-{type_doc}-{sujet}-{date}-{numero}">
            </label>
            <button class="btn" type="submit">Enregistrer le format de secours</button>
        </form>
    </section>

    <section class="card">
        <h2>Apprentissage depuis dossier</h2>
        <form action="/ui/naming/rules/learn" method="post">
            <div class="form-grid">
                <label>Dossier source
                    <input type="text" name="folder_path" placeholder="/data/routed/resolutions" required>
                </label>
                <label>Taille échantillon
                    <input type="number" name="sample_size" min="1" max="200" value="30">
                </label>
                <label>Extensions (csv)
                    <input type="text" name="extensions" placeholder="pdf,doc,docx,xlsx,pptx,png,jpg,tiff">
                </label>
            </div>
            <button class="btn" type="submit">Apprendre un brouillon de règle</button>
        </form>
    </section>

    <section class="card">
        <h2>Tester le ranking des règles</h2>
        <p class="hint">Colle un extrait représentatif du document et, si possible, le nom du fichier source. Cette vue sert à vérifier quelle règle serait priorisée et si Core ML apporte un signal utile.</p>
        <form action="/ui/naming" method="get">
            <div class="form-grid">
                <label>Nom du fichier (optionnel)
                    <input type="text" name="ranking_file_name" value="#(ranking_preview_file_name)" placeholder="resolution-2023-436.pdf">
                </label>
                <label>Nombre d’échantillons
                    <input type="number" name="ranking_sample_count" min="1" max="50" value="#(ranking_preview_sample_count)">
                </label>
            </div>
            <label>Texte de test
                <textarea name="ranking_text" style="min-height:140px;" spellcheck="false">#(ranking_preview_text)</textarea>
            </label>
            <div class="editor-toolbar">
                <button class="btn" type="submit">Calculer le ranking</button>
                <a class="btn-secondary" href="/ui/naming">Réinitialiser</a>
            </div>
        </form>
        <p class="hint" style="margin-top: 8px;">Statut du calcul : <strong>#(ranking_preview_provider_status)</strong></p>
        #if(ranking_preview_has_results):
        <table style="margin-top: 14px;">
            <thead>
            <tr><th>Règle</th><th>Famille</th><th>Score final</th><th>Déterministe</th><th>Core ML</th><th>Sources</th><th>Raisons</th></tr>
            </thead>
            <tbody>
            #for(row in ranking_preview_rows):
            <tr>
                <td class="mono">#(row.rule_id)<br><strong>#(row.label)</strong></td>
                <td>#(row.document_family)</td>
                <td><strong>#(row.final_score)</strong></td>
                <td>#(row.deterministic_score)</td>
                <td>#(row.ml_score)</td>
                <td>#(row.sources)</td>
                <td>#(row.reasons)</td>
            </tr>
            #endfor
            </tbody>
        </table>
        #endif
    </section>

    <div class="grid">
        <section class="card">
            <h2>Règles déclaratives</h2>
            <p style="margin:0 0 10px; color: var(--muted);">
                Runtime sélectionné :
                <span class="pill">#(selected_rule_status)</span>
                <span class="pill">#(selected_rule_source)</span>
                #if(selected_rule_is_fallback):
                <span class="pill pill-warn">fallback</span>
                #endif
                <br>
                Chargé depuis : <span class="mono">#(selected_rule_loaded_from)</span>
            </p>
            <form action="/ui/naming/rules/save" method="post">
                <div class="stack">
                    <div class="subgrid">
                        <label>ID règle
                            <input id="ruleId" type="text" placeholder="rule_resolution_conseil_municipal">
                        </label>
                        <label>Libellé
                            <input id="ruleLabel" type="text" placeholder="Résolution du conseil municipal">
                        </label>
                        <label>Version
                            <input id="ruleVersion" type="text" placeholder="1.0.0">
                        </label>
                        <label>Famille documentaire
                            <input id="ruleFamily" type="text" placeholder="resolution_conseil">
                        </label>
                    </div>

                    <div class="subgrid">
                        <label>Template final
                            <input id="ruleTemplate" type="text" placeholder="Résolution NO {numero} – {titre} – {date}.pdf">
                        </label>
                        <label>Code de classement suggéré
                            <input id="ruleClassCode" type="text" placeholder="ADM-RES">
                        </label>
                        <label>Libellé de sortie canonique
                            <input id="ruleCanonicalLabel" type="text" placeholder="Résolution">
                        </label>
                    </div>

                    <div class="code-box">
                        <strong>Paramètres de rendu</strong>
                        <p class="hint">Utilise cette section pour régler la source du titre, la casse finale, les acronymes conservés et le budget de longueur.</p>
                        <div class="subgrid" style="margin-top: 10px;">
                            <label>Source du titre
                                <select id="ruleTitleSource">
                                    <option value="">Détection standard</option>
                                    <option value="first_underlined_uppercase_line">Premier bloc souligné en majuscules</option>
                                    <option value="first_uppercase_line_after_resolution">Première ligne en majuscules après la résolution</option>
                                </select>
                            </label>
                            <label>Casse du titre
                                <select id="ruleTitleCase">
                                    <option value="">Détection standard</option>
                                    <option value="sentence_case">Casse phrase</option>
                                    <option value="preserve">Préserver tel quel</option>
                                </select>
                            </label>
                            <label>Taille max du titre
                                <input id="ruleTitleMaxLength" type="number" min="24" max="220" placeholder="120">
                            </label>
                            <label>Budget nom SharePoint
                                <input id="ruleSharePointLength" type="number" min="48" max="255" placeholder="140">
                            </label>
                        </div>
                        <label style="margin-top: 10px;">Acronymes conservés (csv)
                            <input id="rulePreserveAcronyms" type="text" placeholder="CN, MTQ, SAAQ, MRC">
                        </label>
                        <label style="margin-top: 10px;">Regex du nom final (optionnel)
                            <input id="ruleFilenameRegex" type="text" placeholder="^Résolution NO\\s20\\d{2}-\\d{1,3}\\s–\\s.+\\s–\\s20\\d{2}-\\d{2}-\\d{2}\\.pdf$">
                        </label>
                    </div>

                    <div class="subgrid">
                        <label>Signaux de détection (csv)
                            <textarea id="ruleSignals" rows="4" style="min-height:96px;"></textarea>
                        </label>
                        <label>Regex de détection (1 par ligne)
                            <textarea id="ruleRegexes" rows="4" style="min-height:96px;"></textarea>
                        </label>
                        <label>Familles source (csv)
                            <textarea id="ruleSourceFamilies" rows="4" style="min-height:96px;"></textarea>
                        </label>
                    </div>

                    <div class="subgrid">
                        <label>Normalisations (csv)
                            <textarea id="ruleNormalizations" rows="4" style="min-height:96px;"></textarea>
                        </label>
                        <label>Termes interdits (csv)
                            <textarea id="ruleForbiddenTerms" rows="4" style="min-height:96px;"></textarea>
                        </label>
                    </div>

                    <label>Champs de la règle
                        <textarea id="ruleFields" rows="10" style="min-height:180px;" spellcheck="false"></textarea>
                    </label>
                    <p class="hint">Format : <span class="mono">key|label|required|kind|pattern|semantic_hint|stopwords csv|preserve_terms csv</span>. Une ligne par stratégie.</p>

                    <label>Validations
                        <textarea id="ruleValidations" rows="6" style="min-height:120px;" spellcheck="false"></textarea>
                    </label>
                    <p class="hint">Format : <span class="mono">kind|parameter|message</span>. Une ligne par validation.</p>
                </div>

                <div class="editor-toolbar">
                    <button class="btn-secondary" type="button" onclick="namingResetGuidedEditor()">Recharger la règle sélectionnée</button>
                    <button class="btn-secondary" type="button" onclick="namingBuildRuleJSON()">Mettre à jour le JSON</button>
                    <button class="btn" type="submit" onclick="return namingPrepareRuleSubmit()">Enregistrer la règle</button>
                </div>

                <details class="advanced">
                    <summary>JSON avancé</summary>
                    <p class="hint">Le JSON reste disponible pour les cas avancés. L'éditeur guidé ci-dessus remplit automatiquement ce bloc.</p>
                    <label>JSON de la règle
                        <textarea id="ruleJson" name="rule_json" spellcheck="false">#(selected_rule_json)</textarea>
                    </label>
                </details>
            </form>
            <table style="margin-top: 14px;">
                <thead>
                <tr><th>ID</th><th>Famille</th><th>Version / statut</th><th>Template</th><th>Code</th><th>Chargement</th></tr>
                </thead>
                <tbody>
                #for(rule in rules):
                <tr>
                    <td><a class="mono" href="/ui/naming?rule_id=#(rule.id)">#(rule.id)</a></td>
                    <td>#(rule.document_family)<br><strong>#(rule.label)</strong></td>
                    <td>
                        <span class="mono">#(rule.version)</span><br>
                        <span class="pill">#(rule.status)</span>
                        <span class="pill">#(rule.source)</span>
                        #if(rule.is_fallback):
                        <br><span class="pill pill-warn">fallback</span>
                        #endif
                    </td>
                    <td class="mono">#(rule.template)</td>
                    <td>#(rule.class_code)</td>
                    <td class="mono">#(rule.loaded_from)</td>
                </tr>
                #endfor
                </tbody>
            </table>

            #if(selected_rule_feedback_present):
            <h3 style="margin-top:14px;">Corrections mémorisées</h3>
            <table>
                <thead>
                <tr><th>Date</th><th>Source</th><th>Nom corrigé</th><th>Notes</th></tr>
                </thead>
                <tbody>
                #for(example in selected_rule_feedback_examples):
                <tr>
                    <td>#(example.created_at)</td>
                    <td class="mono">#(example.source_filename)</td>
                    <td class="mono">#(example.corrected_filename)</td>
                    <td>#(example.notes)</td>
                </tr>
                #endfor
                </tbody>
            </table>
            #endif
            <h3 style="margin-top:14px;">Brouillons de règles</h3>
            <table>
                <thead>
                <tr><th>Draft</th><th>Source</th><th>Confiance</th><th>Action</th></tr>
                </thead>
                <tbody>
                #for(draft in rule_drafts):
                <tr>
                    <td><a class="mono" href="/ui/naming?rule_draft_id=#(draft.draft_id)">#(draft.draft_id)</a><br>#(draft.created_at)</td>
                    <td class="mono">#(draft.source_folder)<br>Règle : #(draft.proposed_rule_id)</td>
                    <td>#(draft.confidence) #if(draft.needs_review):<br><span class="pill">needs_review</span>#endif</td>
                    <td>
                        <form action="/ui/naming/rule-drafts/#(draft.draft_id)/apply" method="post">
                            <button class="btn-secondary" type="submit">Appliquer</button>
                        </form>
                    </td>
                </tr>
                #endfor
                </tbody>
            </table>
        </section>

        <section class="card">
            <h2>Thésaurus</h2>
            <p style="margin:0 0 10px; color: var(--muted);">
                Runtime sélectionné :
                <span class="pill">#(selected_thesaurus_status)</span>
                <span class="pill">#(selected_thesaurus_source)</span>
                #if(selected_thesaurus_is_fallback):
                <span class="pill pill-warn">fallback</span>
                #endif
                <br>
                Chargé depuis : <span class="mono">#(selected_thesaurus_loaded_from)</span>
            </p>
            <form action="/ui/naming/thesaurus/save" method="post">
                <label>JSON du thésaurus
                    <textarea name="thesaurus_json" spellcheck="false">#(selected_thesaurus_json)</textarea>
                </label>
                <button class="btn" type="submit">Enregistrer le thésaurus</button>
            </form>
            <table style="margin-top: 14px;">
                <thead>
                <tr><th>ID</th><th>Version / statut</th><th>Description</th><th>Entrées</th><th>Chargement</th></tr>
                </thead>
                <tbody>
                #for(thesaurus in thesauri):
                <tr>
                    <td><a class="mono" href="/ui/naming?thesaurus_id=#(thesaurus.id)">#(thesaurus.id)</a></td>
                    <td>
                        <span class="mono">#(thesaurus.version)</span><br>
                        <span class="pill">#(thesaurus.status)</span>
                        <span class="pill">#(thesaurus.source)</span>
                        #if(thesaurus.is_fallback):
                        <br><span class="pill pill-warn">fallback</span>
                        #endif
                    </td>
                    <td>#(thesaurus.description)</td>
                    <td>#(thesaurus.entries)</td>
                    <td class="mono">#(thesaurus.loaded_from)</td>
                </tr>
                #endfor
                </tbody>
            </table>
        </section>
    </div>

    <section class="card">
        <h2>Importer un thésaurus externe</h2>
        <form action="/ui/naming/thesaurus/import-preview" method="post">
            <div class="form-grid">
                <label>Nom source
                    <input type="text" name="source_name" placeholder="thesaurus-gouvernemental.yaml">
                </label>
                <label>Format
                    <select name="format">
                        <option value="json">JSON</option>
                        <option value="yaml">YAML</option>
                    </select>
                </label>
                <label>Stratégie
                    <select name="strategy">
                        <option value="draft">draft</option>
                        <option value="merge">merge</option>
                        <option value="replace">replace</option>
                    </select>
                </label>
                <label>Thésaurus cible
                    <input type="text" name="target_thesaurus_id" value="#(selected_thesaurus_id)" placeholder="municipal-fr">
                </label>
            </div>
            <label>Contenu à importer
                <textarea name="raw_text" spellcheck="false"></textarea>
            </label>
            <button class="btn" type="submit">Prévisualiser l'import</button>
        </form>
    </section>

    <section class="card">
        <h2>Brouillons d'import de thésaurus</h2>
        <table>
            <thead>
            <tr><th>Draft</th><th>Source</th><th>Fusion</th><th>Action</th></tr>
            </thead>
            <tbody>
            #for(draft in thesaurus_drafts):
            <tr>
                <td><a class="mono" href="/ui/naming?thesaurus_draft_id=#(draft.draft_id)">#(draft.draft_id)</a><br>#(draft.created_at)</td>
                <td>#(draft.source_name)<br>Format: #(draft.format)</td>
                <td>Stratégie: #(draft.strategy)<br>Cible: <span class="mono">#(draft.target_thesaurus_id)</span><br>Conflits: #(draft.conflicts)</td>
                <td>
                    <form action="/ui/naming/thesaurus-drafts/#(draft.draft_id)/confirm" method="post">
                        <input type="hidden" name="strategy" value="#(draft.strategy)">
                        <input type="hidden" name="target_thesaurus_id" value="#(draft.target_thesaurus_id)">
                        <button class="btn-secondary" type="submit">Confirmer</button>
                    </form>
                </td>
            </tr>
            #endfor
            </tbody>
        </table>

        #if(selected_thesaurus_draft_id):
        <div style="margin-top: 14px;">
            <h3>Prévisualisation brouillon #(selected_thesaurus_draft_id)</h3>
            #if(draft_has_conflicts):
            <p class="error">Des conflits ont été détectés.</p>
            <table>
                <thead>
                <tr><th>Type</th><th>Alias</th><th>Existant</th><th>Entrant</th><th>Détail</th></tr>
                </thead>
                <tbody>
                #for(conflict in draft_conflicts):
                <tr>
                    <td>#(conflict.kind)</td>
                    <td>#(conflict.alias)</td>
                    <td>#(conflict.existing_canonical)</td>
                    <td>#(conflict.incoming_canonical)</td>
                    <td>#(conflict.message)</td>
                </tr>
                #endfor
                </tbody>
            </table>
            #endif
            #if(draft_has_warnings):
            <ul class="compact">
                #for(warning in draft_warnings):
                <li>#(warning)</li>
                #endfor
            </ul>
            #endif
        </div>
        #endif
    </section>
</main>
<script>
function namingCSV(values) {
    return (values || []).join(", ");
}

function namingLines(values) {
    return (values || []).join("\n");
}

function namingParseCSV(value) {
    return (value || "")
        .split(/[,;\n]/)
        .map((item) => item.trim())
        .filter((item) => item.length > 0);
}

function namingRuleFromJSON() {
    const textarea = document.getElementById("ruleJson");
    if (!textarea) return null;
    try {
        return JSON.parse(textarea.value);
    } catch (error) {
        return null;
    }
}

function namingPopulateGuidedEditor(rule) {
    if (!rule) return;
    const metadata = rule.metadata || {};
    const rendering = metadata.rendering || {};
    document.getElementById("ruleId").value = rule.id || "";
    document.getElementById("ruleLabel").value = rule.label || "";
    document.getElementById("ruleVersion").value = rule.version || "";
    document.getElementById("ruleFamily").value = rule.document_family || "";
    document.getElementById("ruleTemplate").value = rule.template || "";
    document.getElementById("ruleClassCode").value = metadata.suggested_class_code || "";
    document.getElementById("ruleCanonicalLabel").value = metadata.canonical_output_label || "";
    document.getElementById("ruleTitleSource").value = rendering.title_source || "";
    document.getElementById("ruleTitleCase").value = rendering.title_case || "";
    document.getElementById("ruleTitleMaxLength").value = rendering.title_max_length || "";
    document.getElementById("ruleSharePointLength").value = rendering.sharepoint_safe_filename_length || "";
    document.getElementById("rulePreserveAcronyms").value = namingCSV(rendering.preserve_acronyms);
    document.getElementById("ruleSignals").value = namingCSV(rule.conditions && rule.conditions.signals_any);
    document.getElementById("ruleRegexes").value = namingLines(rule.conditions && rule.conditions.regex_any);
    document.getElementById("ruleSourceFamilies").value = namingCSV(rule.conditions && rule.conditions.source_document_families);
    document.getElementById("ruleNormalizations").value = namingCSV(rule.normalization);
    document.getElementById("ruleForbiddenTerms").value = namingCSV(rule.forbidden_terms);

    const fieldLines = [];
    (rule.fields || []).forEach((field) => {
        (field.strategies || []).forEach((strategy) => {
            fieldLines.push([
                field.key || "",
                field.label || "",
                field.required ? "true" : "false",
                strategy.kind || "",
                strategy.pattern || "",
                strategy.semantic_hint || "",
                namingCSV(strategy.stopwords),
                namingCSV(strategy.preserve_terms)
            ].join("|"));
        });
    });
    document.getElementById("ruleFields").value = fieldLines.join("\n");

    const validationLines = (rule.validations || [])
        .filter((validation) => validation.kind !== "matches_regex")
        .map((validation) => {
        return [
            validation.kind || "",
            validation.parameter || "",
            validation.message || ""
        ].join("|");
    });
    document.getElementById("ruleValidations").value = validationLines.join("\n");

    const regexValidation = (rule.validations || []).find((validation) => validation.kind === "matches_regex");
    document.getElementById("ruleFilenameRegex").value = regexValidation?.parameter || "";
}

function namingGroupedFields() {
    const lines = (document.getElementById("ruleFields").value || "")
        .split("\n")
        .map((line) => line.trim())
        .filter((line) => line.length > 0);

    const fields = [];
    const indexByKey = new Map();

    for (const line of lines) {
        const parts = line.split("|");
        const key = (parts[0] || "").trim();
        if (!key) continue;
        const label = (parts[1] || key).trim();
        const required = ((parts[2] || "").trim().toLowerCase() === "true");
        const strategy = {
            kind: (parts[3] || "semantic").trim() || "semantic"
        };
        const pattern = (parts[4] || "").trim();
        const semanticHint = (parts[5] || "").trim();
        const stopwords = namingParseCSV(parts[6] || "");
        const preserveTerms = namingParseCSV(parts[7] || "");
        if (pattern) strategy.pattern = pattern;
        if (semanticHint) strategy.semantic_hint = semanticHint;
        if (stopwords.length > 0) strategy.stopwords = stopwords;
        if (preserveTerms.length > 0) strategy.preserve_terms = preserveTerms;

        if (!indexByKey.has(key)) {
            indexByKey.set(key, fields.length);
            fields.push({
                key,
                label,
                required,
                strategies: [strategy]
            });
        } else {
            fields[indexByKey.get(key)].strategies.push(strategy);
        }
    }
    return fields;
}

function namingValidations() {
    return (document.getElementById("ruleValidations").value || "")
        .split("\n")
        .map((line) => line.trim())
        .filter((line) => line.length > 0)
        .map((line) => {
            const parts = line.split("|");
            const validation = {
                kind: (parts[0] || "").trim()
            };
            const parameter = (parts[1] || "").trim();
            const message = (parts[2] || "").trim();
            if (parameter) validation.parameter = parameter;
            if (message) validation.message = message;
            return validation;
        })
        .filter((validation) => validation.kind);
}

function namingBuildRuleObject() {
    const existing = namingRuleFromJSON() || {};
    const metadata = Object.assign({}, existing.metadata || {});
    const rendering = {
        title_source: document.getElementById("ruleTitleSource").value.trim() || null,
        title_case: document.getElementById("ruleTitleCase").value.trim() || null,
        preserve_acronyms: namingParseCSV(document.getElementById("rulePreserveAcronyms").value),
        title_max_length: Number(document.getElementById("ruleTitleMaxLength").value || 0) || null,
        sharepoint_safe_filename_length: Number(document.getElementById("ruleSharePointLength").value || 0) || null
    };
    const validations = namingValidations().filter((validation) => validation.kind !== "matches_regex");
    const filenameRegex = document.getElementById("ruleFilenameRegex").value.trim();
    if (filenameRegex) {
        validations.unshift({
            kind: "matches_regex",
            parameter: filenameRegex,
            message: "Le nom final doit respecter le format attendu."
        });
    }

    metadata.suggested_class_code = document.getElementById("ruleClassCode").value.trim() || null;
    metadata.canonical_output_label = document.getElementById("ruleCanonicalLabel").value.trim() || null;
    metadata.rendering = Object.values(rendering).some((value) => Array.isArray(value) ? value.length > 0 : Boolean(value))
        ? rendering
        : null;

    return {
        ...existing,
        id: document.getElementById("ruleId").value.trim(),
        label: document.getElementById("ruleLabel").value.trim(),
        version: document.getElementById("ruleVersion").value.trim() || "1.0.0",
        document_family: document.getElementById("ruleFamily").value.trim(),
        template: document.getElementById("ruleTemplate").value.trim(),
        conditions: {
            signals_any: namingParseCSV(document.getElementById("ruleSignals").value),
            regex_any: (document.getElementById("ruleRegexes").value || "")
                .split("\n")
                .map((line) => line.trim())
                .filter((line) => line.length > 0),
            source_document_families: namingParseCSV(document.getElementById("ruleSourceFamilies").value)
        },
        fields: namingGroupedFields(),
        normalization: namingParseCSV(document.getElementById("ruleNormalizations").value),
        forbidden_terms: namingParseCSV(document.getElementById("ruleForbiddenTerms").value),
        validations,
        metadata
    };
}

function namingBuildRuleJSON() {
    const rule = namingBuildRuleObject();
    document.getElementById("ruleJson").value = JSON.stringify(rule, null, 2);
}

function namingPrepareRuleSubmit() {
    namingBuildRuleJSON();
    return true;
}

function namingResetGuidedEditor() {
    const rule = namingRuleFromJSON();
    if (!rule) {
        alert("Le JSON actuel n'est pas valide.");
        return;
    }
    namingPopulateGuidedEditor(rule);
}

window.addEventListener("DOMContentLoaded", () => {
    namingResetGuidedEditor();
});
</script>
</body>
</html>

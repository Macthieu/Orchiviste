<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste MuniConversion - Employé</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --danger: #9b3a16;
            --border: #d9d2c4;
            --ok-bg: #ebf8f4;
            --warn-bg: #fff2df;
            --danger-bg: #fbe4de;
            --info-bg: #eef4f6;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Avenir Next", "Helvetica Neue", sans-serif;
            color: var(--ink);
            background: linear-gradient(150deg, #f9f5ee 0%, #f2ece2 100%);
        }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap {
            max-width: 1240px;
            margin: 20px auto 40px;
            padding: 0 16px;
        }
        .subnav {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }
        .subnav a {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 7px 11px;
            text-decoration: none;
            color: var(--ink);
            background: #fff;
            font-weight: 700;
            font-size: 13px;
        }
        .subnav a.active {
            background: #ebf8f4;
            color: var(--accent);
            border-color: #bde2d7;
        }
        .hero, .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 14px;
        }
        .hero-top {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: flex-start;
            flex-wrap: wrap;
        }
        h1, h2, h3, p {
            margin-top: 0;
        }
        .hero h1 {
            margin-bottom: 8px;
        }
        .hero .lead {
            color: var(--muted);
            line-height: 1.45;
            max-width: 760px;
        }
        .pill {
            display: inline-block;
            border-radius: 999px;
            padding: 4px 9px;
            font-size: 11px;
            font-weight: 700;
            border: 1px solid var(--border);
            background: #fff;
        }
        .pill-ok {
            background: var(--ok-bg);
            color: var(--accent);
        }
        .pill-warn {
            background: var(--warn-bg);
            color: #8d4e06;
        }
        .actions {
            margin-top: 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .actions a, button {
            border-radius: 999px;
            padding: 10px 14px;
            font-weight: 700;
            font-size: 13px;
            text-decoration: none;
            border: 1px solid var(--accent);
            cursor: pointer;
        }
        .actions .primary, .btn-primary {
            background: var(--accent);
            color: #fff;
        }
        .actions .secondary, .btn-secondary {
            background: #fff;
            color: var(--accent);
        }
        .btn-warning {
            background: #fff6e7;
            color: #8d4e06;
            border-color: #dfc59f;
        }
        .grid {
            display: grid;
            gap: 14px;
            grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
        }
        .form-grid {
            display: grid;
            gap: 12px;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        }
        label {
            display: block;
            font-size: 13px;
            color: var(--muted);
            font-weight: 600;
        }
        input[type="text"], select {
            margin-top: 6px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px;
            font: inherit;
            background: #fff;
            color: var(--ink);
        }
        #extend("components/muni_path_picker_styles")
        .checkboxes {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin: 10px 0 2px;
        }
        .checkboxes label {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--ink);
            font-weight: 500;
        }
        .checkboxes input {
            width: auto;
            margin: 0;
        }
        .hint {
            margin: 8px 0 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.4;
        }
        .notice {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--accent);
        }
        .error {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--danger);
        }
        .status {
            display: inline-block;
            border-radius: 999px;
            padding: 3px 9px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .status-success { background: var(--ok-bg); color: var(--accent); }
        .status-warning { background: var(--warn-bg); color: #8d4e06; }
        .status-danger { background: var(--danger-bg); color: #8b2b14; }
        .status-info { background: var(--info-bg); color: #47606a; }
        .diag {
            display: inline-block;
            border-radius: 999px;
            padding: 3px 9px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .diag-info { background: var(--info-bg); color: #47606a; }
        .diag-warning { background: var(--warn-bg); color: #8d4e06; }
        .diag-blocking { background: var(--danger-bg); color: #8b2b14; }
        .meta-grid {
            display: grid;
            gap: 10px;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            margin-top: 12px;
        }
        .meta-box {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 10px;
            background: #fff;
        }
        .meta-box strong {
            display: block;
            font-size: 19px;
            margin-bottom: 4px;
        }
        .meta-box span {
            color: var(--muted);
            font-size: 12px;
        }
        .result-links, .recent-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin: 10px 0;
        }
        .result-links a, .recent-actions a {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 7px 10px;
            color: var(--accent);
            background: #fff;
            text-decoration: none;
            font-weight: 700;
            font-size: 12px;
        }
        .result-subsection {
            margin-top: 14px;
            padding-top: 12px;
            border-top: 1px solid var(--border);
        }
        .result-subsection h3 {
            margin-bottom: 8px;
            font-size: 15px;
        }
        .file-list, .event-list, .error-list {
            display: grid;
            gap: 6px;
            margin: 8px 0 0;
            padding: 0;
            list-style: none;
        }
        .file-list li, .event-item, .error-list li {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            background: #fff;
        }
        .event-item p, .error-list p {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.35;
        }
        .mono {
            font-family: "SF Mono", Menlo, monospace;
            font-size: 12px;
            line-height: 1.4;
        }
        .result-head, .recent-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            flex-wrap: wrap;
        }
        .recent-list {
            display: grid;
            gap: 10px;
        }
        .recent-item {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 10px;
            background: #fff;
        }
        .recent-item a {
            color: inherit;
            text-decoration: none;
        }
        .recent-actions a {
            color: var(--accent);
        }
        .recent-top {
            margin-bottom: 6px;
        }
        .recent-item .summary {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.4;
            margin: 0;
        }
        @media (max-width: 920px) {
            .grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Pilotage Muni</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/regles">Règles documentaires</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>

<main class="wrap">
    <nav class="subnav">
        <a href="#(back_to_catalog_url)">Catalogue</a>
        <a class="active" href="/ui/muni/apps/MuniConversion/employe">MuniConversion employé</a>
        <a href="#(technical_app_url)">Fiche technique</a>
        <a href="#(expert_launch_url)">Pilotage expert</a>
    </nav>

    #if(notice):
    <p class="notice">#(notice)</p>
    #endif
    #if(error):
    <p class="error">#(error)</p>
    #endif

    <section class="hero">
        <div class="hero-top">
            <div>
                <h1>MuniConversion</h1>
                <p class="lead">Façade employé minimale pour analyser puis convertir un lot documentaire avec les profils MuniConversion existants, sans exposer le JSON canonique.</p>
            </div>
            <span class="pill #(availability_class)">#(availability_label)</span>
        </div>
        <p class="hint" style="margin-top:10px;">#(availability_reason)</p>
        <div class="actions">
            <a class="primary" href="#(expert_launch_url)">Ouvrir le pilotage expert</a>
            <a class="secondary" href="#(technical_app_url)">Voir la fiche technique</a>
        </div>
    </section>

    <section class="grid">
        <div>
            <section class="card">
                <h2>Convertir un dossier</h2>
                <p class="hint">L’analyse est toujours non destructive. La conversion réelle requiert que la simulation soit désactivée.</p>

                <form action="/ui/muni/apps/MuniConversion/employe/run" method="post">
                    <div class="source-destination-picker">
                        #extend("components/muni_path_picker"):
                            #export("picker_label", "Dossier source")
                            #export("picker_input_id", "muniConversionSourceDirectory")
                            #export("picker_name", "source_directory")
                            #export("picker_value", source_directory)
                            #export("picker_placeholder", "/Volumes/.../a_convertir")
                            #export("picker_file_input_id", "muniConversionSourceLocalPicker")
                            #export("picker_hint_id", "muniConversionSourceHint")
                            #export("picker_mode_input_id", "muniConversionSourceMode")
                            #export("picker_mode_name", "source_directory_mode")
                            #export("picker_mode", "server")
                            #export("picker_required_attr", "required")
                            #export("picker_hint", "Choisir sélectionne un dossier local; Serveur parcourt les dossiers accessibles à Orchiviste.")
                        #endextend
                        #extend("components/muni_path_picker"):
                            #export("picker_label", "Dossier destination")
                            #export("picker_input_id", "muniConversionDestinationDirectory")
                            #export("picker_name", "destination_directory")
                            #export("picker_value", destination_directory)
                            #export("picker_placeholder", "/Volumes/.../convertis")
                            #export("picker_file_input_id", "muniConversionDestinationLocalPicker")
                            #export("picker_hint_id", "muniConversionDestinationHint")
                            #export("picker_mode_input_id", "muniConversionDestinationMode")
                            #export("picker_mode_name", "destination_directory_mode")
                            #export("picker_mode", "server")
                            #export("picker_required_attr", "")
                            #export("picker_hint", "Optionnel: activez la destination distincte pour écrire les fichiers convertis ailleurs.")
                        #endextend
                    </div>

                    <div class="checkboxes">
                        <label><input id="muniConversionUseDestination" type="checkbox" name="use_separate_destination" #(use_separate_destination_checked_attr) onchange="syncMuniConversionDestinationRequired()"> Destination distincte</label>
                        <label><input type="checkbox" name="include_subdirectories" #(include_subdirectories_checked_attr)> Inclure les sous-dossiers</label>
                        <label><input type="checkbox" name="dry_run" #(dry_run_checked_attr)> Simulation seulement</label>
                    </div>

                    <div class="form-grid" style="margin-top:12px;">
                        <label>
                            Profil de conversion
                            <select name="profile_id">
                                #for(profile in profiles):
                                <option value="#(profile.id)" #(profile.selected_attr)>#(profile.label)</option>
                                #endfor
                            </select>
                        </label>
                        <label>
                            Collision
                            <select name="collision_policy">
                                #for(option in collision_options):
                                <option value="#(option.id)" #(option.selected_attr)>#(option.label)</option>
                                #endfor
                            </select>
                        </label>
                    </div>

                    <div class="actions">
                        <button class="btn-primary" type="submit" name="operation" value="analyze">Analyser</button>
                        <button class="btn-warning" type="submit" name="operation" value="convert">Lancer la conversion</button>
                    </div>
                </form>
            </section>

            <section class="card">
                <h2>Dernier résultat sélectionné</h2>
                #if(result_present):
                <div class="result-head">
                    <div>
                        <p style="margin-bottom:6px;"><strong>#(result_action_label)</strong></p>
                        <p class="mono" style="margin-bottom:8px;">#(result_execution_id)</p>
                    </div>
                    <span class="status #(result_status_class)">#(result_status_label)</span>
                </div>
                <p>#(result_summary)</p>
                <p class="hint">Terminé: <span class="mono">#(result_finished_at)</span></p>
                <p class="hint">Source: <span class="mono">#(result_source_path)</span></p>
                <p class="hint">Sortie: <span class="mono">#(result_output_root_path)</span></p>
                <p class="hint">Profil: <span class="mono">#(result_profile_id)</span></p>
                <p class="hint">Résultat canonique: <span class="mono">#(result_result_file_path)</span></p>

                <div class="result-links">
                    <a href="#(result_result_file_url)" target="_blank" rel="noopener">Ouvrir le résultat JSON</a>
                    #if(result_output_folder_link_present):
                    <a href="#(result_output_folder_url)" target="_blank" rel="noopener">Lister le dossier de sortie</a>
                    #endif
                </div>

                <section class="result-subsection">
                    <h3>Où retrouver la sortie</h3>
                    <p class="hint">#(result_output_folder_status)</p>
                    <p class="hint">Contenu visible: <strong>#(result_output_file_count)</strong></p>
                    #if(result_output_files_present):
                    <ul class="file-list">
                        #for(file_name in result_output_file_names):
                        <li class="mono">#(file_name)</li>
                        #endfor
                    </ul>
                    #endif
                </section>

                <section class="result-subsection">
                    <h3>Diagnostics</h3>
                #if(result_diagnostic_present):
                    <p style="margin:0 0 6px;"><span class="diag #(result_diagnostic_severity_class)">#(result_diagnostic_severity_label)</span></p>
                    <p style="margin-bottom:6px;"><strong>#(result_diagnostic_label)</strong></p>
                #else:
                    <p class="hint">Aucun diagnostic prioritaire.</p>
                #endif
                #if(result_errors_present):
                    <ul class="error-list">
                        #for(error in result_error_items):
                        <li>
                            <strong>#(error.code)</strong>
                            <p>#(error.message)</p>
                        </li>
                        #endfor
                    </ul>
                #endif
                </section>

                <div class="meta-grid">
                    <div class="meta-box">
                        <strong>#(result_total_scanned)</strong>
                        <span>Détectés</span>
                    </div>
                    <div class="meta-box">
                        <strong>#(result_total_matched)</strong>
                        <span>Correspondants</span>
                    </div>
                    <div class="meta-box">
                        <strong>#(result_converted)</strong>
                        <span>Convertis</span>
                    </div>
                    <div class="meta-box">
                        <strong>#(result_simulated)</strong>
                        <span>Simulés</span>
                    </div>
                    <div class="meta-box">
                        <strong>#(result_skipped_existing)</strong>
                        <span>Existants ignorés</span>
                    </div>
                    <div class="meta-box">
                        <strong>#(result_errors)</strong>
                        <span>Erreurs</span>
                    </div>
                </div>

                #if(result_progress_present):
                <section class="result-subsection">
                    <h3>Journal court</h3>
                    <div class="event-list">
                        #for(event in result_progress_events):
                        <div class="event-item">
                            <strong>#(event.stage_label)</strong>
                            <span class="hint">#(event.percent_label) - <span class="mono">#(event.occurred_at)</span></span>
                            <p>#(event.message)</p>
                        </div>
                        #endfor
                    </div>
                </section>
                #endif
                #else:
                <p>Aucun résultat sélectionné. Lancez une analyse pour vérifier le lot avant conversion.</p>
                #endif
            </section>
        </div>

        <aside class="card">
            <h2>Runs récents MuniConversion</h2>
            #if(recent_runs_present):
            <div class="recent-list">
                #for(run in recent_runs):
                <article class="recent-item">
                    <div class="recent-top">
                        <div>
                            <strong>#(run.action_label)</strong><br>
                            <span class="mono">#(run.execution_id)</span>
                        </div>
                        <span class="status #(run.status_class)">#(run.status_label)</span>
                    </div>
                    <p class="summary">#(run.summary)</p>
                    #if(run.diagnostic_present):
                    <p style="margin:8px 0 0;"><span class="diag #(run.diagnostic_severity_class)">Diagnostic</span></p>
                    <p class="summary">#(run.diagnostic_label)</p>
                    #endif
                    <p class="hint">Terminé: <span class="mono">#(run.finished_at)</span></p>
                    <div class="recent-actions">
                        <a href="#(run.view_url)">Voir le résultat</a>
                        <a href="#(run.result_file_url)" target="_blank" rel="noopener">JSON</a>
                    </div>
                </article>
                #endfor
            </div>
            #else:
            <p>Aucun run MuniConversion n’est encore enregistré.</p>
            #endif
        </aside>
    </section>
</main>
#extend("components/muni_path_picker_scripts")
<script>
function syncMuniConversionDestinationRequired() {
    const checkbox = document.getElementById("muniConversionUseDestination");
    const destination = document.getElementById("muniConversionDestinationDirectory");
    if (!checkbox || !destination) {
        return;
    }
    destination.required = checkbox.checked;
}
syncMuniConversionDestinationRequired();
</script>
</body>
</html>

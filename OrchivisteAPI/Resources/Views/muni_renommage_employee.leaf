<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste MuniRenommage - Employé</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --danger: #9b3a16;
            --border: #d9d2c4;
            --ok-bg: #ebf8f4;
            --warn-bg: #fff2df;
            --danger-bg: #fbe4de;
            --info-bg: #eef4f6;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Avenir Next", "Helvetica Neue", sans-serif;
            color: var(--ink);
            background: linear-gradient(150deg, #f9f5ee 0%, #f2ece2 100%);
        }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap {
            max-width: 1240px;
            margin: 20px auto 40px;
            padding: 0 16px;
        }
        .subnav {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }
        .subnav a {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 7px 11px;
            text-decoration: none;
            color: var(--ink);
            background: #fff;
            font-weight: 700;
            font-size: 13px;
        }
        .subnav a.active {
            background: #ebf8f4;
            color: var(--accent);
            border-color: #bde2d7;
        }
        .hero, .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 16px;
            margin-bottom: 14px;
        }
        .hero-top {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            align-items: flex-start;
            flex-wrap: wrap;
        }
        h1, h2, h3, p {
            margin-top: 0;
        }
        .hero h1 {
            margin-bottom: 8px;
        }
        .hero .lead {
            color: var(--muted);
            line-height: 1.45;
            max-width: 760px;
        }
        .pill {
            display: inline-block;
            border-radius: 999px;
            padding: 4px 9px;
            font-size: 11px;
            font-weight: 700;
            border: 1px solid var(--border);
            background: #fff;
        }
        .pill-ok {
            background: var(--ok-bg);
            color: var(--accent);
        }
        .pill-warn {
            background: var(--warn-bg);
            color: #8d4e06;
        }
        .actions {
            margin-top: 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .actions a, button {
            border-radius: 999px;
            padding: 10px 14px;
            font-weight: 700;
            font-size: 13px;
            text-decoration: none;
            border: 1px solid var(--accent);
            cursor: pointer;
        }
        .actions .primary, .btn-primary {
            background: var(--accent);
            color: #fff;
        }
        .actions .secondary, .btn-secondary {
            background: #fff;
            color: var(--accent);
        }
        .btn-warning {
            background: #fff6e7;
            color: #8d4e06;
            border-color: #dfc59f;
        }
        button:disabled {
            background: #c7cecb;
            border-color: #c7cecb;
            color: #f7f7f7;
            cursor: not-allowed;
        }
        .grid {
            display: grid;
            gap: 14px;
            grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
        }
        .form-grid {
            display: grid;
            gap: 12px;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        }
        label {
            display: block;
            font-size: 13px;
            color: var(--muted);
            font-weight: 600;
        }
        input[type="text"], input[type="number"], select {
            margin-top: 6px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 10px;
            font: inherit;
            background: #fff;
            color: var(--ink);
        }
        .mode-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }
        .mode-tabs a {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 9px 12px;
            background: #fff;
            color: var(--ink);
            text-decoration: none;
            font-weight: 800;
            font-size: 13px;
        }
        .mode-tabs a.active {
            border-color: #bde2d7;
            background: #ebf8f4;
            color: var(--accent);
        }
        .section-title-row {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            align-items: flex-start;
            flex-wrap: wrap;
            margin-bottom: 8px;
        }
        .control-panel {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 12px;
            background: #fff;
            margin-top: 12px;
        }
        .control-panel h3 {
            margin-bottom: 8px;
            font-size: 15px;
        }
        .field-note {
            margin-top: 6px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.35;
        }
        #extend("components/muni_path_picker_styles")
        .checkboxes {
            display: flex;
            flex-wrap: wrap;
            gap: 14px;
            margin: 6px 0 2px;
        }
        .checkboxes label {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--ink);
            font-weight: 500;
        }
        .checkboxes input {
            width: auto;
            margin: 0;
        }
        .hint {
            margin: 8px 0 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.4;
        }
        .notice {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--accent);
        }
        .error {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--danger);
        }
        .status {
            display: inline-block;
            border-radius: 999px;
            padding: 3px 9px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .status-success { background: var(--ok-bg); color: var(--accent); }
        .status-warning { background: var(--warn-bg); color: #8d4e06; }
        .status-danger { background: var(--danger-bg); color: #8b2b14; }
        .status-info { background: var(--info-bg); color: #47606a; }
        .diag {
            display: inline-block;
            border-radius: 999px;
            padding: 3px 9px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .diag-info { background: var(--info-bg); color: #47606a; }
        .diag-warning { background: var(--warn-bg); color: #8d4e06; }
        .diag-blocking { background: var(--danger-bg); color: #8b2b14; }
        .meta-grid {
            display: grid;
            gap: 10px;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            margin-top: 12px;
        }
        .meta-box {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 10px;
            background: #fff;
        }
        .meta-box strong {
            display: block;
            font-size: 19px;
            margin-bottom: 4px;
        }
        .meta-box span {
            color: var(--muted);
            font-size: 12px;
        }
        .mono {
            font-family: "SF Mono", Menlo, monospace;
            font-size: 12px;
            line-height: 1.4;
        }
        .result-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px;
            flex-wrap: wrap;
        }
        .recent-list {
            display: grid;
            gap: 10px;
        }
        .recent-item {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 10px;
            background: #fff;
        }
        .recent-item a {
            color: inherit;
            text-decoration: none;
        }
        .recent-top {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 6px;
        }
        .recent-item .summary {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.4;
            margin: 0;
        }
        @media (max-width: 920px) {
            .grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Pilotage Muni</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/regles">Règles documentaires</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>

<main class="wrap">
    <nav class="subnav">
        <a href="#(back_to_catalog_url)">Catalogue</a>
        <a class="active" href="/ui/muni/apps/MuniRenommage/employe">MuniRenommage employé</a>
        <a href="#(technical_app_url)">Fiche technique</a>
        <a href="#(expert_launch_url)">Pilotage expert</a>
    </nav>

    #if(notice):
    <p class="notice">#(notice)</p>
    #endif
    #if(error):
    <p class="error">#(error)</p>
    #endif

    <section class="hero">
        <div class="hero-top">
            <div>
                <h1>MuniRenommage</h1>
                <p class="lead">Façade employé structurée pour prévisualiser puis appliquer un renommage manuel ou automatisé par règles municipales, sans passer par le mode expert.</p>
            </div>
            <span class="pill #(availability_class)">#(availability_label)</span>
        </div>
        <p class="hint" style="margin-top:10px;">#(availability_reason)</p>
        <div class="actions">
            <a class="primary" href="#(expert_launch_url)">Ouvrir le pilotage expert</a>
            <a class="secondary" href="#(technical_app_url)">Voir la fiche technique</a>
        </div>
    </section>

    <section class="grid">
        <div>
            <nav class="mode-tabs" aria-label="Modes de renommage">
                <a class="#(manual_tab_class)" href="#renommage-manuel">Renommage manuel</a>
                <a class="#(auto_tab_class)" href="#renommage-auto">Renommage automatisé (IA)</a>
            </nav>

            <section id="renommage-manuel" class="card">
                <div class="section-title-row">
                    <div>
                        <h2>Renommage manuel</h2>
                        <p class="hint">Profil actif: <strong>#(standard_profile_name)</strong>. #(standard_profile_summary)</p>
                    </div>
                    <span class="pill pill-ok">Preview / Apply</span>
                </div>

                <form action="/ui/muni/apps/MuniRenommage/employe/run" method="post">
                    <input type="hidden" name="rename_mode" value="manual">
                    <input type="hidden" name="preview_execution_id" value="#(preview_execution_id)">

                    <div class="source-destination-picker">
                        #extend("components/muni_path_picker"):
                            #export("picker_label", "Dossier source")
                            #export("picker_input_id", "muniRenommageSourceDirectory")
                            #export("picker_name", "source_directory")
                            #export("picker_value", source_directory)
                            #export("picker_placeholder", "/Volumes/.../a_traiter")
                            #export("picker_hint_id", "muniRenommageSourceHint")
                            #export("picker_mode_input_id", "muniRenommageSourceMode")
                            #export("picker_mode_name", "source_directory_mode")
                            #export("picker_mode", "server")
                            #export("picker_required_attr", "required")
                            #export("picker_hint", "Choisir ouvre le sélecteur local macOS; Serveur parcourt les dossiers accessibles à Orchiviste.")
                        #endextend
                        #extend("components/muni_path_picker"):
                            #export("picker_label", "Dossier destination")
                            #export("picker_input_id", "muniRenommageDestinationDirectory")
                            #export("picker_name", "destination_directory")
                            #export("picker_value", destination_directory)
                            #export("picker_placeholder", "/Volumes/.../classement")
                            #export("picker_hint_id", "muniRenommageDestinationHint")
                            #export("picker_mode_input_id", "muniRenommageDestinationMode")
                            #export("picker_mode_name", "destination_directory_mode")
                            #export("picker_mode", "server")
                            #export("picker_required_attr", "required")
                            #export("picker_hint", "Choisir ouvre le sélecteur local macOS; Serveur parcourt les dossiers accessibles à Orchiviste.")
                        #endextend
                    </div>

                    <div class="form-grid">
                        <label>
                            Preset / profil
                            <select name="preset_profile">
                                #for(option in preset_options):
                                <option value="#(option.id)" #(option.selected_attr)>#(option.label)</option>
                                #endfor
                            </select>
                        </label>
                        <label>
                            Collisions
                            <select name="collision_policy">
                                #for(option in collision_options):
                                <option value="#(option.id)" #(option.selected_attr)>#(option.label)</option>
                                #endfor
                            </select>
                            <span class="field-note">Le moteur signale les collisions et l'application reste contrôlée par une prévisualisation validée.</span>
                        </label>
                    </div>

                    <div class="checkboxes">
                        <label><input type="checkbox" name="recursive" #(recursive_checked_attr)> Inclure les sous-dossiers</label>
                        <label><input type="checkbox" name="include_hidden" #(include_hidden_checked_attr)> Inclure les fichiers cachés</label>
                    </div>

                    <div class="control-panel">
                        <h3>Filtres simples</h3>
                        <div class="form-grid">
                            <label>
                                Inclure seulement si le nom correspond
                                <input type="text" name="include_regex" value="#(include_regex)" placeholder="Ex. .*\\.pdf$">
                            </label>
                            <label>
                                Exclure si le nom correspond
                                <input type="text" name="exclude_regex" value="#(exclude_regex)" placeholder="Ex. brouillon|temp">
                            </label>
                        </div>
                    </div>

                    <div class="control-panel">
                        <h3>Règles manuelles utiles</h3>
                        <div class="form-grid">
                            <label>
                                <input type="checkbox" name="replace_enabled" #(replace_enabled_checked_attr)> Remplacer
                                <input type="text" name="replace_find" value="#(replace_find)" placeholder="Texte ou motif à chercher">
                            </label>
                            <label>
                                Remplacer par
                                <input type="text" name="replace_with" value="#(replace_with)" placeholder="Texte de remplacement">
                            </label>
                            <label>
                                <input type="checkbox" name="replace_regex" #(replace_regex_checked_attr)> Interpréter comme regex
                                <span class="field-note">Désactivez seulement pour un remplacement texte simple.</span>
                            </label>
                            <label>
                                <input type="checkbox" name="add_prefix_enabled" #(add_prefix_enabled_checked_attr)> Ajouter un préfixe
                                <input type="text" name="prefix" value="#(prefix)" placeholder="Ex. PV - ">
                            </label>
                            <label>
                                <input type="checkbox" name="add_suffix_enabled" #(add_suffix_enabled_checked_attr)> Ajouter un suffixe
                                <input type="text" name="suffix" value="#(suffix)" placeholder="Ex. - validé">
                            </label>
                            <label>
                                <input type="checkbox" name="date_prefix_enabled" #(date_prefix_enabled_checked_attr)> Date automatique en préfixe
                                <input type="text" name="date_format" value="#(date_format)" placeholder="yyyy-MM-dd">
                            </label>
                            <label>
                                <input type="checkbox" name="numbering_enabled" #(numbering_enabled_checked_attr)> Numérotation en préfixe
                                <input type="number" name="numbering_start" value="#(numbering_start)">
                            </label>
                            <label>
                                Chiffres et séparateur
                                <div class="form-grid">
                                    <input type="number" name="numbering_pad" value="#(numbering_pad)" min="1" max="12">
                                    <input type="text" name="numbering_separator" value="#(numbering_separator)">
                                </div>
                            </label>
                            <label>
                                Casse
                                <select name="casing_style">
                                    #for(option in casing_options):
                                    <option value="#(option.id)" #(option.selected_attr)>#(option.label)</option>
                                    #endfor
                                </select>
                            </label>
                            <label>
                                <input type="checkbox" name="parent_prefix_enabled" #(parent_prefix_enabled_checked_attr)> Ajouter le dossier parent en préfixe
                            </label>
                            <label>
                                <input type="checkbox" name="strip_diacritics" #(strip_diacritics_checked_attr)> Retirer les accents
                            </label>
                            <label>
                                <input type="checkbox" name="spaces_to_underscore" #(spaces_to_underscore_checked_attr)> Remplacer les espaces par _
                            </label>
                        </div>
                    </div>

                    #if(apply_hint_present):
                    <p class="hint">#(apply_hint)</p>
                    #endif

                    <div class="actions">
                        <button class="btn-primary" type="submit" name="operation" value="preview">Prévisualiser</button>
                        <button class="btn-warning" type="submit" name="operation" value="apply" #(apply_disabled_attr)>Appliquer</button>
                    </div>
                </form>
            </section>

            <section id="renommage-auto" class="card">
                <div class="section-title-row">
                    <div>
                        <h2>Renommage automatisé (IA)</h2>
                        <p class="hint">Parcours municipal fondé sur les règles MuniRegles disponibles pour PV, résolutions et lots documentaires.</p>
                    </div>
                    <span class="pill pill-warn">Préparation IA</span>
                </div>

                <form action="/ui/muni/apps/MuniRenommage/employe/run" method="post">
                    <input type="hidden" name="rename_mode" value="auto">
                    <input type="hidden" name="preview_execution_id" value="#(preview_execution_id)">

                    <div class="source-destination-picker">
                        #extend("components/muni_path_picker"):
                            #export("picker_label", "Dossier source")
                            #export("picker_input_id", "muniRenommageAutoSourceDirectory")
                            #export("picker_name", "source_directory")
                            #export("picker_value", source_directory)
                            #export("picker_placeholder", "/Volumes/.../pv_resolutions")
                            #export("picker_hint_id", "muniRenommageAutoSourceHint")
                            #export("picker_mode_input_id", "muniRenommageAutoSourceMode")
                            #export("picker_mode_name", "source_directory_mode")
                            #export("picker_mode", "server")
                            #export("picker_required_attr", "required")
                            #export("picker_hint", "Choisir ouvre le sélecteur local macOS; Serveur parcourt les dossiers accessibles à Orchiviste.")
                        #endextend
                        #extend("components/muni_path_picker"):
                            #export("picker_label", "Dossier destination")
                            #export("picker_input_id", "muniRenommageAutoDestinationDirectory")
                            #export("picker_name", "destination_directory")
                            #export("picker_value", destination_directory)
                            #export("picker_placeholder", "/Volumes/.../renommes")
                            #export("picker_hint_id", "muniRenommageAutoDestinationHint")
                            #export("picker_mode_input_id", "muniRenommageAutoDestinationMode")
                            #export("picker_mode_name", "destination_directory_mode")
                            #export("picker_mode", "server")
                            #export("picker_required_attr", "required")
                            #export("picker_hint", "Choisir ouvre le sélecteur local macOS; Serveur parcourt les dossiers accessibles à Orchiviste.")
                        #endextend
                    </div>

                    <div class="control-panel">
                        <h3>Bundle et règles</h3>
                        <p class="hint">#(regles_source_label): #(regles_summary)</p>
                        <div class="form-grid">
                            <label>
                                Bundle MuniRegles
                                <input type="text" name="regles_bundle_path" value="#(regles_bundle_path)" placeholder="/Volumes/.../muniregles_bundle.json">
                                <span class="field-note">#(regles_bundle_status)</span>
                            </label>
                            <label>
                                Règle de nommage
                                <select name="regles_naming_rule_id">
                                    #for(option in regles_rule_options):
                                    <option value="#(option.id)" #(option.selected_attr)>#(option.label)</option>
                                    #endfor
                                </select>
                                #if(regles_rules_present):
                                <span class="field-note">La règle est passée au moteur par les paramètres MuniRegles canoniques.</span>
                                #else:
                                <span class="field-note">Aucune règle disponible: le run produira un diagnostic/fallback lisible.</span>
                                #endif
                            </label>
                            <label>
                                Code de classement si requis
                                <input type="text" name="regles_class_code" value="#(regles_class_code)" placeholder="Ex. ADM-PV">
                            </label>
                        </div>
                    </div>

                    <div class="checkboxes">
                        <label><input type="checkbox" name="recursive" #(recursive_checked_attr)> Inclure les sous-dossiers</label>
                        <label><input type="checkbox" name="include_hidden" #(include_hidden_checked_attr)> Inclure les fichiers cachés</label>
                    </div>

                    #if(apply_hint_present):
                    <p class="hint">#(apply_hint)</p>
                    #endif

                    <div class="actions">
                        <button class="btn-primary" type="submit" name="operation" value="preview">Prévisualiser IA</button>
                        <button class="btn-warning" type="submit" name="operation" value="apply" #(apply_disabled_attr)>Appliquer le plan IA</button>
                    </div>
                </form>
            </section>

            <section class="card">
                <h2>Dernier résultat sélectionné</h2>
                #if(result_present):
                <div class="result-head">
                    <div>
                        <p style="margin-bottom:6px;"><strong>#(result_action_label)</strong></p>
                        <p class="mono" style="margin-bottom:8px;">#(result_execution_id)</p>
                    </div>
                    <span class="status #(result_status_class)">#(result_status_label)</span>
                </div>
                <p>#(result_summary)</p>
                <p class="hint">Terminé: <span class="mono">#(result_finished_at)</span></p>

                #if(result_plan_digest_present):
                <p class="hint">Digest du plan: <span class="mono">#(result_plan_digest)</span></p>
                #endif

                #if(result_diagnostic_present):
                <p style="margin-bottom:6px;"><span class="diag #(result_diagnostic_severity_class)">#(result_diagnostic_severity_label)</span></p>
                <p style="margin-bottom:6px;"><strong>#(result_diagnostic_label)</strong></p>
                #if(result_diagnostic_cta_present):
                <p class="hint">Action suggérée: #(result_diagnostic_cta)</p>
                #endif
                #endif

                #if(result_regles_trace_present):
                <div class="control-panel">
                    <h3>Trace automatisée</h3>
                    <div class="meta-grid">
                        <div class="meta-box">
                            <strong>#(result_regles_source)</strong>
                            <span>Source règles</span>
                        </div>
                        <div class="meta-box">
                            <strong>#(result_regles_rule_id)</strong>
                            <span>Règle</span>
                        </div>
                        <div class="meta-box">
                            <strong>#(result_regles_bundle_version)</strong>
                            <span>Bundle</span>
                        </div>
                        <div class="meta-box">
                            <strong>#(result_regles_apply_rule_label)</strong>
                            <span>Règle appliquée</span>
                        </div>
                    </div>
                    <p class="hint">Fallback: #(result_regles_fallback_reason)</p>
                </div>
                #endif

                <div class="meta-grid">
                    <div class="meta-box">
                        <strong>#(result_items_count)</strong>
                        <span>Fichiers analysés</span>
                    </div>
                    <div class="meta-box">
                        <strong>#(result_operations_count)</strong>
                        <span>Opérations prévues</span>
                    </div>
                    <div class="meta-box">
                        <strong>#(result_warnings_count)</strong>
                        <span>Avertissements</span>
                    </div>
                    <div class="meta-box">
                        <strong>#(result_collisions_count)</strong>
                        <span>Collisions</span>
                    </div>
                    <div class="meta-box">
                        <strong>#(result_existing_destinations_count)</strong>
                        <span>Destinations existantes</span>
                    </div>
                    <div class="meta-box">
                        <strong>#(result_idempotent_count)</strong>
                        <span>Déjà conformes</span>
                    </div>
                </div>
                #else:
                <p>Aucun résultat sélectionné. Lancez une prévisualisation pour verrouiller un plan avant Apply.</p>
                #endif
            </section>
        </div>

        <aside class="card">
            <h2>Runs récents MuniRenommage</h2>
            #if(recent_runs_present):
            <div class="recent-list">
                #for(run in recent_runs):
                <article class="recent-item">
                    <a href="#(run.view_url)">
                        <div class="recent-top">
                            <div>
                                <strong>#(run.action_label)</strong><br>
                                <span class="mono">#(run.execution_id)</span>
                            </div>
                            <span class="status status-info">#(run.status_label)</span>
                        </div>
                        <p class="summary">#(run.summary)</p>
                        #if(run.diagnostic_present):
                        <p style="margin:8px 0 0;"><span class="diag #(run.diagnostic_severity_class)">Diagnostic</span></p>
                        <p class="summary">#(run.diagnostic_label)</p>
                        #endif
                        <p class="hint">Terminé: <span class="mono">#(run.finished_at)</span></p>
                    </a>
                </article>
                #endfor
            </div>
            #else:
            <p>Aucun run MuniRenommage n’est encore enregistré.</p>
            #endif
        </aside>
    </section>
</main>
#extend("components/muni_path_picker_scripts")
</body>
</html>

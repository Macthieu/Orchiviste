<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Tableau de bord</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Avenir Next", "Helvetica Neue", sans-serif;
            color: var(--ink);
            background: linear-gradient(140deg, #f9f6ef 0%, #f1ece4 100%);
        }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap {
            max-width: 1120px;
            margin: 20px auto 40px;
            padding: 0 16px;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 10px;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
        }
        .upload-card {
            margin-top: 12px;
        }
        .upload-form {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 10px;
            align-items: end;
        }
        .upload-form label {
            display: block;
            font-size: 13px;
            color: var(--muted);
        }
        .upload-form input {
            margin-top: 4px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            font: inherit;
            background: #fff;
            color: var(--ink);
        }
        .upload-form button {
            border: 1px solid var(--accent);
            color: #fff;
            background: var(--accent);
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .error {
            color: var(--warning);
            font-weight: 700;
            margin-top: 10px;
        }
        .kpi {
            font-size: 28px;
            font-weight: 800;
            margin-top: 8px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 18px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 14px;
        }
        th { color: var(--muted); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; }
        .status-needs_review { color: var(--warning); font-weight: 700; }
        .status-completed { color: var(--accent); font-weight: 700; }
        .mono { font-family: "SF Mono", Menlo, monospace; font-size: 12px; }
        @media (max-width: 980px) {
            .upload-form {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste MVP</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/presets">Préréglages</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>
<main class="wrap">
    <section class="grid">
        <article class="card"><div>Total des tâches</div><div class="kpi">#(total_jobs)</div></article>
        <article class="card"><div>En attente</div><div class="kpi">#(pending_jobs)</div></article>
        <article class="card"><div>En cours</div><div class="kpi">#(running_jobs)</div></article>
        <article class="card"><div>Revue requise</div><div class="kpi">#(needs_review_jobs)</div></article>
        <article class="card"><div>Terminées</div><div class="kpi">#(completed_jobs)</div></article>
        <article class="card"><div>Agents</div><div class="kpi">#(worker_count)</div></article>
        <article class="card"><div>File d'ingestion</div><div class="kpi">#(queue_ingest_depth)</div></article>
        <article class="card"><div>File de rejet</div><div class="kpi">#(queue_dead_letter_depth)</div></article>
    </section>

    <section class="card upload-card">
        <h2>Importer un PDF local</h2>
        <p>L'import est explicite: le fichier est copié côté serveur puis injecté dans la file d'ingestion.</p>
        <form class="upload-form" action="/ui/ingest/local" method="post" enctype="multipart/form-data">
            <label>Fichier PDF
                <input type="file" name="pdf" accept="application/pdf" required>
            </label>
            <label>Étiquettes (optionnel)
                <input type="text" name="tags" placeholder="pv, comité, facture">
            </label>
            <button type="submit">Importer et analyser</button>
        </form>
        #if(upload_error):
        <p class="error">#(upload_error)</p>
        #endif
    </section>

    <h2>Tâches récentes</h2>
    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Statut</th>
            <th>Source</th>
            <th>Code</th>
            <th>Confiance</th>
            <th>Mise à jour</th>
        </tr>
        </thead>
        <tbody>
        #for(job in recent_jobs):
        <tr>
            <td class="mono"><a href="/ui/jobs/#(job.id)">#(job.id)</a></td>
            <td class="status-#(job.status)">#(job.status_label)</td>
            <td>#(job.source_kind)</td>
            <td>#(job.suggested_class_code)</td>
            <td>#(job.confidence)</td>
            <td>#(job.updated_at)</td>
        </tr>
        #endfor
        </tbody>
    </table>
</main>
</body>
</html>

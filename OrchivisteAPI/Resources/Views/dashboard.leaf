<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Tableau de bord</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Avenir Next", "Helvetica Neue", sans-serif;
            color: var(--ink);
            background: linear-gradient(140deg, #f9f6ef 0%, #f1ece4 100%);
        }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap {
            max-width: 1120px;
            margin: 20px auto 40px;
            padding: 0 16px;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 10px;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
        }
        .upload-card {
            margin-top: 12px;
        }
        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .section-head h2 {
            margin: 0;
        }
        .table-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .upload-form {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 10px;
            align-items: end;
        }
        .upload-form label {
            display: block;
            font-size: 13px;
            color: var(--muted);
        }
        .upload-form input {
            margin-top: 4px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            font: inherit;
            background: #fff;
            color: var(--ink);
        }
        .upload-form input[readonly] {
            background: #f7f3ec;
            color: var(--ink);
        }
        .path-row {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .path-row input {
            flex: 1;
        }
        .path-btn {
            border: 1px solid var(--accent);
            border-radius: 8px;
            background: #ebf8f4;
            color: var(--accent);
            font-weight: 700;
            padding: 8px 10px;
            cursor: pointer;
            white-space: nowrap;
        }
        .path-btn-server {
            border-color: var(--border);
            background: #fff;
            color: var(--muted);
        }
        .picker-upload-input {
            position: absolute;
            width: 1px;
            height: 1px;
            margin: 0;
            padding: 0;
            opacity: 0;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            clip-path: inset(50%);
            white-space: nowrap;
            border: 0;
            pointer-events: none;
        }
        .upload-form button {
            border: 1px solid var(--accent);
            color: #fff;
            background: var(--accent);
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn-secondary {
            border: 1px solid var(--border);
            color: var(--ink);
            background: #fff;
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .table-wrap {
            overflow-x: auto;
        }
        .status-strip {
            margin: 12px 0 8px;
            display: grid;
            gap: 8px;
        }
        .status-track {
            display: flex;
            min-height: 14px;
            border-radius: 999px;
            overflow: hidden;
            background: #ece5d8;
            border: 1px solid var(--border);
        }
        .status-segment {
            min-width: 0;
        }
        .status-segment-pending {
            background: repeating-linear-gradient(
                135deg,
                #c6bba5 0,
                #c6bba5 10px,
                #d8cfbf 10px,
                #d8cfbf 20px
            );
            background-size: 200% 100%;
            animation: statusFlow 2s linear infinite;
        }
        .status-segment-running {
            background: repeating-linear-gradient(
                135deg,
                #6cb7a4 0,
                #6cb7a4 10px,
                #8ccbbb 10px,
                #8ccbbb 20px
            );
            background-size: 200% 100%;
            animation: statusFlow 1.5s linear infinite;
        }
        .status-segment-review {
            background: #d6944e;
        }
        .status-segment-completed {
            background: #0c6b58;
        }
        .status-segment-failed {
            background: #b55454;
        }
        .status-segment-cancelled {
            background: #8e8e8e;
        }
        .status-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 12px;
            font-size: 12px;
            color: var(--muted);
        }
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 4px 8px;
            background: #fff;
        }
        .status-pill-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex: 0 0 auto;
        }
        .status-pill-pending { background: #c6bba5; }
        .status-pill-running { background: #6cb7a4; }
        .status-pill-review { background: #d6944e; }
        .status-pill-completed { background: #0c6b58; }
        .status-pill-failed { background: #b55454; }
        .status-pill-cancelled { background: #8e8e8e; }
        .error {
            color: var(--warning);
            font-weight: 700;
            margin-top: 10px;
        }
        .notice {
            color: var(--accent);
            font-weight: 700;
            margin-top: 10px;
        }
        .help {
            color: var(--muted);
            font-size: 12px;
            margin-top: 8px;
        }
        .kpi {
            font-size: 28px;
            font-weight: 800;
            margin-top: 8px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 18px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 14px;
            vertical-align: top;
        }
        th { color: var(--muted); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; }
        .status-needs_review { color: var(--warning); font-weight: 700; }
        .status-completed { color: var(--accent); font-weight: 700; }
        .mono { font-family: "SF Mono", Menlo, monospace; font-size: 12px; }
        .cell-name, .cell-path {
            min-width: 180px;
            max-width: 320px;
            word-break: break-word;
        }
        .empty-state {
            padding: 18px 12px;
            color: var(--muted);
        }
        .picker-overlay {
            position: fixed;
            inset: 0;
            background: rgba(25, 25, 25, 0.3);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 999;
        }
        .picker {
            width: min(900px, 94vw);
            max-height: 80vh;
            overflow: auto;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
        }
        .picker-toolbar {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }
        .picker-toolbar button {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 6px 9px;
            background: #fff;
            cursor: pointer;
        }
        .picker-list button {
            width: 100%;
            text-align: left;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            margin-bottom: 6px;
            background: #fff;
            cursor: pointer;
        }
        @keyframes statusFlow {
            from { background-position: 0 0; }
            to { background-position: 40px 0; }
        }
        @media (max-width: 980px) {
            .upload-form {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste MVP</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/presets">Préréglages</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>
<main class="wrap">
    <section class="grid">
        <article class="card"><div>Total des tâches</div><div class="kpi">#(total_jobs)</div></article>
        <article class="card"><div>En attente</div><div class="kpi">#(pending_jobs)</div></article>
        <article class="card"><div>En cours</div><div class="kpi">#(running_jobs)</div></article>
        <article class="card"><div>Revue requise</div><div class="kpi">#(needs_review_jobs)</div></article>
        <article class="card"><div>Terminées</div><div class="kpi">#(completed_jobs)</div></article>
        <article class="card"><div>Agents</div><div class="kpi">#(worker_count)</div></article>
        <article class="card"><div>File d'ingestion</div><div class="kpi">#(queue_ingest_depth)</div></article>
        <article class="card"><div>File de rejet</div><div class="kpi">#(queue_dead_letter_depth)</div></article>
    </section>

    <section class="card upload-card">
        <h2>Importer un document local</h2>
        <p>L'import est explicite: le fichier est copié côté serveur puis injecté dans la file d'ingestion.</p>
        <form id="singleIngestForm" class="upload-form" action="/ui/ingest/local" method="post" enctype="multipart/form-data">
            <label>Fichier (serveur ou local)
                <div class="path-row">
                    <input id="singleFileDisplay" type="text" placeholder="Choisir un fichier local ou sélectionner un fichier serveur" readonly>
                    <input id="singleServerFileField" type="hidden" name="server_file">
                    <button class="path-btn" type="button" onclick="openSingleLocalFilePicker()">Choisir</button>
                    <button class="path-btn path-btn-server" type="button" onclick="openServerFilePicker('singleServerFileField', 'singleFileDisplay', 'singleFileHint')">Serveur</button>
                </div>
                    <input id="singleFileUpload" class="picker-upload-input" type="file" name="pdf" accept=".pdf,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.tif,.tiff,application/pdf,image/*" onchange="handleLocalFileSelection('singleFileUpload', 'singleServerFileField', 'singleFileDisplay', 'singleFileHint')">
                <div id="singleFileHint" class="help">Le bouton "Choisir" ouvre le sélecteur de fichier local. Le bouton "Serveur" parcourt les fichiers visibles par l'API.</div>
            </label>
            <label>Étiquettes (optionnel)
                <input type="text" name="tags" placeholder="pv, comité, facture">
            </label>
            <button type="submit">Importer et analyser</button>
        </form>
        <div class="help">
            Mode Docker: le serveur lit les dossiers montés, par défaut <code>/data/inbox</code> (entrée) et <code>/data/routed</code> (sortie).
        </div>
        <hr style="border:none; border-top:1px solid var(--border); margin:14px 0;">
        <h3 style="margin: 0 0 8px;">Importer un dossier local (lot)</h3>
        <form id="folderIngestForm" class="upload-form" action="/ui/ingest/folder" method="post" enctype="multipart/form-data">
            <input id="inputFolderMode" type="hidden" name="input_mode" value="server">
            <input id="outputFolderMode" type="hidden" name="output_mode" value="server">
            <label>Dossier d'entrée (serveur ou local)
                <div class="path-row">
                    <input id="inputFolderField" type="text" name="input_folder" value="#(ingest_default_input_folder)" placeholder="/data/inbox (laisser vide pour un dossier local)">
                    <button class="path-btn" type="button" onclick="openInputLocalFolderPicker()">Choisir</button>
                    <button class="path-btn path-btn-server" type="button" onclick="openFolderPicker('inputFolderField', null, 'inputFolderHint', 'inputFolderMode')">Serveur</button>
                </div>
                <input id="inputFolderUpload" class="picker-upload-input" type="file" name="folder_files[]" accept=".pdf,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.tif,.tiff,application/pdf,image/*" webkitdirectory directory multiple onchange="handleLocalFolderSelection('inputFolderUpload','inputFolderField','inputFolderHint','inputFolderMode')">
                <div id="inputFolderHint" class="help">Le bouton "Choisir" ouvre le sélecteur de dossier local (ton ordinateur).</div>
            </label>
            <label>Dossier de sortie (optionnel)
                <div class="path-row">
                    <input id="outputFolderField" type="text" name="output_root" value="#(ingest_default_output_folder)" placeholder="/data/routed">
                    <button class="path-btn" type="button" onclick="openOutputLocalFolderPicker()">Choisir</button>
                    <button class="path-btn path-btn-server" type="button" onclick="openFolderPicker('outputFolderField', null, 'outputFolderHint', 'outputFolderMode')">Serveur</button>
                </div>
                <input id="outputFolderUpload" class="picker-upload-input" type="file" accept=".pdf,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.tif,.tiff,application/pdf,image/*" webkitdirectory directory multiple onchange="handleLocalOutputFolderSelection('outputFolderUpload','outputFolderField','outputFolderHint','outputFolderMode','#(ingest_default_output_folder)')">
                <div id="outputFolderHint" class="help">Le bouton "Choisir" ouvre un dossier local et cible un sous-dossier de sortie côté serveur. Le bouton "Serveur" parcourt les dossiers visibles par l'API.</div>
            </label>
            <label>Étiquettes (optionnel)
                <input type="text" name="tags" placeholder="ville, résolution, conseil">
            </label>
            <label>Maximum de fichiers
                <input type="number" name="max_files" min="1" max="500" value="50">
            </label>
            <label>Récursif
                <input type="checkbox" name="recursive" value="1" checked>
            </label>
            <button type="submit">Importer le dossier</button>
        </form>
        #if(upload_notice):
        <p class="notice">#(upload_notice)</p>
        #endif
        #if(upload_error):
        <p class="error">#(upload_error)</p>
        #endif
    </section>

    <section id="recent-jobs" class="section-head" style="margin-top: 18px;">
        <h2>Tâches récentes</h2>
        <div class="table-actions">
            <form action="/ui/dashboard/recent-jobs/clear" method="post" style="margin:0;">
                <button class="btn-secondary" type="submit">Effacer la liste</button>
            </form>
            #if(recent_jobs_cleared):
            <form action="/ui/dashboard/recent-jobs/reset" method="post" style="margin:0;">
                <button class="btn-secondary" type="submit">Réafficher tout</button>
            </form>
            #endif
        </div>
    </section>
    #if(dashboard_notice):
    <p class="notice">#(dashboard_notice)</p>
    #endif
    #if(dashboard_error):
    <p class="error">#(dashboard_error)</p>
    #endif
    <div id="recentJobsPanel">
    #if(recent_jobs_present):
    <div id="recentJobsStatus" class="status-strip">
        <div class="status-track" aria-label="Progression des tâches récentes">
            #if(recent_pending_jobs):
            <div class="status-segment status-segment-pending" style="width: calc((#(recent_pending_jobs) / #(recent_total_jobs)) * 100%);"></div>
            #endif
            #if(recent_running_jobs):
            <div class="status-segment status-segment-running" style="width: calc((#(recent_running_jobs) / #(recent_total_jobs)) * 100%);"></div>
            #endif
            #if(recent_needs_review_jobs):
            <div class="status-segment status-segment-review" style="width: calc((#(recent_needs_review_jobs) / #(recent_total_jobs)) * 100%);"></div>
            #endif
            #if(recent_completed_jobs):
            <div class="status-segment status-segment-completed" style="width: calc((#(recent_completed_jobs) / #(recent_total_jobs)) * 100%);"></div>
            #endif
            #if(recent_failed_jobs):
            <div class="status-segment status-segment-failed" style="width: calc((#(recent_failed_jobs) / #(recent_total_jobs)) * 100%);"></div>
            #endif
            #if(recent_cancelled_jobs):
            <div class="status-segment status-segment-cancelled" style="width: calc((#(recent_cancelled_jobs) / #(recent_total_jobs)) * 100%);"></div>
            #endif
        </div>
        <div class="status-legend">
            <span class="status-pill"><span class="status-pill-dot status-pill-pending"></span>En attente: #(recent_pending_jobs)</span>
            <span class="status-pill"><span class="status-pill-dot status-pill-running"></span>En cours: #(recent_running_jobs)</span>
            <span class="status-pill"><span class="status-pill-dot status-pill-review"></span>Revue: #(recent_needs_review_jobs)</span>
            <span class="status-pill"><span class="status-pill-dot status-pill-completed"></span>Terminées: #(recent_completed_jobs)</span>
            <span class="status-pill"><span class="status-pill-dot status-pill-failed"></span>Échecs: #(recent_failed_jobs)</span>
            <span class="status-pill"><span class="status-pill-dot status-pill-cancelled"></span>Annulées: #(recent_cancelled_jobs)</span>
        </div>
        #if(dashboard_has_active_processing):
        <div id="recentJobsActiveHint" class="help">Actualisation automatique active toutes les #(dashboard_auto_refresh_seconds) secondes pendant le traitement.</div>
        #endif
    </div>
    #endif
    <div class="table-wrap">
    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Statut</th>
            <th>Source</th>
            <th>Code</th>
            <th>Confiance</th>
            <th>OCR OK</th>
            <th>Nouveau nom</th>
            <th>Métadonnées OK</th>
            <th>Dossier enregistré</th>
            <th>Mise à jour</th>
        </tr>
        </thead>
        <tbody id="recentJobsBody">
        #for(job in recent_jobs):
        <tr>
            <td class="mono"><a href="/ui/jobs/#(job.id)">#(job.id)</a></td>
            <td class="status-#(job.status)">#(job.status_label)</td>
            <td>#(job.source_kind)</td>
            <td>#(job.suggested_class_code)</td>
            <td>#(job.confidence)</td>
            <td>#(job.ocr_ok)</td>
            <td class="cell-name mono">#(job.resolved_file_name)</td>
            <td>#(job.metadata_ok)</td>
            <td class="cell-path mono">#(job.saved_folder_path)</td>
            <td>#(job.updated_at)</td>
        </tr>
        #endfor
        #if(recent_jobs_empty):
        <tr>
            <td id="recentJobsEmptyState" colspan="10" class="empty-state">
                #if(recent_jobs_cleared):
                La liste a été vidée. Les nouvelles tâches créées après ce reset réapparaîtront ici.
                #else:
                Aucune tâche récente à afficher.
                #endif
            </td>
        </tr>
        #endif
        </tbody>
    </table>
    </div>
    </div>
</main>
<div id="folderPickerOverlay" class="picker-overlay" onclick="closeFolderPicker(event)">
    <div class="picker" onclick="event.stopPropagation()">
        <h3 id="pickerTitle">Sélectionner un dossier</h3>
        <div class="picker-toolbar">
            <button type="button" onclick="pickerGoParent()">Parent</button>
            <span id="pickerCurrent" class="mono"></span>
        </div>
        <div id="pickerRoots" class="picker-toolbar"></div>
        <div id="pickerList" class="picker-list"></div>
        <div class="picker-toolbar">
            <button id="pickerApplyFolderButton" type="button" onclick="applyPickedFolder()">Utiliser ce dossier</button>
            <button type="button" onclick="closeFolderPicker()">Fermer</button>
        </div>
    </div>
</div>
<script>
let pickerTargetInputId = null;
let pickerTargetDisplayId = null;
let pickerTargetHintId = null;
let pickerTargetModeId = null;
let pickerCurrentPath = null;
let pickerParentPath = null;
let pickerRoots = [];
let pickerMode = "folder";
let selectedSingleLocalFile = null;
let selectedInputFolderFiles = [];

function supportedUploadExtensions() {
    return [".pdf", ".docx", ".xlsx", ".pptx", ".png", ".jpg", ".jpeg", ".tif", ".tiff"];
}

function isSupportedUploadFileName(name) {
    const lowered = String(name || "").toLowerCase();
    return supportedUploadExtensions().some((ext) => lowered.endsWith(ext));
}

function setSingleLocalFileSelection(file) {
    const serverInput = document.getElementById("singleServerFileField");
    const displayInput = document.getElementById("singleFileDisplay");
    const hint = document.getElementById("singleFileHint");

    selectedSingleLocalFile = file || null;
    if (serverInput) {
        serverInput.value = "";
    }
    if (displayInput) {
        displayInput.value = file ? file.name : "";
    }
    if (hint) {
        hint.textContent = file
            ? `Fichier local sélectionné: ${file.name}.`
            : "Aucun fichier local sélectionné.";
    }
}

function setInputFolderSelection(entries, folderName) {
    const pathInput = document.getElementById("inputFolderField");
    const hint = document.getElementById("inputFolderHint");
    const modeInput = document.getElementById("inputFolderMode");
    const supportedEntries = (entries || []).filter((entry) => isSupportedUploadFileName(entry.file?.name || entry.file?.filename || entry.relativePath || ""));
    selectedInputFolderFiles = supportedEntries;

    if (pathInput) {
        pathInput.value = folderName || "";
    }
    if (modeInput) {
        modeInput.value = "local";
    }
    if (hint) {
        hint.textContent = supportedEntries.length
            ? `Dossier local sélectionné: ${folderName || "dossier-local"} (${supportedEntries.length} document(s) supporté(s)).`
            : "Aucun document supporté trouvé dans le dossier local.";
    }
}

function setOutputFolderSelection(folderName, pathInputId, hintId, modeInputId, defaultRoot) {
    const pathInput = document.getElementById(pathInputId);
    const hint = document.getElementById(hintId);
    const modeInput = document.getElementById(modeInputId);
    const normalizedDefaultRoot = String(defaultRoot || "").replace(/\/+$/, "");
    const currentValue = (pathInput && pathInput.value ? pathInput.value : "").replace(/\/+$/, "");
    const currentBase = currentValue.startsWith(`${normalizedDefaultRoot}/`) ? normalizedDefaultRoot : (currentValue || normalizedDefaultRoot);
    const resolvedPath = folderName ? `${currentBase}/${folderName}` : currentBase;

    if (pathInput) {
        pathInput.value = resolvedPath;
    }
    if (modeInput) {
        modeInput.value = "local";
    }
    if (hint) {
        hint.textContent = `Sortie serveur ciblée: ${resolvedPath}. Le dossier choisi localement sert à nommer le sous-dossier de sortie côté serveur.`;
    }
}

function openSingleLocalFilePicker() {
    openLocalFileDialog("singleFileUpload");
}

function openInputLocalFolderPicker() {
    openLocalFolderDialog("inputFolderUpload");
}

function openOutputLocalFolderPicker() {
    openLocalFolderDialog("outputFolderUpload");
}

function openLocalFileDialog(fileInputId) {
    const picker = document.getElementById(fileInputId);
    if (!picker) {
        return;
    }
    picker.value = "";
    picker.click();
}

function openLocalFolderDialog(fileInputId) {
    const picker = document.getElementById(fileInputId);
    if (!picker) {
        return;
    }
    picker.value = "";
    picker.click();
}

function handleLocalFileSelection(fileInputId, serverInputId, displayInputId, hintId) {
    const picker = document.getElementById(fileInputId);
    if (!picker) {
        return;
    }

    const file = (picker.files || [])[0];
    if (!file) {
        setSingleLocalFileSelection(null);
        return;
    }

    setSingleLocalFileSelection(file);
}

function handleLocalFolderSelection(fileInputId, pathInputId, hintId, modeInputId) {
    const picker = document.getElementById(fileInputId);
    if (!picker) {
        return;
    }

    const files = Array.from(picker.files || []);
    if (!files.length) {
        setInputFolderSelection([], "");
        return;
    }

    const firstRelativePath = files[0].webkitRelativePath || files[0].name;
    const folderName = firstRelativePath.includes("/") ? firstRelativePath.split("/")[0] : firstRelativePath;
    const entries = files.map((file) => ({
        file,
        relativePath: file.webkitRelativePath || file.name
    }));
    setInputFolderSelection(entries, folderName);
}

function handleLocalOutputFolderSelection(fileInputId, pathInputId, hintId, modeInputId, defaultRoot) {
    const picker = document.getElementById(fileInputId);
    if (!picker) {
        return;
    }

    const files = Array.from(picker.files || []);
    if (!files.length) {
        const hint = document.getElementById(hintId);
        if (hint) {
            hint.textContent = "Aucun dossier local sélectionné pour la sortie.";
        }
        return;
    }

    const firstRelativePath = files[0].webkitRelativePath || files[0].name;
    const folderName = firstRelativePath.includes("/") ? firstRelativePath.split("/")[0] : firstRelativePath;
    setOutputFolderSelection(folderName, pathInputId, hintId, modeInputId, defaultRoot);
}

function openFolderPicker(inputId, displayId, hintId, modeInputId) {
    pickerMode = "folder";
    pickerTargetInputId = inputId;
    pickerTargetDisplayId = displayId || null;
    pickerTargetHintId = hintId || null;
    pickerTargetModeId = modeInputId || null;
    const input = document.getElementById(inputId);
    const startPath = input && input.value ? input.value : "";
    document.getElementById("pickerTitle").textContent = "Sélectionner un dossier serveur";
    document.getElementById("pickerApplyFolderButton").style.display = "inline-flex";
    document.getElementById("folderPickerOverlay").style.display = "flex";
    loadFolderList(startPath);
}

function openServerFilePicker(hiddenInputId, displayInputId, hintId) {
    pickerMode = "file";
    pickerTargetInputId = hiddenInputId;
    pickerTargetDisplayId = displayInputId;
    pickerTargetHintId = hintId;
    pickerTargetModeId = null;
    const hiddenInput = document.getElementById(hiddenInputId);
    const startPath = hiddenInput && hiddenInput.value ? hiddenInput.value : "";
    document.getElementById("pickerTitle").textContent = "Sélectionner un fichier serveur";
    document.getElementById("pickerApplyFolderButton").style.display = "none";
    document.getElementById("folderPickerOverlay").style.display = "flex";
    loadFolderList(startPath);
}

function closeFolderPicker(event) {
    if (event && event.target && event.target.id !== "folderPickerOverlay") {
        return;
    }
    document.getElementById("folderPickerOverlay").style.display = "none";
}

async function loadFolderList(path) {
    const query = path ? `?path=${encodeURIComponent(path)}` : "";
    const res = await fetch(`/ui/fs/list${query}`);
    if (!res.ok) {
        alert(`Impossible de lister les dossiers (${res.status}).`);
        return;
    }
    const data = await res.json();
    pickerCurrentPath = data.current;
    pickerParentPath = data.parent || null;
    pickerRoots = data.roots || [];
    document.getElementById("pickerCurrent").textContent = pickerCurrentPath;
    renderPickerRoots();
    renderPickerList(data.directories || [], data.files || []);
}

function renderPickerRoots() {
    const rootContainer = document.getElementById("pickerRoots");
    rootContainer.innerHTML = "";
    for (const root of pickerRoots) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = `Racine: ${root}`;
        btn.onclick = () => loadFolderList(root);
        rootContainer.appendChild(btn);
    }
}

function renderPickerList(entries, files) {
    const list = document.getElementById("pickerList");
    list.innerHTML = "";
    for (const entry of entries) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = `${entry.name} (${entry.path})`;
        btn.onclick = () => loadFolderList(entry.path);
        list.appendChild(btn);
    }
    if (pickerMode === "file" && files.length) {
        const heading = document.createElement("div");
        heading.className = "help";
        heading.textContent = "Fichiers supportés";
        list.appendChild(heading);
        for (const entry of files) {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.textContent = `${entry.name} (${entry.path})`;
            btn.onclick = () => applyPickedFile(entry.path);
            list.appendChild(btn);
        }
    }
}

function pickerGoParent() {
    if (pickerParentPath) {
        loadFolderList(pickerParentPath);
    }
}

function applyPickedFolder() {
    if (!pickerTargetInputId || !pickerCurrentPath) {
        return;
    }
    const input = document.getElementById(pickerTargetInputId);
    if (input) {
        input.value = pickerCurrentPath;
    }
    if (pickerTargetDisplayId) {
        const displayInput = document.getElementById(pickerTargetDisplayId);
        if (displayInput) {
            displayInput.value = pickerCurrentPath;
        }
    }
    if (pickerTargetHintId) {
        const hint = document.getElementById(pickerTargetHintId);
        if (hint) {
            hint.textContent = `Dossier serveur sélectionné: ${pickerCurrentPath}.`;
        }
    }
    if (pickerTargetModeId) {
        const modeInput = document.getElementById(pickerTargetModeId);
        if (modeInput) {
            modeInput.value = "server";
        }
    }
    if (pickerTargetInputId === "inputFolderField") {
        selectedInputFolderFiles = [];
    }
    closeFolderPicker();
}

function applyPickedFile(path) {
    if (!pickerTargetInputId || !path) {
        return;
    }
    const hiddenInput = document.getElementById(pickerTargetInputId);
    if (hiddenInput) {
        hiddenInput.value = path;
    }
    if (pickerTargetDisplayId) {
        const displayInput = document.getElementById(pickerTargetDisplayId);
        if (displayInput) {
            displayInput.value = path;
        }
    }
    if (pickerTargetHintId) {
        const hint = document.getElementById(pickerTargetHintId);
        if (hint) {
            hint.textContent = `Fichier serveur sélectionné: ${path}.`;
        }
    }
    selectedSingleLocalFile = null;
    const uploadInput = document.getElementById("singleFileUpload");
    if (uploadInput) {
        uploadInput.value = "";
    }
    closeFolderPicker();
}

function resolveSelectedFolderEntries() {
    if (selectedInputFolderFiles.length) {
        return selectedInputFolderFiles;
    }
    const input = document.getElementById("inputFolderUpload");
    const files = Array.from(input?.files || []);
    return files.map((file) => ({
        file,
        relativePath: file.webkitRelativePath || file.name
    }));
}

async function submitMultipartForm(action, formData) {
    const response = await fetch(action, {
        method: "POST",
        body: formData,
        redirect: "follow"
    });
    if (response.redirected) {
        window.location.href = response.url;
        return;
    }
    if (response.ok) {
        const html = await response.text();
        document.open();
        document.write(html);
        document.close();
        return;
    }
    const message = await response.text();
    throw new Error(message || `HTTP ${response.status}`);
}

const singleIngestForm = document.getElementById("singleIngestForm");
if (singleIngestForm) {
    singleIngestForm.addEventListener("submit", async (event) => {
        if (!selectedSingleLocalFile) {
            return;
        }
        event.preventDefault();
        const formData = new FormData();
        formData.append("pdf", selectedSingleLocalFile, selectedSingleLocalFile.name);
        const tags = singleIngestForm.querySelector('input[name="tags"]')?.value || "";
        if (tags.trim()) {
            formData.append("tags", tags.trim());
        }
        try {
            await submitMultipartForm(singleIngestForm.action, formData);
        } catch (error) {
            alert(`Échec de l'import local (${error.message || error})`);
        }
    });
}

const folderIngestForm = document.getElementById("folderIngestForm");
if (folderIngestForm) {
    folderIngestForm.addEventListener("submit", async (event) => {
        const inputMode = document.getElementById("inputFolderMode")?.value || "server";
        if (inputMode !== "local") {
            return;
        }

        const entries = resolveSelectedFolderEntries().filter((entry) => isSupportedUploadFileName(entry.file?.name || entry.relativePath));
        if (!entries.length) {
            event.preventDefault();
            alert("Sélectionne un dossier local contenant des documents supportés.");
            return;
        }

        event.preventDefault();
        const formData = new FormData();
        const appendField = (selector) => {
            const element = folderIngestForm.querySelector(selector);
            if (!element || typeof element.value !== "string") {
                return;
            }
            const value = element.value.trim();
            if (!value) {
                return;
            }
            formData.append(element.name, value);
        };

        appendField('input[name="input_folder"]');
        appendField('input[name="input_mode"]');
        appendField('input[name="tags"]');
        appendField('input[name="max_files"]');
        appendField('input[name="output_root"]');
        appendField('input[name="output_mode"]');

        const recursiveField = folderIngestForm.querySelector('input[name="recursive"]');
        if (recursiveField && recursiveField.checked) {
            formData.append("recursive", recursiveField.value || "1");
        }

        for (const entry of entries) {
            const fileName = entry.relativePath || entry.file.name;
            formData.append("folder_files[]", entry.file, fileName);
        }

        try {
            await submitMultipartForm(folderIngestForm.action, formData);
        } catch (error) {
            alert(`Échec de l'import du dossier (${error.message || error})`);
        }
    });
}

const dashboardAutoRefreshSeconds = Number("#(dashboard_auto_refresh_seconds)");
if (dashboardAutoRefreshSeconds > 0) {
    const refreshDashboard = async () => {
        const activeElement = document.activeElement;
        const isEditingForm = activeElement && ["INPUT", "TEXTAREA", "SELECT"].includes(activeElement.tagName);
        if (document.hidden || isEditingForm) {
            window.setTimeout(refreshDashboard, dashboardAutoRefreshSeconds * 1000);
            return;
        }
        try {
            const response = await fetch("/ui/dashboard/recent-jobs", {
                headers: {
                    "Accept": "application/json"
                }
            });
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }
            const payload = await response.json();
            renderRecentJobs(payload);
        } catch (error) {
            console.warn("Échec actualisation tâches récentes", error);
        }
        window.setTimeout(refreshDashboard, dashboardAutoRefreshSeconds * 1000);
    };
    window.setTimeout(refreshDashboard, dashboardAutoRefreshSeconds * 1000);
}

function renderRecentJobs(payload) {
    renderRecentJobsStatus(payload);
    renderRecentJobsTable(payload);
}

function renderRecentJobsStatus(payload) {
    const panel = document.getElementById("recentJobsPanel");
    if (!panel) {
        return;
    }
    let status = document.getElementById("recentJobsStatus");
    if (!status) {
        status = document.createElement("div");
        status.id = "recentJobsStatus";
        status.className = "status-strip";
        panel.insertBefore(status, panel.firstChild);
    }
    if (!payload.recent_jobs_present) {
        status.innerHTML = "";
        return;
    }
    const total = Math.max(1, Number(payload.recent_total_jobs) || 1);
    const segments = [
        ["pending", payload.recent_pending_jobs],
        ["running", payload.recent_running_jobs],
        ["review", payload.recent_needs_review_jobs],
        ["completed", payload.recent_completed_jobs],
        ["failed", payload.recent_failed_jobs],
        ["cancelled", payload.recent_cancelled_jobs]
    ]
        .filter(([, count]) => Number(count) > 0)
        .map(([name, count]) => `<div class="status-segment status-segment-${name}" style="width:${(Number(count) / total) * 100}%"></div>`)
        .join("");
    status.innerHTML = `
        <div class="status-track" aria-label="Progression des tâches récentes">${segments}</div>
        <div class="status-legend">
            <span class="status-pill"><span class="status-pill-dot status-pill-pending"></span>En attente: ${payload.recent_pending_jobs}</span>
            <span class="status-pill"><span class="status-pill-dot status-pill-running"></span>En cours: ${payload.recent_running_jobs}</span>
            <span class="status-pill"><span class="status-pill-dot status-pill-review"></span>Revue: ${payload.recent_needs_review_jobs}</span>
            <span class="status-pill"><span class="status-pill-dot status-pill-completed"></span>Terminées: ${payload.recent_completed_jobs}</span>
            <span class="status-pill"><span class="status-pill-dot status-pill-failed"></span>Échecs: ${payload.recent_failed_jobs}</span>
            <span class="status-pill"><span class="status-pill-dot status-pill-cancelled"></span>Annulées: ${payload.recent_cancelled_jobs}</span>
        </div>
        ${payload.dashboard_has_active_processing ? `<div id="recentJobsActiveHint" class="help">Actualisation automatique active toutes les ${payload.dashboard_auto_refresh_seconds} secondes pendant le traitement.</div>` : ""}
    `;
}

function renderRecentJobsTable(payload) {
    const body = document.getElementById("recentJobsBody");
    if (!body) {
        return;
    }
    if (!payload.recent_jobs || !payload.recent_jobs.length) {
        const message = payload.recent_jobs_cleared
            ? "La liste a été vidée. Les nouvelles tâches créées après ce reset réapparaîtront ici."
            : "Aucune tâche récente à afficher.";
        body.innerHTML = `<tr><td id="recentJobsEmptyState" colspan="10" class="empty-state">${message}</td></tr>`;
        return;
    }
    body.innerHTML = payload.recent_jobs.map((job) => `
        <tr>
            <td class="mono"><a href="/ui/jobs/${job.id}">${job.id}</a></td>
            <td class="status-${job.status}">${job.status_label}</td>
            <td>${job.source_kind}</td>
            <td>${job.suggested_class_code}</td>
            <td>${job.confidence}</td>
            <td>${job.ocr_ok}</td>
            <td class="cell-name mono">${escapeHTML(job.resolved_file_name)}</td>
            <td>${job.metadata_ok}</td>
            <td class="cell-path mono">${escapeHTML(job.saved_folder_path)}</td>
            <td>${job.updated_at}</td>
        </tr>
    `).join("");
}

function escapeHTML(value) {
    return String(value || "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll("\"", "&quot;")
        .replaceAll("'", "&#39;");
}
</script>
</body>
</html>

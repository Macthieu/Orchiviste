<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Tableau de bord</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Avenir Next", "Helvetica Neue", sans-serif;
            color: var(--ink);
            background: linear-gradient(140deg, #f9f6ef 0%, #f1ece4 100%);
        }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap {
            max-width: 1120px;
            margin: 20px auto 40px;
            padding: 0 16px;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
            gap: 10px;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
        }
        .upload-card {
            margin-top: 12px;
        }
        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        .section-head h2 {
            margin: 0;
        }
        .table-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }
        .upload-form {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 10px;
            align-items: end;
        }
        .upload-form label {
            display: block;
            font-size: 13px;
            color: var(--muted);
        }
        .upload-form input {
            margin-top: 4px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            font: inherit;
            background: #fff;
            color: var(--ink);
        }
        .upload-form input[readonly] {
            background: #f7f3ec;
            color: var(--ink);
        }
        .path-row {
            display: flex;
            gap: 8px;
            align-items: center;
        }
        .path-row input {
            flex: 1;
        }
        .path-btn {
            border: 1px solid var(--accent);
            border-radius: 8px;
            background: #ebf8f4;
            color: var(--accent);
            font-weight: 700;
            padding: 8px 10px;
            cursor: pointer;
            white-space: nowrap;
        }
        .path-btn-server {
            border-color: var(--border);
            background: #fff;
            color: var(--muted);
        }
        .upload-form button {
            border: 1px solid var(--accent);
            color: #fff;
            background: var(--accent);
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn-secondary {
            border: 1px solid var(--border);
            color: var(--ink);
            background: #fff;
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .table-wrap {
            overflow-x: auto;
        }
        .error {
            color: var(--warning);
            font-weight: 700;
            margin-top: 10px;
        }
        .notice {
            color: var(--accent);
            font-weight: 700;
            margin-top: 10px;
        }
        .help {
            color: var(--muted);
            font-size: 12px;
            margin-top: 8px;
        }
        .kpi {
            font-size: 28px;
            font-weight: 800;
            margin-top: 8px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 18px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
            font-size: 14px;
            vertical-align: top;
        }
        th { color: var(--muted); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; }
        .status-needs_review { color: var(--warning); font-weight: 700; }
        .status-completed { color: var(--accent); font-weight: 700; }
        .mono { font-family: "SF Mono", Menlo, monospace; font-size: 12px; }
        .cell-name, .cell-path {
            min-width: 180px;
            max-width: 320px;
            word-break: break-word;
        }
        .empty-state {
            padding: 18px 12px;
            color: var(--muted);
        }
        .picker-overlay {
            position: fixed;
            inset: 0;
            background: rgba(25, 25, 25, 0.3);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 999;
        }
        .picker {
            width: min(900px, 94vw);
            max-height: 80vh;
            overflow: auto;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px;
        }
        .picker-toolbar {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 10px;
        }
        .picker-toolbar button {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 6px 9px;
            background: #fff;
            cursor: pointer;
        }
        .picker-list button {
            width: 100%;
            text-align: left;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            margin-bottom: 6px;
            background: #fff;
            cursor: pointer;
        }
        @media (max-width: 980px) {
            .upload-form {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste MVP</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/presets">Préréglages</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>
<main class="wrap">
    <section class="grid">
        <article class="card"><div>Total des tâches</div><div class="kpi">#(total_jobs)</div></article>
        <article class="card"><div>En attente</div><div class="kpi">#(pending_jobs)</div></article>
        <article class="card"><div>En cours</div><div class="kpi">#(running_jobs)</div></article>
        <article class="card"><div>Revue requise</div><div class="kpi">#(needs_review_jobs)</div></article>
        <article class="card"><div>Terminées</div><div class="kpi">#(completed_jobs)</div></article>
        <article class="card"><div>Agents</div><div class="kpi">#(worker_count)</div></article>
        <article class="card"><div>File d'ingestion</div><div class="kpi">#(queue_ingest_depth)</div></article>
        <article class="card"><div>File de rejet</div><div class="kpi">#(queue_dead_letter_depth)</div></article>
    </section>

    <section class="card upload-card">
        <h2>Importer un document local</h2>
        <p>L'import est explicite: le fichier est copié côté serveur puis injecté dans la file d'ingestion.</p>
        <form class="upload-form" action="/ui/ingest/local" method="post" enctype="multipart/form-data">
            <label>Fichier (serveur ou local)
                <div class="path-row">
                    <input id="singleFileDisplay" type="text" placeholder="Choisir un fichier local ou sélectionner un fichier serveur" readonly>
                    <input id="singleServerFileField" type="hidden" name="server_file">
                    <button class="path-btn" type="button" onclick="openLocalFileDialog('singleFileUpload')">Choisir</button>
                    <button class="path-btn path-btn-server" type="button" onclick="openServerFilePicker('singleServerFileField', 'singleFileDisplay', 'singleFileHint')">Serveur</button>
                </div>
                <input id="singleFileUpload" type="file" name="pdf" accept=".pdf,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.tif,.tiff,application/pdf,image/*" style="display:none" onchange="handleLocalFileSelection('singleFileUpload', 'singleServerFileField', 'singleFileDisplay', 'singleFileHint')">
                <div id="singleFileHint" class="help">Le bouton "Choisir" ouvre le sélecteur de fichier local. Le bouton "Serveur" parcourt les fichiers visibles par l'API.</div>
            </label>
            <label>Étiquettes (optionnel)
                <input type="text" name="tags" placeholder="pv, comité, facture">
            </label>
            <button type="submit">Importer et analyser</button>
        </form>
        <div class="help">
            Mode Docker: le serveur lit les dossiers montés, par défaut <code>/data/inbox</code> (entrée) et <code>/data/routed</code> (sortie).
        </div>
        <hr style="border:none; border-top:1px solid var(--border); margin:14px 0;">
        <h3 style="margin: 0 0 8px;">Importer un dossier local (lot)</h3>
        <form class="upload-form" action="/ui/ingest/folder" method="post" enctype="multipart/form-data">
            <label>Dossier d'entrée (serveur ou local)
                <div class="path-row">
                    <input id="inputFolderField" type="text" name="input_folder" value="#(ingest_default_input_folder)" placeholder="/data/inbox (laisser vide pour un dossier local)">
                    <button class="path-btn" type="button" onclick="openLocalFolderDialog('inputFolderUpload')">Choisir</button>
                    <button class="path-btn path-btn-server" type="button" onclick="openFolderPicker('inputFolderField')">Serveur</button>
                </div>
                <input id="inputFolderUpload" type="file" name="folder_files" accept=".pdf,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.tif,.tiff,application/pdf,image/*" webkitdirectory directory multiple style="display:none" onchange="handleLocalFolderSelection('inputFolderUpload','inputFolderField','inputFolderHint')">
                <div id="inputFolderHint" class="help">Le bouton "Choisir" ouvre le sélecteur de dossier local (ton ordinateur).</div>
            </label>
            <label>Dossier de sortie (optionnel)
                <div class="path-row">
                    <input id="outputFolderField" type="text" name="output_root" value="#(ingest_default_output_folder)" placeholder="/data/routed">
                    <button class="path-btn" type="button" onclick="openFolderPicker('outputFolderField')">Choisir</button>
                    <button class="path-btn path-btn-server" type="button" onclick="setServerFolderDefault('outputFolderField', '#(ingest_default_output_folder)', 'outputFolderHint')">Serveur</button>
                </div>
                <div id="outputFolderHint" class="help">Le dossier de sortie est un chemin serveur API. "Choisir" parcourt le serveur, "Serveur" remet la valeur par défaut.</div>
            </label>
            <label>Étiquettes (optionnel)
                <input type="text" name="tags" placeholder="ville, résolution, conseil">
            </label>
            <label>Maximum de fichiers
                <input type="number" name="max_files" min="1" max="500" value="50">
            </label>
            <label>Récursif
                <input type="checkbox" name="recursive" value="1" checked>
            </label>
            <button type="submit">Importer le dossier</button>
        </form>
        #if(upload_notice):
        <p class="notice">#(upload_notice)</p>
        #endif
        #if(upload_error):
        <p class="error">#(upload_error)</p>
        #endif
    </section>

    <section class="section-head" style="margin-top: 18px;">
        <h2>Tâches récentes</h2>
        <div class="table-actions">
            <form action="/ui/dashboard/recent-jobs/clear" method="post" style="margin:0;">
                <button class="btn-secondary" type="submit">Effacer la liste</button>
            </form>
            #if(recent_jobs_cleared):
            <form action="/ui/dashboard/recent-jobs/reset" method="post" style="margin:0;">
                <button class="btn-secondary" type="submit">Réafficher tout</button>
            </form>
            #endif
        </div>
    </section>
    #if(dashboard_notice):
    <p class="notice">#(dashboard_notice)</p>
    #endif
    #if(dashboard_error):
    <p class="error">#(dashboard_error)</p>
    #endif
    <div class="table-wrap">
    <table>
        <thead>
        <tr>
            <th>ID</th>
            <th>Statut</th>
            <th>Source</th>
            <th>Code</th>
            <th>Confiance</th>
            <th>OCR OK</th>
            <th>Nouveau nom</th>
            <th>Métadonnées OK</th>
            <th>Dossier enregistré</th>
            <th>Mise à jour</th>
        </tr>
        </thead>
        <tbody>
        #for(job in recent_jobs):
        <tr>
            <td class="mono"><a href="/ui/jobs/#(job.id)">#(job.id)</a></td>
            <td class="status-#(job.status)">#(job.status_label)</td>
            <td>#(job.source_kind)</td>
            <td>#(job.suggested_class_code)</td>
            <td>#(job.confidence)</td>
            <td>#(job.ocr_ok)</td>
            <td class="cell-name mono">#(job.resolved_file_name)</td>
            <td>#(job.metadata_ok)</td>
            <td class="cell-path mono">#(job.saved_folder_path)</td>
            <td>#(job.updated_at)</td>
        </tr>
        #endfor
        #if(recent_jobs_empty):
        <tr>
            <td colspan="10" class="empty-state">
                #if(recent_jobs_cleared):
                La liste a été vidée. Les nouvelles tâches créées après ce reset réapparaîtront ici.
                #else:
                Aucune tâche récente à afficher.
                #endif
            </td>
        </tr>
        #endif
        </tbody>
    </table>
    </div>
</main>
<div id="folderPickerOverlay" class="picker-overlay" onclick="closeFolderPicker(event)">
    <div class="picker" onclick="event.stopPropagation()">
        <h3 id="pickerTitle">Sélectionner un dossier</h3>
        <div class="picker-toolbar">
            <button type="button" onclick="pickerGoParent()">Parent</button>
            <span id="pickerCurrent" class="mono"></span>
        </div>
        <div id="pickerRoots" class="picker-toolbar"></div>
        <div id="pickerList" class="picker-list"></div>
        <div class="picker-toolbar">
            <button id="pickerApplyFolderButton" type="button" onclick="applyPickedFolder()">Utiliser ce dossier</button>
            <button type="button" onclick="closeFolderPicker()">Fermer</button>
        </div>
    </div>
</div>
<script>
let pickerTargetInputId = null;
let pickerTargetDisplayId = null;
let pickerTargetHintId = null;
let pickerCurrentPath = null;
let pickerParentPath = null;
let pickerRoots = [];
let pickerMode = "folder";

function openLocalFolderDialog(fileInputId) {
    const picker = document.getElementById(fileInputId);
    if (!picker) {
        return;
    }
    picker.value = "";
    picker.click();
}

function handleLocalFileSelection(fileInputId, serverInputId, displayInputId, hintId) {
    const picker = document.getElementById(fileInputId);
    const serverInput = document.getElementById(serverInputId);
    const displayInput = document.getElementById(displayInputId);
    const hint = document.getElementById(hintId);
    if (!picker) {
        return;
    }

    const file = (picker.files || [])[0];
    if (!file) {
        if (displayInput) {
            displayInput.value = "";
        }
        if (hint) {
            hint.textContent = "Aucun fichier local sélectionné.";
        }
        return;
    }

    if (serverInput) {
        serverInput.value = "";
    }
    if (displayInput) {
        displayInput.value = file.name;
    }
    if (hint) {
        hint.textContent = `Fichier local sélectionné: ${file.name}.`;
    }
}

function handleLocalFolderSelection(fileInputId, pathInputId, hintId) {
    const picker = document.getElementById(fileInputId);
    const pathInput = document.getElementById(pathInputId);
    const hint = document.getElementById(hintId);
    if (!picker) {
        return;
    }

    const files = Array.from(picker.files || []);
    if (!files.length) {
        if (hint) {
            hint.textContent = "Aucun dossier local sélectionné.";
        }
        return;
    }

    const supportedCount = files.filter((file) => /\.(pdf|docx|xlsx|pptx|png|jpe?g|tiff?)$/i.test(file.name)).length;
    const firstRelativePath = files[0].webkitRelativePath || files[0].name;
    const folderName = firstRelativePath.includes("/") ? firstRelativePath.split("/")[0] : firstRelativePath;

    if (pathInput) {
        pathInput.value = "";
    }
    if (hint) {
        hint.textContent = `Dossier local selectionne: ${folderName} (${supportedCount} document(s) supporte(s)).`;
    }
}

function openFolderPicker(inputId) {
    pickerMode = "folder";
    pickerTargetInputId = inputId;
    pickerTargetDisplayId = null;
    pickerTargetHintId = null;
    const input = document.getElementById(inputId);
    const startPath = input && input.value ? input.value : "";
    document.getElementById("pickerTitle").textContent = "Sélectionner un dossier serveur";
    document.getElementById("pickerApplyFolderButton").style.display = "inline-flex";
    document.getElementById("folderPickerOverlay").style.display = "flex";
    loadFolderList(startPath);
}

function openServerFilePicker(hiddenInputId, displayInputId, hintId) {
    pickerMode = "file";
    pickerTargetInputId = hiddenInputId;
    pickerTargetDisplayId = displayInputId;
    pickerTargetHintId = hintId;
    const hiddenInput = document.getElementById(hiddenInputId);
    const startPath = hiddenInput && hiddenInput.value ? hiddenInput.value : "";
    document.getElementById("pickerTitle").textContent = "Sélectionner un fichier serveur";
    document.getElementById("pickerApplyFolderButton").style.display = "none";
    document.getElementById("folderPickerOverlay").style.display = "flex";
    loadFolderList(startPath);
}

function closeFolderPicker(event) {
    if (event && event.target && event.target.id !== "folderPickerOverlay") {
        return;
    }
    document.getElementById("folderPickerOverlay").style.display = "none";
}

async function loadFolderList(path) {
    const query = path ? `?path=${encodeURIComponent(path)}` : "";
    const res = await fetch(`/ui/fs/list${query}`);
    if (!res.ok) {
        alert(`Impossible de lister les dossiers (${res.status}).`);
        return;
    }
    const data = await res.json();
    pickerCurrentPath = data.current;
    pickerParentPath = data.parent || null;
    pickerRoots = data.roots || [];
    document.getElementById("pickerCurrent").textContent = pickerCurrentPath;
    renderPickerRoots();
    renderPickerList(data.directories || [], data.files || []);
}

function renderPickerRoots() {
    const rootContainer = document.getElementById("pickerRoots");
    rootContainer.innerHTML = "";
    for (const root of pickerRoots) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = `Racine: ${root}`;
        btn.onclick = () => loadFolderList(root);
        rootContainer.appendChild(btn);
    }
}

function renderPickerList(entries, files) {
    const list = document.getElementById("pickerList");
    list.innerHTML = "";
    for (const entry of entries) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = `${entry.name} (${entry.path})`;
        btn.onclick = () => loadFolderList(entry.path);
        list.appendChild(btn);
    }
    if (pickerMode === "file" && files.length) {
        const heading = document.createElement("div");
        heading.className = "help";
        heading.textContent = "Fichiers supportés";
        list.appendChild(heading);
        for (const entry of files) {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.textContent = `${entry.name} (${entry.path})`;
            btn.onclick = () => applyPickedFile(entry.path);
            list.appendChild(btn);
        }
    }
}

function pickerGoParent() {
    if (pickerParentPath) {
        loadFolderList(pickerParentPath);
    }
}

function applyPickedFolder() {
    if (!pickerTargetInputId || !pickerCurrentPath) {
        return;
    }
    const input = document.getElementById(pickerTargetInputId);
    if (input) {
        input.value = pickerCurrentPath;
    }
    closeFolderPicker();
}

function applyPickedFile(path) {
    if (!pickerTargetInputId || !path) {
        return;
    }
    const hiddenInput = document.getElementById(pickerTargetInputId);
    if (hiddenInput) {
        hiddenInput.value = path;
    }
    if (pickerTargetDisplayId) {
        const displayInput = document.getElementById(pickerTargetDisplayId);
        if (displayInput) {
            displayInput.value = path;
        }
    }
    if (pickerTargetHintId) {
        const hint = document.getElementById(pickerTargetHintId);
        if (hint) {
            hint.textContent = `Fichier serveur sélectionné: ${path}.`;
        }
    }
    const uploadInput = document.getElementById("singleFileUpload");
    if (uploadInput) {
        uploadInput.value = "";
    }
    closeFolderPicker();
}

function setServerFolderDefault(inputId, defaultValue, hintId) {
    const input = document.getElementById(inputId);
    if (input) {
        input.value = defaultValue;
    }
    if (hintId) {
        const hint = document.getElementById(hintId);
        if (hint) {
            hint.textContent = `Dossier serveur actif: ${defaultValue}.`;
        }
    }
}
</script>
</body>
</html>

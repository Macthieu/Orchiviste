<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Pilotage Muni - Lancer</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --sev-info-bg: #e8f4f0;
            --sev-info-ink: #0c6b58;
            --sev-warning-bg: #fff2df;
            --sev-warning-ink: #915007;
            --sev-blocking-bg: #fbe4de;
            --sev-blocking-ink: #8b2b14;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Avenir Next", "Helvetica Neue", sans-serif;
            color: var(--ink);
            background: linear-gradient(150deg, #f9f5ee 0%, #f2ece2 100%);
        }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap {
            max-width: 1240px;
            margin: 20px auto 40px;
            padding: 0 16px;
        }
        .subnav {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }
        .subnav a {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 7px 11px;
            text-decoration: none;
            color: var(--ink);
            background: #fff;
            font-weight: 700;
            font-size: 13px;
        }
        .subnav a.active {
            background: #ebf8f4;
            color: var(--accent);
            border-color: #bde2d7;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px;
            margin-bottom: 14px;
        }
        .notice {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--accent);
        }
        .error {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--warning);
        }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 10px;
        }
        label {
            display: block;
            font-size: 13px;
            color: var(--muted);
        }
        input, select, textarea {
            margin-top: 4px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            font: inherit;
            background: #fff;
            color: var(--ink);
        }
        textarea {
            min-height: 150px;
            font-family: "SF Mono", Menlo, monospace;
            font-size: 12px;
            line-height: 1.35;
        }
        .checkbox-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 8px;
            color: var(--warning);
            font-size: 13px;
            font-weight: 700;
        }
        .checkbox-row input {
            width: auto;
            margin: 0;
        }
        .btn {
            margin-top: 10px;
            border: 1px solid var(--accent);
            color: #fff;
            background: var(--accent);
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .btn:disabled {
            background: #98a4a0;
            border-color: #98a4a0;
            cursor: not-allowed;
        }
        .warning-box {
            margin-top: 8px;
            border: 1px solid #e0c9b0;
            background: #fff7ee;
            color: #7c4c0f;
            border-radius: 8px;
            padding: 10px;
            font-size: 13px;
        }
        .quick-link {
            margin: 0 0 8px;
            font-size: 13px;
        }
        .quick-link a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .decision-box {
            margin: 10px 0 6px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #fff;
            padding: 10px;
        }
        .decision-header {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
            margin-bottom: 6px;
        }
        .decision-title {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
        }
        .decision-state {
            display: inline-block;
            border-radius: 999px;
            padding: 2px 9px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .decision-state-go {
            background: var(--sev-info-bg);
            color: var(--sev-info-ink);
        }
        .decision-state-no-go {
            background: var(--sev-blocking-bg);
            color: var(--sev-blocking-ink);
        }
        .decision-text {
            margin: 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.4;
        }
        .decision-list {
            margin: 6px 0 0;
            padding-left: 18px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.35;
        }
        .decision-links {
            margin-top: 7px;
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            font-size: 12px;
        }
        .decision-links a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .diag-list {
            display: grid;
            gap: 8px;
            margin-top: 8px;
        }
        .diag-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 6px 0 2px;
        }
        .diag-row {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 9px;
            background: #fff;
            border-left-width: 4px;
        }
        .diag-row-level-info {
            border-left-color: var(--sev-info-ink);
        }
        .diag-row-level-warning {
            border-left-color: var(--sev-warning-ink);
        }
        .diag-row-level-blocking {
            border-left-color: var(--sev-blocking-ink);
        }
        .diag-head {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
            margin-bottom: 4px;
        }
        .diag-chip {
            border-radius: 999px;
            padding: 2px 9px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }
        .diag-chip.legend {
            font-size: 10px;
            padding: 2px 8px;
            margin: 0;
        }
        .diag-blocking {
            background: var(--sev-blocking-bg);
            color: var(--sev-blocking-ink);
        }
        .diag-warning {
            background: var(--sev-warning-bg);
            color: var(--sev-warning-ink);
        }
        .diag-info {
            background: var(--sev-info-bg);
            color: var(--sev-info-ink);
        }
        .diag-meta {
            color: var(--muted);
            font-size: 12px;
            line-height: 1.4;
        }
        .diag-cta {
            margin-top: 7px;
            border: 1px solid #cbe7df;
            background: #f4fbf9;
            color: var(--accent);
            border-radius: 6px;
            padding: 6px 8px;
            font-size: 12px;
            font-weight: 700;
        }
        .apply-blocking-note {
            display: none;
            margin-top: 8px;
            border: 1px solid #efb8aa;
            background: #fff3ef;
            color: #8b2b14;
            border-radius: 8px;
            padding: 10px;
            font-size: 13px;
            font-weight: 700;
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Pilotage Muni</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/regles">Règles documentaires</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>

<main class="wrap">
    <nav class="subnav">
        <a href="/ui/pilotage/catalogue">Catalogue</a>
        <a class="active" href="/ui/pilotage/lancer">Lancer</a>
        <a href="/ui/pilotage/historique">Historique</a>
    </nav>

    #if(notice):
    <p class="notice">#(notice)</p>
    #endif
    #if(error):
    <p class="error">#(error)</p>
    #endif

    <section class="card">
        <h2 style="margin:0 0 10px;">Lancement canonique (`run --request --result`)</h2>
        <p class="quick-link">Consulter les exécutions récentes: <a href="/ui/pilotage/historique">Historique</a></p>
        <div class="diag-legend" aria-label="Légende des niveaux diagnostics">
            <span class="diag-chip legend diag-info">info</span>
            <span class="diag-chip legend diag-warning">warning</span>
            <span class="diag-chip legend diag-blocking">blocking</span>
        </div>
        <section class="decision-box" aria-label="Decision Apply">
            <div class="decision-header">
                <h3 class="decision-title">Decision Apply</h3>
                #if(apply_blocking_guard_available):
                <span class="decision-state decision-state-no-go">No-Go</span>
                #else:
                <span class="decision-state decision-state-go">Go</span>
                #endif
            </div>
            #if(apply_blocking_guard_available):
            <p class="decision-text">Apply doit rester bloqué tant qu'un diagnostic prioritaire <strong>blocking</strong> est actif.</p>
            #if(apply_blocking_guard_reason_present):
            <p class="decision-text"><span class="mono">#(apply_blocking_guard_reason)</span></p>
            #endif
            #else:
            <p class="decision-text">Apply peut etre envisage apres un preview valide et verification operateur finale.</p>
            #endif
            <ul class="decision-list">
                <li>Stop Apply si un diagnostic <strong>blocking</strong> est present.</li>
                <li>Conserver les garde-fous existants (`allow_destructive` + confirmations `confirm_*`).</li>
            </ul>
            <div class="decision-links">
                <a href="https://github.com/Macthieu/Orchiviste/blob/main/docs/S3.1-RUNBOOK-RENAME-CHAIN.md" target="_blank" rel="noopener noreferrer">Runbook</a>
                <a href="https://github.com/Macthieu/Orchiviste/blob/main/docs/S3.1-INCIDENT-PLAYBOOK.md" target="_blank" rel="noopener noreferrer">Incident playbook</a>
            </div>
        </section>

        <form id="pilotageRunForm" action="/ui/pilotage/run" method="post" data-apply-blocking="#(apply_blocking_guard_available)">
            <div class="form-grid">
                <label>Tool
                    <select name="tool_id">
                        #for(tool in tools):
                        <option value="#(tool.id)" #(tool.selected_attribute)>#(tool.display_name)</option>
                        #endfor
                    </select>
                </label>
                <label>Action
                    <input id="pilotageActionInput" type="text" name="action" value="#(selected_action)" placeholder="run">
                </label>
                <label>Workspace path (optionnel)
                    <input type="text" name="workspace_path" value="#(selected_workspace_path)">
                </label>
            </div>

            <label style="margin-top:10px;">Parameters JSON
                <textarea name="parameters_json">#(selected_parameters_json)</textarea>
            </label>

            <label style="margin-top:10px;">Input artifacts JSON (optionnel)
                <textarea name="input_artifacts_json">#(selected_input_artifacts_json)</textarea>
            </label>

            <label class="checkbox-row">
                <input type="checkbox" name="allow_destructive" value="1" #(selected_allow_destructive_attr)>
                Autoriser explicitement une exécution potentiellement destructive
            </label>

            <div class="warning-box">
                Le pilotage V1 privilégie les exécutions non destructives. Pour les outils sensibles, un garde-fou explicite est requis
                et les paramètres de confirmation (`confirm_*`) doivent aussi être présents dans le JSON.
            </div>

            <div id="applyBlockingNote" class="apply-blocking-note">
                Apply bloqué par un diagnostic prioritaire blocking:
                #if(apply_blocking_guard_reason_present):
                <span class="mono">#(apply_blocking_guard_reason)</span>
                #else:
                <span class="mono">diagnostic blocking actif</span>
                #endif
            </div>

            <button id="pilotageSubmitButton" class="btn" type="submit" #(selected_action_apply_blocked_attr)>Exécuter</button>
        </form>
    </section>

    #if(priority_present):
    <section class="card">
        <h2 style="margin:0 0 8px;">Diagnostics prioritaires récents</h2>
        <div class="diag-list">
            #for(row in priority_rows):
            <article class="diag-row diag-row-level-#(row.priority_diagnostic_severity)">
                <div class="diag-head">
                    <span class="mono">#(row.execution_id)</span>
                    <span class="diag-chip diag-#(row.priority_diagnostic_severity)">#(row.priority_diagnostic_severity)</span>
                    <strong>#(row.priority_diagnostic_label)</strong>
                </div>
                <div class="diag-meta">
                    Tool: #(row.tool_id) · Action: <span class="mono">#(row.action)</span> · Statut: #(row.status_label) · ID: <span class="mono">#(row.priority_diagnostic_id)</span>
                </div>
                #if(row.priority_diagnostic_cta_present):
                <div class="diag-cta">Action recommandée: #(row.priority_diagnostic_cta)</div>
                #endif
            </article>
            #endfor
        </div>
    </section>
    #endif
</main>
<script>
(() => {
  const form = document.getElementById("pilotageRunForm");
  const actionInput = document.getElementById("pilotageActionInput");
  const submitButton = document.getElementById("pilotageSubmitButton");
  const blockingNote = document.getElementById("applyBlockingNote");
  if (!form || !actionInput || !submitButton || !blockingNote) return;

  const hasBlocking = form.dataset.applyBlocking === "true";
  const syncState = () => {
    const action = (actionInput.value || "").trim().toLowerCase();
    const shouldBlock = hasBlocking && action === "apply";
    submitButton.disabled = shouldBlock;
    blockingNote.style.display = shouldBlock ? "block" : "none";
  };

  actionInput.addEventListener("input", syncState);
  syncState();
})();
</script>
</body>
</html>

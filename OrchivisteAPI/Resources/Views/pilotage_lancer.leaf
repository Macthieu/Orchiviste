<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Orchiviste Pilotage Muni - Lancer</title>
    <style>
        :root {
            --bg: #f4f1eb;
            --surface: #fffdf9;
            --ink: #1e2528;
            --muted: #5f676a;
            --accent: #0c6b58;
            --warning: #ac5d0c;
            --border: #d9d2c4;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Avenir Next", "Helvetica Neue", sans-serif;
            color: var(--ink);
            background: linear-gradient(150deg, #f9f5ee 0%, #f2ece2 100%);
        }
        header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }
        header nav a {
            margin-left: 14px;
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
        .wrap {
            max-width: 1240px;
            margin: 20px auto 40px;
            padding: 0 16px;
        }
        .subnav {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 14px;
        }
        .subnav a {
            border: 1px solid var(--border);
            border-radius: 999px;
            padding: 7px 11px;
            text-decoration: none;
            color: var(--ink);
            background: #fff;
            font-weight: 700;
            font-size: 13px;
        }
        .subnav a.active {
            background: #ebf8f4;
            color: var(--accent);
            border-color: #bde2d7;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px;
            margin-bottom: 14px;
        }
        .notice {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--accent);
        }
        .error {
            margin: 0 0 10px;
            font-weight: 700;
            color: var(--warning);
        }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 10px;
        }
        label {
            display: block;
            font-size: 13px;
            color: var(--muted);
        }
        input, select, textarea {
            margin-top: 4px;
            width: 100%;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 8px;
            font: inherit;
            background: #fff;
            color: var(--ink);
        }
        textarea {
            min-height: 150px;
            font-family: "SF Mono", Menlo, monospace;
            font-size: 12px;
            line-height: 1.35;
        }
        .checkbox-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 8px;
            color: var(--warning);
            font-size: 13px;
            font-weight: 700;
        }
        .checkbox-row input {
            width: auto;
            margin: 0;
        }
        .btn {
            margin-top: 10px;
            border: 1px solid var(--accent);
            color: #fff;
            background: var(--accent);
            border-radius: 8px;
            padding: 9px 12px;
            font-weight: 700;
            cursor: pointer;
        }
        .warning-box {
            margin-top: 8px;
            border: 1px solid #e0c9b0;
            background: #fff7ee;
            color: #7c4c0f;
            border-radius: 8px;
            padding: 10px;
            font-size: 13px;
        }
        .quick-link {
            margin: 0 0 8px;
            font-size: 13px;
        }
        .quick-link a {
            color: var(--accent);
            text-decoration: none;
            font-weight: 700;
        }
    </style>
</head>
<body>
<header>
    <strong>Orchiviste Pilotage Muni</strong>
    <nav>
        <a href="/ui">Tableau de bord</a>
        <a href="/ui/pilotage">Pilotage Muni</a>
        <a href="/ui/setup">Configuration</a>
        <a href="/ui/jobs">Tâches</a>
        <a href="/ui/workers">Agents</a>
        <a href="/ui/regles">Règles documentaires</a>
        <a href="/ui/events">Événements</a>
    </nav>
</header>

<main class="wrap">
    <nav class="subnav">
        <a href="/ui/pilotage/catalogue">Catalogue</a>
        <a class="active" href="/ui/pilotage/lancer">Lancer</a>
        <a href="/ui/pilotage/historique">Historique</a>
    </nav>

    #if(notice):
    <p class="notice">#(notice)</p>
    #endif
    #if(error):
    <p class="error">#(error)</p>
    #endif

    <section class="card">
        <h2 style="margin:0 0 10px;">Lancement canonique (`run --request --result`)</h2>
        <p class="quick-link">Consulter les exécutions récentes: <a href="/ui/pilotage/historique">Historique</a></p>

        <form action="/ui/pilotage/run" method="post">
            <div class="form-grid">
                <label>Tool
                    <select name="tool_id">
                        #for(tool in tools):
                        <option value="#(tool.id)" #(tool.selected_attribute)>#(tool.display_name)</option>
                        #endfor
                    </select>
                </label>
                <label>Action
                    <input type="text" name="action" value="#(selected_action)" placeholder="run">
                </label>
                <label>Workspace path (optionnel)
                    <input type="text" name="workspace_path" value="#(selected_workspace_path)">
                </label>
            </div>

            <label style="margin-top:10px;">Parameters JSON
                <textarea name="parameters_json">#(selected_parameters_json)</textarea>
            </label>

            <label style="margin-top:10px;">Input artifacts JSON (optionnel)
                <textarea name="input_artifacts_json">#(selected_input_artifacts_json)</textarea>
            </label>

            <label class="checkbox-row">
                <input type="checkbox" name="allow_destructive" value="1" #(selected_allow_destructive_attr)>
                Autoriser explicitement une exécution potentiellement destructive
            </label>

            <div class="warning-box">
                Le pilotage V1 privilégie les exécutions non destructives. Pour les outils sensibles, un garde-fou explicite est requis
                et les paramètres de confirmation (`confirm_*`) doivent aussi être présents dans le JSON.
            </div>

            <button class="btn" type="submit">Exécuter</button>
        </form>
    </section>
</main>
</body>
</html>

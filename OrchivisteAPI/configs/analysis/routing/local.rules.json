{
  "rules": [
    {
      "id": "facture-finance",
      "when_type_doc": "Facture",
      "destination_template": "Archives/{year}/{class_code}/Factures/{sujet}",
      "name_format": "{class_code}-FACT-{sujet}-{date}-{numero}",
      "class_code": "FIN-001",
      "preset_id": "preset_facture"
    },
    {
      "id": "proces-verbal-comite",
      "when_type_doc": "ProcesVerbal",
      "destination_template": "Archives/{year}/{class_code}/Proces-Verbaux/{sujet}",
      "name_format": "{class_code}-PV-{sujet}-{date}-{numero}",
      "class_code": "ADM-PV",
      "preset_id": "preset_pv"
    },
    {
      "id": "resolution-gouvernance",
      "when_type_doc": "Resolution",
      "destination_template": "Archives/{year}/{class_code}/Resolutions/{sujet}",
      "name_format": "{class_code}-RES-{sujet}-{date}-{numero}",
      "class_code": "ADM-RES",
      "preset_id": "preset_resolution"
    },
    {
      "id": "fallback-autre",
      "when_type_doc": "Autre",
      "destination_template": "Archives/{year}/{class_code}/Autres/{sujet}",
      "name_format": "{class_code}-{type_doc}-{sujet}-{date}-{numero}",
      "class_code": "GEN-000",
      "preset_id": "preset_default"
    }
  ]
}

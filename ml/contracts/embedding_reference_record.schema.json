{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchiviste.local/contracts/embedding_reference_record.schema.json",
  "title": "EmbeddingReferenceRecord",
  "type": "object",
  "required": [
    "reference_id",
    "reference_kind",
    "text"
  ],
  "properties": {
    "reference_id": {
      "type": "string",
      "minLength": 1
    },
    "reference_kind": {
      "type": "string",
      "enum": ["class_code", "naming_rule", "validated_example", "document_type"]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "class_code": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "preset_id": {
      "type": "string"
    },
    "path_hint": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    }
  }
}

